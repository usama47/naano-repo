{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/capture.mjs"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/capture.mjs"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node .cursor/hooks/capture.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/continue-clone.mjs",
        "loop_limit": null
      }
    ]
  }
}
