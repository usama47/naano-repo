ked\":\"Not yet on the ranking - publish your first Naano post to enter.\",\"leaderboardYouLabel\":\"You\",\"leaderboardClicksUnit\":\"clicks\",\"leaderboardWeekDelta\":\"{count, plural, =1 {# place vs last week} other {# places vs last week}}\",\"leaderboardPodium1\":\"1st\",\"leaderboardPodium2\":\"2nd\",\"leaderboardPodium3\":\"3rd\",\"contestPillTop\":\"€{prize} · top creator\",\"contestActiveBody\":\"€{prize} for the top creator of the week. The #1 in the ranking on Sunday wins.\",\"rankStatCurrentRank\":\"Current rank\",\"rankStatRankOfTotal\":\"of {total}\",\"rankStatRankNotRanked\":\"Not ranked yet\",\"rankStatClicksWeek\":\"Qualified clicks\",\"rankStatEstEarnings\":\"Estimated earnings\",\"rankStatProgressTop10\":\"Progress to Top 10\",\"rankStatProgressClicksTo\":\"{remaining} more {remaining, plural, =1 {click} other {clicks}} to reach Top 10\",\"rankStatProgressInTop10\":\"You're in the Top 10\",\"rankFromLastWeekUp\":\"{value} from last week\",\"rankFromLastWeekDown\":\"{value} from last week\",\"rankFromLastWeekFlat\":\"vs last week\",\"rankContestHeroSubtitle\":\"The #1 in the ranking on Sunday wins.\",\"rankContestHeroCta\":\"See SaaS companies\",\"rankViewFullN\":\"View full ranking ({count} {count, plural, =1 {creator} other {creators}})\",\"rankStatProgressUnclassified\":\"Post your first Naano post to enter the ranking\",\"perfPostsEmptyForPeriod\":\"No Naano posts in this period yet.\",\"colPosts\":\"Posts\",\"colCpc\":\"CPC\",\"colEarnings\":\"Results\",\"creatorFallback\":\"Creator\",\"inviteErrorFallback\":\"Error sending invitation\"},\"auth\":{\"welcomeBack\":\"Welcome back\",\"signInToAccount\":\"Sign in to your account\",\"createAccount\":\"Create an account\",\"joinMarketplace\":\"Join the B2B marketplace\",\"noAccount\":\"Don't have an account?\",\"signUp\":\"Sign up\",\"haveAccount\":\"Already have an account?\",\"signIn\":\"Sign in\",\"openLocalWorkspace\":\"Open the local workspace\",\"localWorkspaceHint\":\"Development only — no pr