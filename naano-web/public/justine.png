:\"Save\",\"addSection\":\"Add section\",\"modalEditDescriptionTitle\":\"Edit description\",\"aboutTextareaPlaceholder\":\"Describe yourself for companies, your story, what you create, results…\",\"resetToLinkedin\":\"↺ Reset to my LinkedIn description\",\"modalChoosePostsTitle\":\"Choose posts to show\",\"noPostsAvailable\":\"No posts available to show.\",\"postNoText\":\"(no text)\",\"postsSelectedCount\":\"{count} selected\",\"modalEditPriceTitle\":\"Edit price \u0026 bundles\",\"modalSetPriceTitle\":\"Set your price\",\"publishStatusLive\":\"Your profile is live\",\"publishStatusPrivate\":\"Your profile is private\",\"publishLiveHint\":\"Anyone with the link can view your public page.\",\"publishPrivateHint\":\"Publish to get a shareable public link for your profile.\",\"publishCopyLink\":\"Copy public link\",\"publishLinkCopied\":\"Copied\",\"publishCta\":\"Publish profile\",\"publishUnpublishCta\":\"Unpublish\",\"visibilityTitle\":\"Profile visibility\",\"statsUpdatedAgo\":\"Stats updated {ago} ago\",\"syncBecomeVerifiedTitle\":\"Become Naano Verified\",\"syncBecomeVerifiedBody\":\"Public profile refresh is fine for basic card data. To unlock Naano Verified analytics, connect with the Naano browser extension.\",\"syncBecomeVerifiedCta\":\"Use the extension\",\"syncBecomeVerifiedStarted\":\"Extension import started. Complete the LinkedIn capture to become Naano Verified.\",\"syncExtensionComingSoonTitle\":\"Naano Verified · extension coming soon\",\"syncExtensionComingSoonBody\":\"The Naano Chrome extension is not publicly available yet (Chrome Web Store approval pending). Your Basic card already works with public LinkedIn data — Verified analytics will unlock when the extension ships.\",\"syncExtensionComingSoonBadge\":\"Coming soon\",\"estimatedImpressions\":\"Est. impressions per post\",\"medianImpressions\":\"Median impressions per post\",\"medianImpressionsRange\":\"usually {low} – {high}\",\"medianImpressionsSample\":\"{count} posts measured\"},\"creatorCardHub\":{\"eyebrow\":\"Your creator storefront\",\"title\":\"Your Naano card, ready to travel.\",\"subtitle\":\"Share clear proof of your positioning, audience and offers. Every improvement makes the card more useful to brands.\",\"share\":\"Share my card\",\"publicPreview\":\"Public preview\",\"levelLabel\":\"Your card journey\",\"levelTitle\":\"Level {level} · {name}\",\"levels\":{\"building\":\"Foundations\",\"ready\":\"Ready to share\",\"solid\":\"Proven\",\"remarkable\":\"Active\"},\"levelDescriptions\":{\"building\":\"Build the visible foundations of your profile and offer.\",\"ready\":\"Your card can be sent to a brand without extra context.\",\"solid\":\"Your measured data adds concrete proof.\",\"remarkable\":\"Your card combines complete proof with recent activity.\"},\"xp\":\"{score} XP\",\"nextLevelStatus\":\"{missions, plural, one {# mission} other {# missions}} · {points} XP to {level}\",\"missionsDone\":\"{completed}/{total} complete\",\"maxLevel\":\"Maximum level reached\",\"progressAria\":\"Creator card progress\",\"progressExplanation\":\"Your level is based on visible, objective missions. It does not affect ranking and remains separate from Naano Verified.\",\"points\":\"XP\",\"nextAction\":\"Recommended mission\",\"allImprovements\":\"See {count} other missions\",\"completeTitle\":\"Every mission is complete\",\"completeDescription\":\"Keep publishing and syncing your data to maintain an active card.\",\"shareDialogTitle\":\"Share your card\",\"shareDialogPublished\":\"Your link is ready. Simply choose how to share it.\",\"shareDialogPrivate\":\"Publish your link once, then share it anywhere.\",\"publishConsent\":\"The card will become public through a stable link. You can make it private again at any time.\",\"shareOnLinkedIn\":\"Share on LinkedIn\",\"publishAndShareLinkedIn\":\"Publish and share on LinkedIn\",\"copyLink\":\"Copy public link\",\"publishAndCopy\":\"Publish and copy link\",\"moreShareOptions\":\"More share options\",\"preparing\":\"Preparing…\",\"linkCopied\":\"Link copied. It is ready to send to brands.\",\"linkedinOpened\":\"The caption is copied. Paste it in the LinkedIn window that just opened.\",\"linkedinOpenedWithoutCaption\":\"LinkedIn is open. Copy the caption manually if your browser blocked clipboard access.\",\"nativeShareDone\":\"Card shared.\",\"shareError\":\"The card could not be prepared. Try again in a moment.\",\"nativeShareTitle\":\"My Naano creator card\",\"nativeShareText\":\"See my positioning, LinkedIn audience and offers on my Naano card.\",\"linkedinCaption\":\"Here is my Naano creator card. My positioning, LinkedIn analytics and offers are all in one place. If you are looking for a B2B creator for an upcoming campaign, message me 👇\\n\\n{url}\",\"close\":\"Close\",\"actions\":{\"add_photo\":{\"title\":\"Add a recognisable photo\",\"description\":\"A clear photo helps brands immediately identify the person behind the card.\",\"cta\":\"Refresh LinkedIn\"},\"add_banner\":{\"title\":\"Add a banner that sets your world\",\"description\":\"The banner makes your card memorable without weighing down the message.\",\"cta\":\"Refresh LinkedIn\"},\"add_headline\":{\"title\":\"Clarify your positioning\",\"description\":\"Say in one sentence who you help and what you publish about.\",\"cta\":\"Improve my profile\"},\"add_description\":{\"title\":\"Explain why a brand should choose you\",\"description\":\"Add a concrete promise, your formats and the collaborations you are looking for.\",\"cta\":\"Improve my description\"},\"select_sectors\":{\"title\":\"Choose your strongest sectors\",\"description\":\"Three precise sectors are worth more than a long generic list.\",\"cta\":\"Choose my sectors\"},\"add_country\":{\"title\":\"Add your country\",\"description\":\"The flag gives international brands immediate context.\",\"cta\":\"Complete my profile\"},\"set_price\":{\"title\":\"Set a per-post price\",\"description\":\"A clear offer reduces back-and-forth and speeds up serious requests.\",\"cta\":\"Set my price\"},\"create_bundle\":{\"title\":\"Create a bundle\",\"description\":\"Offer several posts to make recurring collaborations simpler.\",\"cta\":\"Create my bundle\"},\"publish_card\":{\"title\":\"Publish your card\",\"description\":\"Unlock your stable link to share on LinkedIn or directly with a brand.\",\"cta\":\"Share my card\"},\"accept_opportunities\":{\"title\":\"Open collaboration requests\",\"description\":\"Let brands know you are available to receive proposals.\",\"cta\":\"Manage availability\"},\"increase_measurement_coverage\":{\"title\":\"Measure more posts\",\"description\":\"Better coverage makes the averages displayed on your card more reliable.\",\"cta\":\"Refresh my data\"},\"sync_audience_demographics\":{\"title\":\"Add audience proof\",\"description\":\"Roles, industries and company sizes help brands assess the fit.\",\"cta\":\"Sync my audience\"},\"select_featured_post\":{\"title\":\"Feature your best post\",\"description\":\"Choose content that clearly shows your angle and editorial quality.\",\"cta\":\"Choose a post\"},\"publish_recent_posts\":{\"title\":\"Publish more regularly\",\"description\":\"Three recent posts give brands enough material to understand your style.\",\"cta\":\"See my tips\"},\"refresh_linkedin_data\":{\"title\":\"Refresh LinkedIn data\",\"description\":\"A recent sync keeps the numbers on your card credible.\",\"cta\":\"Refresh now\"}}},\"creatorWalletV2\":{\"loading\":\"Loading your wallet...\",\"loadError\":\"Could not load wallet.\",\"retry\":\"Retry\",\"subtitle\":\"Track your earnings and request payouts.\",\"walletBalance\":\"Wallet balance\",\"minWithdrawalTitle\":\"Minimum withdrawal is €{amount}\",\"withdrawButton\":\"↓ Withdraw\",\"withdrawLoadingButton\":\"Processing...\",\"withdrawNotAuthenticated\":\"Please sign in again to withdraw.\",\"withdrawFailed\":\"Withdrawal failed. Please try again.\",\"totalLifetime\":\"total · {amount} lifetime\",\"available\":\"Available\",\"readyToWithdraw\":\"Ready to withdraw\",\"frozen\":\"Frozen\",\"frozenCountdown\":\"Unlocks in 14 days · {count, plural, =1 {# post} other {# posts}}\",\"noEarningsInCooldown\":\"No earnings in cooldown\",\"monthlyEarnings\":\"Monthly earnings\",\"lastSixMonths\":\"Last 6 months\",\"monthlyEarningsCaption\":\"Total earned each month (CPC + Flat Fee, before any withdrawals)\",\"recentActivity\":\"Recent activity\",\"seeFullHistory\":\"See full history →\",\"noEarningsYet\":\"No earnings yet. They'll appear here once your first qualified click or Direct booking lands.\",\"bucketAvailable\":\"Available\",\"bucketFrozen\":\"Frozen\",\"siretStatus\":\"SIRET status\",\"actionRequired\":\"Action required\",\"frenchFreelancer\":\"French freelancer\",\"noSiretOnFile\":\"No SIRET on file.\",\"noSiretExplanation\":\"Without a registered company, you cannot withdraw more than €500 until a valid SIRET is provided.\",\"yourSiret\":\"Your SIRET\",\"siretPlaceholder\":\"732 829 320 00074\",\"save\":\"Save\",\"saving\":\"Saving...\",\"siretSaved\":\"Saved.\",\"siretWillVerify\":\"We'll verify your SIRET before approving withdrawals.\",\"siretSaveFailed\":\"Failed to save SIRET\",\"payoutMethod\":\"Payout method\",\"stripe\":\"Stripe\",\"bankTransfer\":\"Bank Transfer\",\"stripeAccount\":\"Stripe Account\",\"bankTransferAccount\":\"Bank Transfer\",\"connected\":\"Connected\",\"notConnected\":\"Not connected\",\"bankDetailsOnFile\":\"Bank details on file\",\"payoutTiming\":\"2-3 business days · €{amount} minimum withdrawal.\",\"manageInSettings\":\"Manage in settings →\",\"entryDirectFlatPost\":\"Flat Fee post\",\"entryDirectFlatPostWithReason\":\"Flat Fee post · {reason}\",\"entryEarningsFrozen\":\"Earnings frozen\",\"entryQualifiedClick\":\"Qualified click\",\"entryQualifiedClickWithReason\":\"Qualified click · {reason}\",\"entryWithdrawal\":\"Withdrawal\",\"entryWithdrawalWithReason\":\"Withdrawal · {reason}\",\"entryFrozenToAvailable\":\"Frozen → Available\",\"entryRefundClawback\":\"Refund clawback\",\"entryRefundClawbackWithReason\":\"Refund clawback · {reason}\",\"entryAdjustment\":\"Adjustment\",\"entryMigratedBalance\":\"Migrated balance\",\"payoutSaved\":\"Payment method saved.\",\"payoutSaveFailed\":\"Could not save payment method.\",\"networkError\":\"Network error. Please try again.\",\"stripeAlreadyConnected\":\"Your Stripe account is connected. We pay out automatically.\",\"stripeConnectHint\":\"Connect Stripe to receive payouts directly to your account.\",\"connectStripe\":\"Connect Stripe\",\"bankCountry\":\"Bank country\",\"selectACountry\":\"Select a country\",\"accountHolderName\":\"Account holder name\",\"fullName\":\"Full name\",\"bicSwift\":\"BIC / SWIFT\",\"optional\":\"optional\",\"accountNumber\":\"Account number\",\"routingNumberAba\":\"Routing number (ABA)\",\"sortCode\":\"Sort code\",\"transitInstitution\":\"Transit / Institution\",\"institutionNumber\":\"Institution number\",\"transitNumber\":\"Transit number\",\"ifscCode\":\"IFSC code\",\"bsbCode\":\"BSB code\",\"routingOrSortCode\":\"Routing or sort code\",\"bankName\":\"Bank name\",\"sepaNotice\":\"SEPA transfers usually arrive within 1-2 business days.\",\"internationalNotice\":\"International transfers can take 3-5 business days.\",\"companyInfoTitle\":\"Company info\",\"companyInfoSubtitle\":\"Used on invoices and for tax compliance.\",\"companyLegalName\":\"Legal name\",\"companyLegalNamePlaceholder\":\"e.g. Naano SAS\",\"companyTaxIdFrance\":\"SIRET\",\"companyTaxIdUs\":\"EIN\",\"companyTaxIdUk\":\"Company number\",\"companyTaxIdOther\":\"Company tax ID\",\"companyRegisteredAddress\":\"Registered address\",\"companyRegisteredAddressPlaceholder\":\"Street, city, postal code, country\",\"companyVatNumber\":\"VAT number\",\"companyVatNumberPlaceholder\":\"e.g. FR12345678901\",\"companyVatExempt\":\"Not VAT-registered\",\"companyVatExemptPlaceholder\":\"Not applicable\",\"edit\":\"Edit\",\"cancel\":\"Cancel\",\"companyFieldEmpty\":\"Not set\",\"companySaved\":\"Saved.\"