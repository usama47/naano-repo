 campaign\"}},\"creator\":{\"toast\":{\"accepted\":\"Campaign accepted - it's your turn\",\"declined\":\"Invitation declined\",\"draftSent\":\"Draft sent to the brand\",\"postSubmitted\":\"Post submitted - payment released\",\"failRetry\":\"Failed - try again\",\"briefRequired\":\"This campaign no longer has a usable brief. Ask the brand to update it, then try again.\",\"cancelledByYou\":\"Collaboration cancelled - the brand budget was returned\",\"cancelRequiresSupport\":\"This older collaboration may already be paid. Contact Naano support so it can be cancelled safely.\",\"cancelAfterPublication\":\"This collaboration can no longer be cancelled because a post was already published.\",\"cancelNotActive\":\"This collaboration is no longer active. Refresh the page to see its latest status.\",\"netError\":\"Network error\",\"writeDraft\":\"Write your draft first\",\"pastePostUrl\":\"Paste the published post URL\",\"applied\":\"Application sent - the brand is notified\",\"fail\":\"Failed\",\"enterAmount\":\"Enter an amount\",\"withdrawRequested\":\"Withdrawal requested - transfer being prepared\",\"withdrawFail\":\"Withdrawal failed\",\"methodSaveFail\":\"Could not save the payout method - it will reset on reload\",\"loadMsgFail\":\"Couldn't load messages\",\"msgNotSent\":\"Message not sent\",\"writeMessage\":\"Write a message first\",\"sessionExpired\":\"Session expired - sign in again\",\"settingsSaved\":\"Settings saved\",\"resync\":\"LinkedIn refresh queued. Your profile and authorized recent posts will update as they finish.\",\"resyncComplete\":\"LinkedIn refresh completed\",\"resyncFailed\":\"LinkedIn could not be updated. Please try again.\",\"resyncTimedOut\":\"Your refresh is still queued. It will resume automatically when available.\",\"resyncUnavailable\":\"Re-sync unavailable\",\"profileUnpublished\":\"Profile not published - enable it from creator onboarding\",\"notifsRead\":\"Notifications marked read\",\"trackingLinkCopied\":\"Unique tracking link copied\",\"copyFailed\":\"Copy failed - select the link manually\",\"profileUpdated\":\"Profile updated\",\"bundleLimit\":\"You can add up to 2 bundles\",\"accountUnlocked\":\"Account unlocked — you can now apply\",\"setupSavedUntilFollowers\":\"Setup saved — you can apply once you reach {count} Followers\",\"stripeUnavailable\":\"Stripe is unavailable\",\"stripeStatusUnavailable\":\"We could not verify your Stripe account. Try again.\",\"stripeAccountNotReady\":\"Complete Stripe verification before requesting a payout.\",\"counterSent\":\"Counter-offer sent to the brand\",\"imageTooLarge\":\"Image too large (max 8 MB)\",\"imageUploadFail\":\"Image upload failed\",\"imageUploading\":\"Wait for the image upload to finish\",\"localeFail\":\"Could not change language - try again\",\"collaborationUnavailable\":\"This collaboration is no longer available.\",\"brandFundingRequired\":\"The brand needs to add funds before this campaign can be accepted.\",\"counterSameAmount\":\"Choose an amount different from the current offer.\",\"counterTooHigh\":\"This counter-offer is above the allowed range. Enter a lower amount or contact Naano.\",\"counterExpired\":\"This offer has expired. Ask the brand to send a new invitation.\",\"counterWaitingBrand\":\"Your counter-offer was already sent. The brand now needs to respond.\",\"counterNotPending\":\"This invitation is no longer open for negotiation.\",\"experienceCopied\":\"LinkedIn experience details copied\",\"cardLinkCopied\":\"Creator card link copied\"},\"externalSourcing\":{\"overFollowers\":\"Over {count} followers\",\"followerRange\":\"{min}–{max} followers\",\"perPost\":\"per post\",\"minimumHint\":\"This opportunity requires {count} followers.\",\"minimumCta\":\"{count}+ followers required\",\"eligibleFollowers\":\"eligible followers\",\"partnerFallback\":\"External partner\",\"managedBy\":\"Managed by\",\"featured\":\"Featured collaboration\",\"campaignBrand\":\"Campaign brand\",\"agencyRole\":\"Agency managing this campaign\",\"outsideTitle\":\"Collaboration managed outside Naano\",\"outsideBody\":\"{partner} is the agency managing this campaign for {brand}. It handles creator selection, contracting, communication and payment directly. Naano only shares the profile information you approve.\",\"indicativeCompensation\":\"Estimated pay per post\",\"compensationHint\":\"Based on your LinkedIn follower count.\",\"badge\":\"External collaboration\",\"applyTitle\":\"Apply for {brand}\",\"applyBody\":\"This collaboration is not contracted, managed or paid through Naano. {partner}, the agency managing this campaign for {brand}, will contact selected creators directly.\",\"consent\":\"I agree that my contact email, first name, last name, LinkedIn URL and follower count are shared with {partner} for this collaboration.\",\"emailRequired\":\"Add an email address to your account before applying.\",\"shareProfile\":\"Share my profile with {partner}\",\"consentRequired\":\"Confirm profile sharing before applying.\",\"sent\":\"Profile shared - Identity Labs will contact selected creators.\",\"saved\":\"Application saved - it will be shared with Identity Labs shortly.\",\"minimumNotMet\":\"Your audience does not meet this opportunity’s follower requirement.\",\"countryNotEligible\":\"This collaboration is only available to creators in the United Kingdom, United States, Canada or Mexico.\",\"linkedinRequired\":\"Add your LinkedIn profile before applying.\",\"identityRequired\":\"Add your first and last name before applying.\",\"rateLimited\":\"Too many applications today. Try again later.\",\"deliveryUnavailable\":\"This opportunity is temporarily unavailable while profile delivery is being configured.\"},\"confirm\":{\"decline\":\"Decline this invitation? This cannot be undone.\",\"cancelActive\":\"Cancel this collaboration? Your reserved payment will not be released and the brand will get its held budget back.\",\"withdraw\":\"Confirm withdrawal?\"},\"status\":{\"invite\":{\"label\":\"Invitation received\",\"help\":\"The brand is inviting you. Accept before the deadline - otherwise it expires and nothing is charged.\"},\"applied\":{\"label\":\"Application sent\",\"help\":\"Your application is awaiting the brand. You can cancel it until it is accepted.\"},\"prog\":{\"label\":\"In progress\",\"help\":\"Booking accepted - write your post before the \\\"post latest by\\\" deadline. Without publishing, the booking can be cancelled.\"},\"draft_review\":{\"label\":\"Draft under review\",\"help\":\"Your draft is awaiting the brand’s approval. You can’t publish before they respond.\"},\"changes\":{\"label\":\"Changes requested\",\"help\":\"The brand requested changes - resubmit a revised draft to unblock publishing.\"},\"ready\":{\"label\":\"Ready to publish\",\"help\":\"Draft approved: publish on LinkedIn then submit the post URL before the deadline.\"},\"live\":{\"label\":\"Posted\",\"help\":\"Post published. Your payment is released at publication.\"},\"funding_wait\":{\"label\":\"Waiting for funding\",\"help\":\"This collaboration is waiting for the brand's wallet to be funded. It confirms automatically once the brand tops up - nothing to do on your side. If the brand never funds it, it expires and nothing happens.\"},\"done\":{\"label\":\"Completed\",\"help\":\"Collaboration finished - your payment was released to your balance.\"},\"declined\":{\"label\":\"Declined\",\"help\":\"You declined this invitation. Nothing was charged to the brand.\"},\"cancelled\":{\"label\":\"Cancelled\",\"help\":\"This booking was cancelled by the brand or Naano. No payout will be released for it.\"},\"expired\":{\"label\":\"Expired\",\"help\":\"This booking expired after acceptance - no post was published before the deadline. No payout will be released for it.\"},\"disputed\":{\"label\":\"Disputed\",\"help\":\"This booking is under review by the Naano team. The outcome is pending - your payout stays on hold until the dispute is resolved.\"},\"refunded\":{\"label\":\"Refunded\",\"help\":