anageStripe\":\"Manage on Stripe\",\"finishStripe\":\"Finish setup\",\"connectStripe\":\"Connect Stripe\",\"stripeInstant\":\"Instant transfer to your connected Stripe account.\",\"bankDetailsSaved\":\"Bank details saved\",\"withdrawConfirmCopy\":\"You are requesting a withdrawal of\",\"withdrawConfirmTiming\":\"The request will be recorded and processed by our payout team.\"},\"messages\":{\"title\":\"Messages\",\"sub\":\"Your brands and campaign chats. Creators cannot message each other.\"},\"integrations\":{\"title\":\"Connect your AI assistant\",\"subtitle\":\"Connect Claude, ChatGPT, Gemini, Cursor, Copilot or another compatible MCP assistant to your own Naano account.\",\"checking\":\"Checking access\",\"unavailable\":\"Access not enabled\",\"available\":\"Available\",\"jobTitle\":\"Stay focused on the collaboration, not the admin\",\"jobBody\":\"Review briefs and conversations, then prepare the next step from the AI tool you already use.\",\"claudeHint\":\"Use Naano from Claude or Cowork.\",\"chatgptHint\":\"Use Naano from a custom ChatGPT app.\",\"geminiHint\":\"Use Naano from Google Gemini CLI.\",\"cursorHint\":\"Use Naano from Cursor agents.\",\"copilotHint\":\"Use Naano from Copilot Chat in VS Code.\",\"otherTitle\":\"Other MCP client\",\"otherHint\":\"Use any remote MCP client that supports OAuth.\",\"connectClaude\":\"Connect Claude\",\"connectChatgpt\":\"Connect ChatGPT\",\"connectGemini\":\"Connect Gemini\",\"connectCursor\":\"Connect Cursor\",\"connectCopilot\":\"Connect Copilot\",\"connectOther\":\"Connect another app\",\"readTitle\":\"What it can review\",\"readAccess\":\"Read access\",\"readBriefs\":\"Your collaboration briefs and deadlines\",\"readDrafts\":\"Your draft history and post status\",\"readMessages\":\"Your conversations and messages\",\"actionsTitle\":\"Actions it can prepare\",\"readOnly\":\"Read-only\",\"confirmedActions\":\"Confirmed actions\",\"actionDraft\":\"Submit a draft to the brand for review\",\"actionMedia\":\"Ask whether you want to attach an image before submitting a draft\",\"actionMessage\":\"Reply in an existing collaboration conversation\",\"actionConfirm\":\"Every action requires explicit confirmation\",\"safety\":\"The assistant only receives access to your own creator account after OAuth consent. Naano rechecks ownership, collaboration access, rate limits and duplicate actions on the server.\",\"setupTitle\":\"Connect Naano\",\"copyUrl\":\"Copy MCP URL\",\"stepCopy\":\"Copy the secure Naano MCP URL.\",\"stepProvider\":\"Add it as a custom connector in your AI application.\",\"stepApprove\":\"Sign in to Naano, review the requested access and approve it.\",\"openProvider\":\"Open provider settings\",\"notAvailable\":\"Creator integrations are not enabled for this account.\",\"setupClaude\":\"Connect Naano to Claude\",\"setupChatgpt\":\"Connect Naano to ChatGPT\",\"setupGemini\":\"Connect Naano to Gemini CLI\",\"setupCursor\":\"Connect Naano to Cursor\",\"setupCopilot\":\"Connect Naano to GitHub Copilot\",\"setupOther\":\"Connect another MCP client\",\"claudeSetupHint\":\"Claude supports a custom remote connector with automatic OAuth registration.\",\"chatgptSetupHint\":\"Create a custom MCP app in a supported ChatGPT workspace and scan the tools before connecting.\",\"geminiSetupHint\":\"Gemini CLI supports remote HTTP MCP servers with automatic OAuth discovery.\",\"cursorSetupHint\":\"Cursor supports remote Streamable HTTP MCP servers with OAuth.\",\"copilotSetupHint\":\"VS Code Copilot Chat supports remote HTTP MCP servers and browser OAuth.\",\"otherSetupHint\":\"Use a trusted client that supports remote Streamable HTTP and OAuth 2.1.\",\"claudeStep\":\"In Claude, open Settings, then Connectors, and add a custom connector. Leave Client ID and Client Secret empty.\",\"chatgptStep\":\"In ChatGPT, enable developer mode, then open Settings, Apps, Create and add this MCP URL with OAuth.\",\"geminiStep\":\"Run gemini mcp add --transport http naano https://naano.com/api/mcp, then authenticate with /mcp auth naano.\",\"cursorStep\":\"In Cursor Settings, open MCP, add a global remote server with this URL, then complete the OAuth sign-in.\",\"copilotStep\":\"In VS Code, run MCP: Add Server, choose HTTP, paste this URL, save it to your user profile and approve OAuth.\",\"otherStep\":\"Add this URL as a remote Streamable HTTP server, keep authentication on OAuth and review every requested action.\",\"openClaude\":\"Open Claude settings\",\"openChatgpt\":\"Open ChatGPT\",\"openGemini\":\"Open Gemini CLI guide\",\"openCursor\":\"Open Cursor MCP guide\",\"openCopilot\":\"Open Copilot MCP guide\",\"openOther\":\"Browse MCP clients\",\"urlCopied\":\"MCP URL copied. Paste it into your AI application.\",\"copyFailed\":\"Copy failed. Select and copy the URL manually.\"},\"settings\":{\"title\":\"Settings\",\"sub\":\"Your company and billing details - required to accept collaborations.\",\"personalTitle\":\"Personal profile\",\"personalSub\":\"This name appears on your creator card, messages and collaborations.\",\"displayName\":\"Display name\",\"saveName\":\"Save name\",\"invalidDisplayName\":\"Enter the name you want brands to see.\",\"displayNameSaved\":\"Display name updated\",\"displayNameSaveFailed\":\"Your display name could not be saved. Try again.\",\"companyTitle\":\"Company and billing\",\"companySub\":\"This information appears on your payout invoices.\",\"legalName\":\"Legal name\",\"accountHolder\":\"Account holder\",\"socialTitle\":\"Social links\",\"socialSub\":\"LinkedIn feeds your stats. X is declarative, X stats arrive with the integration.\",\"syncedFromLinkedin\":\"Synced from LinkedIn\",\"followers\":\"Followers\",\"basedIn\":\"Based in\",\"industries\":\"Industries\",\"industriesHint\":\"(you can edit, up to 3)\",\"xPh\":\"https://x.com/your-account\",\"lastScrape\":\"Profile last updated:\",\"rescrapeLimit\":\"limited to once a week\",\"resyncCta\":\"Refresh profile\",\"resyncing\":\"Refreshing LinkedIn…\",\"never\":\"never\",\"bankTitle\":\"Bank details\",\"bankSub\":\"Your saved payout details.\",\"noBankSaved\":\"No bank details saved\",\"bankAddHint\":\"Add your details to receive bank transfers.\",\"edit\":\"Edit\",\"bankSaved\":\"Bank transfer details saved\",\"bankAccount\":\"Bank account\",\"endingIn\":\"ending {last4}\",\"rescrapeNext\":\"Next profile refresh available:\",\"deleteTitle\":\"Delete your account\",\"deleteSub\":\"Permanently delete your creator account and all associated data. This cannot be undone.\",\"deleteWarningTitle\":\"This action is irreversible\",\"deleteWarningBody\":\"All your data, collaborations and messages will be permanently deleted. You will be signed out and cannot recover the account.\",\"deleteButton\":\"Delete my account\",\"deleteConfirmButton\":\"Permanently delete my account\",\"deleting\":\"Deleting…\",\"deleteConfirm\":\"Are you sure you want to delete your account? This choice is irreversible and cannot be undone.\",\"deleteError\":\"Failed to delete account. Please try again or contact support.\",\"tourTitle\":\"Guided tour\",\"tourSub\":\"Review the five main creator pages and where to find each action.\",\"tourCta\":\"Restart the tour\",\"resyncHelp\":\"Available once a week. Updates your profile and followers, not your post history. Naano collaboration posts are added automatically after you submit their published link.\"},\"tour\":{\"progress\":\"Step {current} of {total}\",\"skip\":\"Skip\",\"back\":\"Back\",\"next\":\"Next\",\"finish\":\"Finish\",\"profileTitle\":\"Your Marketplace card\",\"profileBody\":\"This is your private preview and editor. Keep your positioning, packs and price clear before sharing your card.\",\"homeTitle\":\"Your creator overview\",\"homeBody\":\"Start here to see your card, priority actions and active collaborations at a glance.\",\"opportunitiesTitle\":\"Find opportunities\",\"opportunitiesBody\":\"Browse campaigns that match your profile. If professional information is required, Naano will ask for it before you apply.\",\"collabsTitle\":\"Manage collaborations\",\"collabsBody\":\"Invitations, briefs, drafts and publication steps stay together here.\",\"analyticsTitle\":\"Track your performance\",\"analyticsBody\":\"Follow your audience and collaboration performance. Earnings, messages and settings remain available in the navigation.\",\"replayError\":\"The guided tour could not be restarted. Please try again.\"},\"pro\":{\"headConfirm\":\"Confirm your price\",\"headReview\":\"Review your professional setup\",\"headComplete\":\"Complete your professional setup\",\"subConfirm\":\"Almost done — we already have your business details below for review. Just confirm your net price per Post.\",\"subComplete\":\"Naano pays creators as a business. We pre-filled everything we know — review it and complete what is missing. You can edit it later in Settings.\",\"subCompleteEu\":\"Creators in France and the European Union need registered professional details for paid collaborations. We pre-filled everything we know — review it and add what is missing.\",\"subCompleteOutsideEu\":\"Complete your legal and billing details before paid collaborations. A registered business is not required outside the European Union.\",\"subUnlocks\":\"This unlocks applying and accepting Bookings.\",\"confirmPrice\":\"Confirm my price\",\"unlock\":\"Save my professional information\",\"billingFrameTitle\":\"Billing information\",\"edit\":\"Edit\",\"businessSection\":\"Professional and billing information\",\"priceSection\":\"Your price per Post (net to you)\",\"perPost\":\"/ Post\",\"bundlesSection\":\"Bundles (optional)\",\"addBundle\":\"+ Add a bundle\"},\"profile\":{\"title\":\"My card\",\"sub\":\"Make it stronger, share it with brands and keep your LinkedIn proof up to date.\",\"professionalBannerTitle\":\"Not visible on the Marketplace yet\",\"professionalBannerBody\":\"Your workspace stays accessible. Complete the remaining requirements before brands can discover and book your card.\",\"professionalBannerCta\":\"Complete my information\",\"marketplaceHiddenTitle\":\"Not visible on the Marketplace yet\",\"marketplaceAudienceBody\":\"Your workspace and card remain accessible. Marketplace visibility unlocks when your audience reaches {count} followers.\",\"marketplaceProfessionalBody\":\"Your workspace stays accessible while you complete the remaining Marketplace requirements.\",\"marketplaceCountryMissingTitle\":\"Confirm your country to be listed\",\"enrichmentPendingTitle\":\"LinkedIn enrichment in progress\",\"enrichmentPendingBody\":\"Photo, country and profile data are being added automatically.\",\"marketplaceCountryMissingBody\":\"Your workspace stays accessible. Add your country before brands can discover your card.\",\"marketplaceRejectedTitle\":\"Marketplace access unavailable\",\"marketplaceRejectedBody\":\"Your latest Marketplace application was rejected, so brands cannot currently discover your card.\",\"marketplacePriceBody\":\"Your workspace stays accessible. Add a price before brands can discover your card.\",\"marketplaceUnavailableBody\":\"Your workspace stays accessible, but we could not confirm that your card is currently listed.\",\"marketplaceVisibleSetupTitle\":\"Visible on the Marketplace\",\"marketplaceVisibleSetupBody\":\"Brands can discover your card. Complete your professional information before applying to paid campaigns, accepting bookings, invoicing or withdrawing your earnings.\"},\"billing\":{\"title\":\"We need your company details to pay you out\",\"sub\":\"Naano pays creators as a business - your payout invoice needs these. Saved once, editable in Settings.\",\"save\":\"Save \u0026 withdraw\",\"cancel\":\"Later\",\"saved\":\"Company details saved - confirm your withdrawal\",\"legalNamePh\":\"Legal / business name\",\"vatNumberPh\":\"VAT number\",\"vatExempt\":\"VAT-exempt\",\"addressPh\":\"Billing address\",\"mandate\":\"I authorize Naano to issue self-billing invoices in my name for my payouts and accept the Terms.\",\"certify\":\"I certify that I am authorized to operate this business and that the information provided is accurate.\",\"errLegalName\":\"Legal / business name is required.\",\"errTaxId\":\"Company / tax identifier is required.\",\"errAddress\":\"Billing address is required.\",\"errMandate\":\"Please accept the self-billing mandate — we need it to issue your payout invoices.\",\"errCertify\":\"Please certify that you are authorized to operate this business.\",\"nonEuNote\":\"Outside the EU, company number and VAT are not required. We only need your legal name, billing address and the two confirmations below.\"},\"brief\":{\"none\":\"No brief provided yet -\",\"ask\":\"ask {brand} in Messages\",\"view\":\"View the brief\",\"unavailable\":\"The brief is temporarily unavailable.\",\"inlineTitle\":\"Campaign brief\",\"inlineHint\":\"Everything you need to create the post is available here.\",\"openLarge\":\"Open full view\",\"openInNaano\":\"Expand in Naano\",\"externalTitle\":\"Brief provided by the brand\",\"externalHint\":\"This campaign uses an existing Notion, Google Doc or web page.\",\"openExternal\":\"Open the full Brief\",\"open\":\"Open Brief\"},\"nba\":{\"inviteBefore\":\"Reply to the invitation from\",\"inviteExpires\":\"before it expires.\",\"seeInvitation\":\"See the invitation\",\"waitsRevisedDraft\":\"is waiting for a revised draft.\",\"resubmit\":\"Resubmit\",\"draftApprovedBy\":\"Draft approved by\",\"publishAndSubmit\":\": publish and submit the URL.\",\"publish\":\"Publish\",\"nextPostFor\":\"Next post for\",\"deadline\":\"deadline\",\"open\":\"Open\"},\"next\":{\"acceptOrDecline\":\"Accept or decline the campaign\",\"waitBrandDecision\":\"Wait for the brand to respond\",\"waitReview\":\"Wait for the review\",\"resubmitDraft\":\"Resubmit a draft\",\"publishSubmit\":\"Publish and submit the URL\",\"submitDraft\":\"Submit your draft\",\"paymentReleasesOn\":\"Payment releases on\"},\"invites\":{\"expiresOn\":\"Expires on\",\"accept\":\"Accept campaign\",\"confirmAccept\":\"Accept this campaign?\\n\\n{terms}\",\"empty\":\"No pending invitations. Polish your public profile, it is what convinces brands.\",\"counterSent\":\"Counter sent · waiting for brand\",\"counterOffer\":\"Counter-offer\",\"counterNeedsBrief\":\"Ask the brand to add a campaign brief before changing this legacy offer.\",\"counterSentHelp\":\"You proposed a new net price. The brand must confirm or refuse it; nothing else is required from you.\",\"counterTitle\":\"Counter-offer\",\"currentOffer\":\"Current offer\",\"listedRate\":\"Listed rate ≈\",\"yourCounter\":\"Your counter-offer (net €)\",\"counterFinalHelp\":\"The brand will see your proposed net amount and can accept or decline it. If accepted, the collaboration starts once the brand wallet is funded — there is no second action for you.\",\"sendCounter\":\"Send counter\",\"counterInlineHint\":\"Change the price, then send.\",\"counterMin\":\"Enter at least €10 net\",\"sendingCounter\":\"Sending…\",\"onePost\":\"1 post\",\"nPosts\":\"{n} posts\",\"netTotal\":\"net\",\"listedWas\":\"listed {price}\",\"offerExpires\":\"offer until\",\"contentDue\":\"Post by\"},\"steps\":{\"bookingCreated\":\"Booking created\",\"applicationSent\":\"Application sent\",\"awaitingBrandDecision\":\"Awaiting the brand's decision\",\"applicationAccepted\":\"Application accepted\",\"invitationAccepted\":\"Invitation accepted\",\"draftApproved\":\"Draft approved by the brand\",\"approved\":\"Approved\",\"submitted\":\"Submitted\",\"changesRequested\":\"Changes requested\",\"postPublished\":\"Post published\",\"by\":\"By\",\"paymentReleased\":\"Payment released\",\"released\":\"Released\",\"onDate\":\"On\"},\"panel\":{\"whereTitle\":\"Where this collaboration stands\",\"noActionTitle\":\"No action needed right now\",\"actionRequired\":\"Action required\",\"upToDate\":\"You are up to date\",\"reviewInvitation\":\"Review invitation\",\"addPublishedPost\":\"Add published post\",\"workOnDraft\":\"Work on draft\",\"contactCompany\":\"Message company\",\"messageBrand\":\"Message {brand}\",\"backToCollaborations\":\"Back to collaborations\",\"backToList\":\"Back to list\",\"localDemo\":\"Local demo\",\"collaborationDetails\":\"Collaboration details\",\"noDeadline\":\"No deadline\",\"contactTitle\":\"Message {company}\",\"contactSub\":\"Ask a question about the brief, feedback or publication. The conversation stays attached to this collaboration.\",\"messagePh\":\"Write your message…\",\"sendMessage\":\"Send message\",\"demoMessageSent\":\"Demo message sent to Naano\",\"demoApproved\":\"Demo: the draft was approved by Naano\",\"simulateApproval\":\"Demo: simulate brand approval\",\"acceptFor\":\"Accept campaign for\",\"decline\":\"Decline\",\"brandFeedback\":\"Brand feedback:\",\"revisionRequested\":\"Revision requested\",\"updateAndResubmit\":\"Update your post and send it back\",\"sendRevisedDraft\":\"Send revised draft\",\"sendRevisedDraftHelp\":\"The brand will be notified immediately\",\"draftPh\":\"Paste your post text…\",\"sendForApproval\":\"Send to the brand for approval\",\"yourSubmittedDraft\":\"Your submitted draft\",\"yourApprovedDraft\":\"Your approved draft\",\"publishSubmitTitle\":\"Publish and submit the URL\",\"publishSubmitSub\":\"Publish on LinkedIn then paste the URL. Your payment is released at publication.\",\"postRetentionNotice\":\"Keep it live for at least 6 months.\",\"submitPublishedPost\":\"Submit the published post\",\"seePublishedPost\":\"See the published post\",\"cancelCollaboration\":\"Need to stop this collaboration?\",\"cancelCollaborationHelp\":\"You can cancel before publishing. You will not be paid, and the brand’s reserved budget will be returned automatically.\",\"cancelCollaborationCta\":\"Cancel collaboration\",\"releasedToBalance\":\"Released to your balance\",\"releasesOn\":\"Releases on\",\"afterPublication\":\"After publication\",\"paymentTitle\":\"Payment\",\"release\":\"Release\",\"trackingTitle\":\"Your permanent link for this brand\",\"trackingBody\":\"This URL stays the same for every campaign with this brand. Naano automatically assigns each new click to the current campaign.\",\"trackingCurrentCampaign\":\"Current campaign:\",\"trackingMovedBody\":\"this link now tracks that campaign, not this older one.\",\"trackingCopy\":\"Copy\",\"trackingCopied\":\"Copied\",\"trackingDestination\":\"Destination:\",\"trackingMissingTitle\":\"Tracking link unavailable\",\"trackingMissingBody\":\"The brand must add its website in Naano before the unique link can be generated. Ask them in Messages before publishing.\",\"draftImage\":\"Post image (recommended)\",\"draftImageHelp\":\"Attach the image the brand should approve — shown as a LinkedIn post preview.\",\"chooseImage\":\"Choose an image\",\"noImageSelected\":\"No image selected\",\"imageSelected\":\"Image selected\"},\"demo\":{\"campaign\":\"Naano Creator Analytics launch\",\"draft\":\"Most sponsored LinkedIn posts start with the product. I think they should start with the creator’s real problem.\\n\\nFor the last few months, I have been testing a simpler way to connect B2B creators and SaaS companies without endless back-and-forth. Naano now brings the opportunity, the brief, the draft review and the payment into one workflow.\\n\\nThe result: creators spend more time creating, and brands know exactly what happens next.\",\"feedback\":\"Great direction. Make the opening more personal, mention the verified analytics dashboard, and finish with a question for other B2B creators.\",\"brief\":\"OBJECTIVE\\nIntroduce the new Naano creator analytics experience and show how it helps B2B creators understand the business impact of their collaborations.\\n\\nAUDIENCE\\nLinkedIn creators, B2B operators and SaaS marketing teams.\\n\\nKEY MESSAGE\\nA paid collaboration should be easy to manage and useful to learn from — from the brief to payment.\\n\\nDELIVERABLE\\nOne original LinkedIn post between 900 and 1,500 characters. Use your own experience and tone.\\n\\nMUST INCLUDE\\n• The verified analytics dashboard\\n• A concrete creator pain point\\n• A natural mention of Naano\\n• The permanent tracking link\\n\\nAVOID\\nGeneric AI claims, invented results and overly promotional copy.\",\"messagePreview\":\"Let’s align on the revised opening and visual.\",\"companyIndustry\":\"B2B creator marketplace\",\"companyDescription\":\"Naano connects LinkedIn creators with B2B SaaS companies for paid collaborations.\",\"messageWelcome\":\"Hi Thomas, the direction is strong. Could you make the opening more personal and add the creator analytics visual?\",\"messageReply\":\"Yes — I’ll revise the hook and attach the visual with the next draft.\",\"messageFollowup\":\"Perfect. Send it from the collaboration workspace and we’ll review it here.\"},\"msgs\":{\"pickConv\":\"Select a conversation\",\"pickConvDot\":\"Select a conversation.\",\"empty\":\"No conversations yet.\",\"noMessages\":\"No messages yet, say hello.\",\"loadFailed\":\"This conversation took too long to load.\",\"railCampaign\":\"Campaign\",\"railBrand\":\"Brand\",\"seeCollab\":\"See the collaboration\",\"linkedinPostCard\":\"LinkedIn post\",\"sysDraftSubmitted\":\"{name} submitted a draft for review.\",\"sysDraftApproved\":\"Naano approved the draft. Ready to publish.\",\"sysPostPublished\":\"{name} published the post.\",\"sysBookingDeclined\":\"{name} declined the booking.\",\"sysBookingCancelledByBrand\":\"{company} cancelled this collaboration before publication. No payout will be released.\",\"emptyList\":\"No conversations yet - the thread opens with your first Booking.\",\"groupCamps\":\"Campaign chats\",\"groupBrands\":\"Brands\",\"railCampNote\":\"You leave this chat when your Booking ends.\",\"agoMinutes\":\"{n} min\",\"agoHours\":\"{n} h\",\"agoDays\":\"{n} d\",\"loading\":\"Loading…\",\"directThread\":\"Direct thread\",\"counterFundingIntro\":\"The brand accepted your price. The collaboration is waiting for the brand to fund its wallet — nothing to do on your side.\",\"counterAcceptedIntro\":\"The brand accepted your price — the collaboration has started.\",\"confirmIntro\":\"The brand confirmed your price. Accept to start.\",\"counterDecisionClosed\":\"This counter-offer is no longer active.\",\"counterIntro\":\"You proposed a new net price.\",\"inviteIntroShort\":\"Interested in your profile — here’s our proposal.\",\"inviteClosed\":\"This collaboration request is closed\",\"counterFundingStatus\":\"Waiting for brand funding — nothing to do\",\"counterAcceptedStatus\":\"Accepted — collab started\",\"inviteHandled\":\"Handled in Collaborations\",\"sysCounterProposed\":\"{name} proposed a counter-offer of {amount} net.\",\"sysCounterConfirmed\":\"{name} agreed to your counter-offer of {amount} net.\",\"inviteBadge\":\"Collaboration offer\",\"previewDraft\":\"Draft submitted\",\"previewPost\":\"Post published\",\"offerNet\":\"Offer\",\"net\":\"net\",\"inviteIntroFor\":\"{company} proposal — collaboration offer for you.\",\"listedNet\":\"Listed\",\"briefSnapshotTitle\":\"Brief snapshot at acceptance\",\"briefSnapshotHelp\":\"This card keeps the historical version. Open the campaign brief for the current instructions.\",\"acceptedBriefToggle\":\"View accepted brief (historical)\",\"inviteReplyWindow\":\"48h to reply\",\"campLeave\":\"You leave this chat when your booking ends.\",\"search\":\"Search conversations\",\"supportHint\":\"A question or need help? Start here.\",\"now\":\"Now\",\"conversations\":\"Conversations\",\"composerPh\":\"Write a message…\",\"composerAria\":\"Write a message\",\"send\":\"Send message\",\"noSearchResults\":\"No conversation matches your search.\"},\"notif\":{\"markAllRead\":\"Mark all as read\",\"booking_cancelled\":\"Collaboration cancelled by the brand\",\"booking_expired\":\"Booking expired\",\"booking_received\":\"Booking received\",\"flat_application_accepted\":\"Flat application accepted\",\"payout_released\":\"Payout released\",\"justNow\":\"just now\",\"minsAgo\":\"m ago\",\"hoursAgo\":\"h ago\",\"daysAgo\":\"d ago\",\"caughtUp\":\"You’re all caught up\"},\"sidebar\":{\"notifications\":\"Notifications\",\"activityEmpty\":\"Your updates will appear here.\",\"seeEarnings\":\"See my earnings\",\"availableEarnings\":\"Available earnings\"},\"setup\":{\"priceHintNoData\":\"Set your net price per post. You can change it anytime in Settings.\",\"officialRange\":\"Official Naano range based on your real last-90-day data: \u003cb\u003e{range}\u003c/b\u003e net per post.\",\"indicativeRange\":\"Indicative estimate based on available reach: \u003cb\u003e{range}\u003c/b\u003e net per post. Connect or refresh the Naano extension for an official recommendation from your real data.\",\"currentPriceReview\":\"Your current price can be adjusted. \",\"brandRange\":\"Brands would see approximately {range}, service fees included.\",\"priceWarningHigh\":\"This price is more than 25% above the recommended range. You can still save it.\",\"priceWarningLow\":\"This price is far below the recommended range and may undervalue your work. You can still save it.\"},\"outcome\":{\"declined\":{\"label\":\"Invitation declined\",\"sub\":\"You declined - no payout for this booking.\"},\"cancelled\":{\"label\":\"Booking cancelled\",\"sub\":\"Cancelled by the brand or Naano - no payout for this booking.\"},\"expired\":{\"label\":\"Expired without publication\",\"sub\":\"The deadline passed - no payout for this booking.\"},\"disputed\":{\"label\":\"Dispute under review\",\"sub\":\"Naano is reviewing this booking - the outcome is pending.\"},\"refunded\":{\"label\":\"Refunded to the brand\",\"sub\":\"No payout will be released for this booking.\"},\"applicationDeclined\":{\"label\":\"Application declined\",\"sub\":\"The brand declined this application.\"},\"applicationCancelled\":{\"label\":\"Application cancelled\",\"sub\":\"This application was cancelled before a booking was created.\"},\"applicationExpired\":{\"label\":\"Application declined\",\"sub\":\"The brand did not respond within 5 days, so the application was automatically declined.\"}},\"timeline\":{\"fundingWait\":\"Waiting for the brand to fund its wallet\"},\"applyModal\":{\"title\":\"Apply · {campaign}\",\"escrowLine\":\"{brand} · if the brand accepts, the booking is created at {net} net for you, held in escrow.\",\"pitchPh\":\"Your pitch - why your audience is a match (optional but recommended)\",\"submit\":\"Send my application →\",\"professionalRequired\":\"Complete your professional information before sending this application.\",\"geoNotEligible\":\"This campaign is not open to creators in your country.\",\"rateLimited\":\"You have sent too many applications today. Please try again later.\"}},\"onboardingV4\":{\"code\":{\"title\":\"Check your email\",\"sentTo\":\"We sent a 6-digit code to\",\"editEmail\":\"Edit email\",\"enterBelow\":\"Enter it below, stay on this page.\",\"verify\":\"Verify \u0026 continue\",\"verifying\":\"Verifying…\",\"resend\":\"Resend code\",\"resendIn\":\"Resend code in {seconds}s\",\"spamHelper\":\"Still no code? Check your spam folder, or sign up with Google instead, no email code needed:\"},\"common\":{\"stepTag\":\"Step {n} of {total}\",\"firstName\":\"First name\",\"lastName\":\"Last name\",\"password\":\"Password\",\"passwordPh\":\"Create a strong password\",\"heard\":\"How did you hear about us?\",\"heardLinkedin\":\"LinkedIn\",\"heardAnotherCreator\":\"Another creator\",\"heardACreator\":\"A creator\",\"heardWordOfMouth\":\"Word of mouth\",\"heardGoogle\":\"Google search\",\"heardOther\":\"Other\",\"continue\":\"Continue\",\"creating\":\"Creating…\",\"orContinueWith\":\"Or continue with\",\"haveAccount\":\"Already have an account?\",\"signInHere\":\"Sign in here\"},\"creator\":{\"genericError\":\"Something went wrong. Please try again.\",\"joinTitle\":\"Join Naano\",\"joinSub\":\"Get paid to create LinkedIn content for B2B brands you actually use.\",\"accountReadyTitle\":\"Your Naano account is ready\",\"accountReadySub\":\"Your account has already been created and verified. You can return to the card choice without creating your account again.\",\"accountReadyContinue\":\"Continue to my card choice\",\"backToAccount\":\"Back to my account\",\"email\":\"Email\",\"emailPh\":\"you@email.com\",\"linkedinTitle\":\"Connect your account\",\"linkedinSub\":\"Paste your LinkedIn - we fill in the rest automatically (followers, headline, your topics).\",\"linkedinPh\":\"https://www.linkedin.com/in/you\",\"verificationChoiceTitle\":\"Do you want to become Naano Verified?\",\"verificationChoiceSub\":\"Choose whether to connect your LinkedIn analytics now. Connecting is optional, and you can change your mind later.\",\"recommended\":\"Recommended\",\"verifiedChoiceTitle\":\"Become Naano Verified\",\"verifiedChoiceBody\":\"Connect your private LinkedIn analytics to create a more complete, trustworthy card for brands.\",\"verifiedBenefitData\":\"Real 90-day impressions and audience analytics\",\"verifiedBenefitTrust\":\"An enriched card with clear data provenance\",\"verifiedBenefitVisibility\":\"May improve how prominently you appear in the Marketplace\",\"verifiedRankingDisclaimer\":\"Naano Verified improves card completeness and confidence, but never guarantees a Marketplace position or ranking.\",\"verifiedSetupTitle\":\"Connect your LinkedIn session\",\"verifiedSetupSub\":\"This lets us retrieve the key data that enriches your creator card and helps brands discover you.\",\"backToVerificationChoice\":\"Back\",\"verifyExtension\":\"I installed the extension — verify it\",\"verifyingExtension\":\"Checking the extension…\",\"backToExtensionSetup\":\"Back to extension setup\",\"extensionValidatedTitle\":\"Extension verified\",\"extensionValidatedSub\":\"The Naano extension is connected. You can now start analyzing your LinkedIn profile.\",\"becomeVerified\":\"Analyze my profile and become Verified (opens one LinkedIn tab only)\",\"classicChoiceTitle\":\"Continue with a Basic profile\",\"classicChoiceBody\":\"Finish signing up without connecting your private LinkedIn analytics.\",\"classicChoiceHint\":\"Your card will use available public information and estimated reach. You can connect the extension later from your profile.\",\"extensionTemporarilyUnavailable\":\"The Naano extension is coming soon\",\"extensionUnavailableBody\":\"Chrome Web Store approval is still pending. Continue with your public LinkedIn profile for a Basic card — you can upgrade to Naano Verified as soon as the extension is live.\",\"classicLinkedinTitle\":\"Add your public LinkedIn profile\",\"classicLinkedinSub\":\"No extension is needed. We’ll retrieve only the minimum public information required to create your Basic card.\",\"classicLinkedinLabel\":\"Public LinkedIn profile URL\",\"classicPublicImportNotice\":\"By clicking below, you authorize Naano to read your public profile once: name, photo, headline, country and follower count. We do not import your posts, engagement or private analytics.\",\"classicImportProfile\":\"Import my public profile\",\"invalidLinkedInUrl\":\"Enter a valid public LinkedIn profile URL, for example https://www.linkedin.com/in/your-name.\",\"linkedinIdentityLocked\":\"This card is already bound to a LinkedIn identity. Use the Na(a)no Verified flow to change it safely.\",\"retryPublicImport\":\"Check the URL and try again\",\"publicImportDisabled\":\"Public LinkedIn import is disabled in this environment. You can continue manually or ask the team to enable it.\",\"publicImportBudgetPaused\":\"Public LinkedIn import is temporarily paused to control costs. You can continue manually and try again later.\",\"publicImportConsentFailed\":\"We couldn't save your public LinkedIn import permission. Please try again in a moment.\",\"continueClassic\":\"Continue without connecting\",\"classicReviewBox\":\"Your Basic card uses public profile information only. Your posts, engagement and private LinkedIn analytics remain disconnected.\",\"importProfile\":\"Connect \u0026 continue\",\"readingProfile\":\"Reading your profile…\",\"startingImport\":\"Connecting to LinkedIn…\",\"extensionInstall\":\"Install the Naano Confirm extension from the Chrome Web Store to analyze your own profile from your open LinkedIn session. Your cookie never leaves your browser.\",\"extensionDownload\":\"Download extension {version}\",\"extensionUpdateDownload\":\"Download extension {version}\",\"extensionInstallFromStore\":\"Install Chrome extension (1 click) →\",\"extensionStoreGuideTitle\":\"One-click install\",\"extensionStoreGuideSub\":\"Approved on the Chrome Web Store — no developer mode.\",\"extensionStoreStepOpen\":\"Click “Install Chrome extension” (opens the Chrome Web Store).\",\"extensionStoreStepAdd\":\"On the Chrome page, click “Add to Chrome” and confirm.\",\"extensionStoreStepReturn\":\"Come back here and click “I installed the extension — verify it”. Detection is automatic.\",\"extensionGuideTitle\":\"Install the unpacked extension\",\"extensionGuideSub\":\"Three steps in Google Chrome, in under a minute.\",\"extensionGuideStepDownload\":\"Unzip the ZIP file you just downloaded.\",\"extensionGuideStepChrome\":\"Open chrome://extensions and enable Developer mode in the top-right corner.\",\"extensionGuideStepLoad\":\"Click “Load unpacked” and select the unzipped folder.\",\"extensionVisualKicker\":\"Guided installation\",\"extensionVisualTitle\":\"Just follow these three clicks.\",\"extensionVisualSub\":\"Everything happens on Google Chrome’s Extensions page.\",\"extensionVisualDeveloperMode\":\"Developer mode\",\"extensionVisualLoadUnpacked\":\"Load unpacked\",\"extensionVisualChooseFolder\":\"Select the unzipped Naano Confirm folder\",\"extensionVisualVideoSlot\":\"45 sec demo\",\"extensionVersionInstallHint\":\"If Chrome still shows an older version, remove it and load the newly unzipped folder. Reload keeps the old folder and does not update it.\",\"extensionInstructions\":\"Unzip it, open chrome://extensions, enable Developer mode, and load the unzipped folder. Then come back here: detection is automatic.\",\"extensionBrowserNote\":\"Downloading is not enough: the extension must be loaded in chrome://extensions. It does not work in the embedded browser.\",\"extensionConsent\":\"I authorize Naano Confirm to read my profile, post analytics and audience segments from my open LinkedIn session, then send them securely to Naano for display to brands on my profile. My LinkedIn cookie is never transmitted and nothing will be posted or changed on LinkedIn.\",\"extensionReviewBox\":\"Your connection and sync are validated. Your Naano Verified card may be shown more prominently, with no ranking guarantee; commercial eligibility is reviewed separately.\",\"extensionReady\":\"Naano extension {version} detected — ready.\",\"extensionMissing\":\"The Naano extension was not detected. Install it from the Chrome Web Store, then try again.\",\"extensionOutdated\":\"This extension version is outdated. Update it from the Chrome Web Store, then try again.\",\"extensionRetry\":\"Reconnect LinkedIn and try again\",\"linkedinSessionRequired\":\"Open LinkedIn in Chrome, leave it open, come back here and reload this page.\",\"naanoSessionRequired\":\"Your Naano session expired. Sign back in to Naano and try again; your LinkedIn connection was detected successfully.\",\"creatorAccountRequired\":\"This Naano account is not configured as a creator account. Return to profile selection and choose Creator.\",\"authTemporarilyUnavailable\":\"We could not verify your Naano session because of a temporary issue. Try again in a few seconds; your LinkedIn connection is still detected.\",\"extensionLaunchFailed\":\"The extension was detected but did not respond when the import started. Remove the old version and load the new unzipped folder before verifying it again.\",\"importStartFailed\":\"The import could not start. Try again in a few seconds.\",\"extensionImportFailed\":\"Naano Verified connection did not complete. Try again or continue with a Basic card and connect the extension later.\",\"linkedinIdentityAlreadyLinked\":\"This LinkedIn profile is already associated with another Naano account. Sign in to that account or contact support to request a transfer. You can also continue with a Basic card.\",\"importRunning\":\"We’re importing your profile and this month’s posts in the background.\",\"importRunningHint\":\"You can keep going. We’ll notify you as soon as your data is ready.\",\"billingStepTitle\":\"Add your billing information\",\"billingStepSub\":\"Your LinkedIn data is importing in the background. Complete these details so Naano can generate self-billed invoices and secure your payments.\",\"billingImportBackground\":\"Your LinkedIn import is continuing in the background — you do not need to wait for it.\",\"billingContinue\":\"Continue to my creator card\",\"importComplete\":\"{measured}/{expected} posts from this month measured with real impressions.\",\"refreshLinkedInData\":\"Refresh my data\",\"reviewTitle\":\"Review your creator profile\",\"classicReviewTitle\":\"Complete your creator card\",\"scrapeFailed\":\"We couldn't read your public LinkedIn profile right now. You can retry, or finish your Basic card by selecting your industries manually.\",\"followers\":\"followers\",\"classicAudienceImportedBox\":\"Public audience imported: {followers} followers. This enriches your Basic card, but only a Naano Verified connection can confirm that you own the profile and unlock Flat Fee.\",\"eligibleBox\":\"You're eligible for paid campaigns. One more step after this (your business details + price) unlocks applying.\",\"notEligibleBox\":\"You have \u003cb\u003e{followers}\u003c/b\u003e followers. Paid campaigns open at \u003cb\u003e{floor}\u003c/b\u003e. Keep posting and come back - you can re-check your count once a week from Settings.\",\"industriesLabel\":\"Your industries\",\"industriesMax\":\"(pick up to 3)\",\"industriesHint\":\"We suggested these from your profile - brands find you by these. Adjust if needed.\",\"classicIndustriesHint\":\"Choose up to 3 industries to help relevant brands find your card.\",\"saving\":\"Saving…\",\"errIndustry\":\"Confirm at least one industry.\",\"priceBack\":\"Edit my industries\",\"priceRecommendationEyebrow\":\"Our recommendation\",\"priceRecommendationTitle\":\"We recommend €{price} per post\",\"priceRecommendationBody\":\"Naano recommends this starting price from the public audience and performance information currently available. You can change it now or later.\",\"priceNoRecommendationTitle\":\"Set your price per post\",\"priceNoRecommendationBody\":\"We do not have enough data yet to make a reliable recommendation. Choose the rate that works for you.\",\"priceChoiceLabel\":\"Price per post choice\",\"priceUseRecommended\":\"Keep €{price}\",\"priceUseRecommendedHint\":\"Use Naano's recommendation\",\"priceSetMyOwn\":\"Choose my price\",\"priceSetMyOwnHint\":\"I prefer to set my own rate\",\"priceCustomLabel\":\"Your net price per post\",\"priceCustomHint\":\"Minimum €10. You can change it later from your profile.\",\"priceAdjustHint\":\"The price is directly editable. Adjust it if you want to charge more per post.\",\"priceContinueToBundle\":\"Continue to my bundle\",\"priceContinue\":\"Confirm my price and continue\",\"priceRequired\":\"Choose or enter a price per post to continue.\",\"priceMinimum\":\"Your price must be at least €10.\",\"bundleTitle\":\"Your bundle offer (optional)\",\"bundleBack\":\"Edit my price per post\",\"bundleBody\":\"Optionally set the total price paid for several posts. You can add bundles later in Settings.\",\"bundlePrimary\":\"Primary bundle\",\"bundleSecondary\":\"Second bundle\",\"bundlePostsLabel\":\"Number of posts\",\"bundlePostsUnit\":\"posts\",\"bundleTotalLabel\":\"Total net price\",\"bundleSummary\":\"€{price}/post · brand saves €{saving}\",\"bundleAddSecond\":\"Add another bundle\",\"bundleRemove\":\"Remove this bundle\",\"bundleRequired\":\"Add a price for at least one bundle to continue.\",\"bundleInvalid\":\"Each bundle must include at least 2 posts and cost at least €10.\",\"bundleContinue\":\"Confirm my offer and create my profile\",\"cardPreviewKicker\":\"Your Marketplace card\",\"cardPreviewTitle\":\"Build a card brands can trust.\",\"cardPreviewSub\":\"It updates live with your profile, analytics, positioning and price.\",\"cardRevealTitle\":\"Here is your Marketplace card\",\"cardRevealBody\":\"Tap it to flip it over. You will be able to customize it in the profile coming next.\",\"cardRevealContinue\":\"Continue to my profile\",\"cardRevealExtensionTitle\":\"Go Naano Verified\",\"cardRevealExtensionBody\":\"Install the Chrome extension in one click to pull your real LinkedIn stats and enrich your card for brands.\",\"cardRevealExtensionHintStore\":\"After “Add to Chrome”, come back here — we detect the extension automatically, then pull your stats.\",\"cardRevealExtensionHintZip\":\"After installing, click verify to start the automatic import.\",\"cardRevealConnectStats\":\"Connect my LinkedIn stats →\",\"rightTitle\":\"Post. Get paid. Repeat.\",\"rightBody\":\"Get matched with B2B brands, post in your own voice, and get paid - straight to your bank, no invoicing hassle.\",\"linkedinSessionKicker\":\"LinkedIn session\",\"linkedinSessionTitle\":\"Open LinkedIn first\",\"linkedinSessionBody\":\"Naano Confirm reads your stats only while you are signed in to LinkedIn in this browser. Nothing is posted on your behalf.\",\"linkedinSessionStepOpen\":\"Open linkedin.com in Chrome and sign in to your account.\",\"linkedinSessionStepStayOpen\":\"Leave that LinkedIn tab open (minimised is fine).\",\"linkedinSessionStepReturn\":\"Come back to this Naano tab.\",\"linkedinSessionStepReload\":\"Reload this page, then try again.\",\"linkedinSessionOpenLinkedIn\":\"Open LinkedIn\",\"linkedinSessionReload\":\"Reload this page\",\"linkedinSessionRetry\":\"I left LinkedIn open — try again\",\"linkedinSessionFootnote\":\"Your LinkedIn session stays in Chrome. Naano never receives your cookie.\",\"extensionImportSessionFailed\":\"Import paused: LinkedIn was closed or signed out. Leave LinkedIn open, reload, then retry.\",\"extensionDevPackageRequired\":\"This local app needs the Naano Confirm DEV extension (not the Chrome Web Store build). Load the unzipped dev package, then reload this page.\",\"importProfileSetupFailed\":\"Your creator profile could not be prepared for the import. Reload the page and try again. If it persists, sign out and restart onboarding.\",\"extensionHostPermissionRequired\":\"Chrome blocked access to your LinkedIn tab. Open chrome://extensions → Naano Confirm (DEV) → Site access → “On all sites” (or allow linkedin.com), keep LinkedIn open, then retry.\"},\"pro\":{\"headComplete\":\"Complete your professional setup\",\"headReview\":\"Review your professional setup\",\"headConfirm\":\"Confirm your price\",\"subComplete\":\"Naano pays creators as a business. We pre-filled everything we know - review it and complete what's missing. Editable later in Settings.\",\"subConfirm\":\"Almost done - we already have your business details (below, for review). Just confirm your price per post.\",\"subUnlocks\":\"This unlocks applying and accepting bookings.\",\"businessSection\":\"Business (professional accounts only)\",\"priceSection\":\"Your price per post (net to you)\",\"suggested\":\"Suggested for your audience: \u003cb\u003e€{low} - €{high}\u003c/b\u003e. Brands see this up front.\",\"priceHintNoData\":\"Set your net price per post. You can change it anytime in Settings.\",\"perPost\":\"/ post\",\"bundlesSection\":\"Bundles (optional)\",\"postsForEuro\":\"posts for €\",\"addBundle\":\"+ Add a bundle\",\"upTo2\":\"Up to 2 bundles\",\"unlock\":\"Unlock my account\",\"confirmPrice\":\"Confirm my price\",\"edit\":\"Edit\",\"vatExempt\":\"VAT-exempt\",\"billingFrameTitle\":\"Billing information\",\"errBillingFirst\":\"Save your billing information above first.\",\"errPrice\":\"Your price must be at least €10.\"},\"saas\":{\"joinTitle\":\"Join Naano\",\"joinSub\":\"The #1 platform to run LinkedIn creator campaigns that drive real business.\",\"businessEmail\":\"Business email\",\"emailPh\":\"you@company.com\",\"companyTitle\":\"Tell us about your company\",\"companySub\":\"Paste your website - we pre-fill everything from it, then you confirm. Edit anything that's off.\",\"websitePh\":\"https://yourcompany.com\",\"websiteTitle\":\"Your website\",\"websiteLead\":\"We'll read your site to understand the product and your 3 main ICPs. This usually takes 20–40 seconds.\",\"analyzeCta\":\"Analyze my website\",\"analyzingTitle\":\"Reading your brand…\",\"analyzingSub\":\"This usually takes 20–40 seconds. We'll only show you the product and 3 ICPs.\",\"productTitle\":\"Your product \u0026 ICP\",\"productLead\":\"Pulled from your site. Fix anything off — this powers your Best matches.\",\"productLabel\":\"Product (full description)\",\"icpLabel\":\"3 main ICPs ({count}/3)\",\"icpLead\":\"Industries of your ideal customers — max 3.\",\"budgetTitle\":\"What's your creator budget?\",\"budgetLead\":\"Monthly influencer / creator budget — we use it to calibrate recommendations.\",\"budgetLabel\":\"Monthly budget\",\"budgetPick\":\"Choose a range…\",\"fetch\":\"Fetch\",\"fetching\":\"Reading…\",\"companyName\":\"Company name\",\"description\":\"Description\",\"yourIndustry\":\"Your industry\",\"country\":\"Country\",\"pickOne\":\"Pick one\",\"vatRegistered\":\"VAT-registered\",\"vatNumber\":\"VAT number\",\"icpTitle\":\"Who are your customers? (your ICP)\",\"icpHint\":\"We guessed these from your site - they rank your Best creator matches. Fix them so matching is accurate.\",\"targetIndustries\":\"Target industries ({count}/3)\",\"targetGeos\":\"Target geographies ({count})\",\"required\":\"Required\",\"mandateTitle\":\"One legal confirmation\",\"mandateSub\":\"Naano pays your creators on your behalf and issues invoices for you. That requires your agreement below - it can't be skipped.\",\"mandateCheck\":\"I authorize Naano to issue self-billing invoices in my name for creator payouts (self-billing mandate).\",\"accuracyCheck\":\"I certify the company information above is accurate.\",\"back\":\"Back\",\"finishing\":\"Finishing…\",\"finish\":\"Finish setup\",\"dashboardCta\":\"Go to my dashboard →\",\"errBoth\":\"Both confirmations are required to finish.\",\"rightTitle\":\"Creators. Brands. Results.\",\"rightBody\":\"Run LinkedIn creator campaigns that drive real business - discover creators, track performance, pay in one click.\",\"trustedBy\":\"Built for B2B marketing teams\",\"matchesKicker\":\"Last step\",\"matchesTitle\":\"Your best-matched creators\",\"matchesSub\":\"Based on your target market, industry and verified profile quality. The full catalogue is waiting in your marketplace.\",\"matchesCta\":\"Explore my marketplace →\"},\"errors\":{\"emailPasswordRequired\":\"Email and password are required.\",\"passwordMin\":\"Password must be at least 8 characters.\",\"nameRequired\":\"Enter your name.\",\"codeFormat\":\"Enter the 6-digit code from your email.\",\"codeExpired\":\"That code has expired - request a new one.\",\"codeWrong\":\"That code isn't right - check your email and try again.\",\"profileSetupFailed\":\"Your account was created, but your Naano profile could not be initialized. Try again in a few seconds.\",\"tooManyAttempts\":\"Too many attempts - wait {wait} and try again.\",\"waitFew\":\"a few minutes\",\"waitMinutes\":\"{n} minutes\",\"waitSeconds\":\"{n} seconds\",\"missingEmail\":\"Missing email.\"}},\"rolePicker\":{\"title\":\"Create your account\",\"subtitle\":\"First, who are you here as?\",\"creatorTitle\":\"I'm a creator\",\"creatorDesc\":\"Get paid to create LinkedIn content for B2B brands you actually use.\",\"brandTitle\":\"I'm a brand\",\"brandDesc\":\"Find creators, launch campaigns, and trace real pipeline back to each post.\",\"haveAccount\":\"Already have an account?\",\"signIn\":\"Sign in\",\"rightTitle\":\"One platform. Two sides.\",\"rightBody\":\"Creators get paid to post. B2B brands get real pipeline. Pick where you fit and we'll set the rest up in a couple of minutes.\"},\"billingForm\":{\"country\":\"Registration country\",\"hasRegisteredBusiness\":\"Do you have a registered business?\",\"entityType\":\"Legal status\",\"select\":\"Select\",\"legalName\":\"Legal name\",\"legalNamePh\":\"Full name or company name\",\"tradeName\":\"Trade name\",\"optionalBadge\":\"optional\",\"tradeNamePh\":\"Business name\",\"formatError\":\"The format looks incorrect.\",\"taxQManual\":\"Are you registered for a local consumption tax?\",\"taxQ\":\"Are you registered for {taxLabel}?\",\"yes\":\"Yes\",\"no\":\"No\",\"noFranchise\":\"No / franchise regime\",\"dontKnow\":\"I don't know\",\"taxHelp\":\"This lets Naano generate the self-billed invoice with the correct {taxLabel} treatment.\",\"taxNumber\":\"Tax number\",\"euVatLabel\":\"EU VAT\",\"euVatNumber\":\"EU VAT number\",\"taxTreatment\":\"Tax treatment\",\"address\":\"Legal address\",\"addressPh\":\"Full billing address\",\"blockedFranceTitle\":\"A registered status is required in France\",\"blockedFranceBody\":\"You need a valid SIRET to invoice through Naano. Select Yes once your status has been created.\",\"blockedEuTitle\":\"A professional tax identifier is required in the EU\",\"blockedEuBody\":\"EU creators must provide a TIN for DAC7 reporting. Select Yes once your status has been created.\",\"taxResponsibility\":\"I confirm that I am solely responsible for declaring and paying taxes on this income to the tax authorities in my country.\",\"mandate\":\"I authorize Naano to issue invoices in my name and on my behalf for services delivered through the platform.\",\"certify\":\"I certify that I am legally allowed to provide paid services in my country and that I am responsible for my tax and social obligations.\",\"certifyBusiness\":\"I certify that I am legally allowed to provide paid services in my country and that I am responsible for my tax and social obligations.\",\"certifyIndividual\":\"I certify that I am legally allowed to provide paid services in my country and that the information provided here is complete and accurate.\",\"defaultTaxLabel\":\"tax\",\"tNumberAdded\":\"The number will be added to the self-billed invoice.\",\"tApplicable\":\"{label} applicable. The number will be added to the self-billed invoice after verification.\",\"tNoneFranchise\":\"No {label} added. A franchise or non-liability mention will be used.\",\"tNoneAdded\":\"No {label} added on the self-billed invoice.\",\"tUnknown\":\"No number added. You can complete it later in your settings.\",\"tWaiting\":\"Waiting for your answer\",\"loading\":\"Loading…\",\"save\":\"Save my information\",\"saving\":\"Saving…\",\"saveFailed\":\"Save failed\",\"networkError\":\"Network error\",\"completeBeforeSave\":\"Complete the following: {fields}.\",\"requiredTaxAnswer\":\"tax registration question\",\"requiredTaxResponsibility\":\"tax responsibility confirmation\",\"requiredMandate\":\"self-billing mandate\",\"requiredCertification\":\"certification\"},\"companyId\":{\"default\":{\"label\":\"Company registration number\",\"example\":\"12345678\"},\"FR\":{\"label\":\"SIRET\",\"example\":\"732 829 320 00074\"},\"BE\":{\"label\":\"Numéro BCE/KBO\",\"example\":\"0123.456.789\"},\"DE\":{\"label\":\"Handelsregisternummer\",\"example\":\"HRB 12345\"},\"NL\":{\"label\":\"KvK-nummer\",\"example\":\"12345678\"},\"GB\":{\"label\":\"Company number (Companies House)\",\"example\":\"01234567\"},\"US\":{\"label\":\"EIN\",\"example\":\"12-3456789\"},\"CA\":{\"label\":\"Business Number (BN)\",\"example\":\"123456789RC0001\"},\"ES\":{\"label\":\"NIF\",\"example\":\"B12345678\"},\"IT\":{\"label\":\"Partita IVA\",\"example\":\"12345678901\"},\"PT\":{\"label\":\"NIPC\",\"example\":\"501234567\"},\"CH\":{\"label\":\"IDE/UID\",\"example\":\"CHE-123.456.789\"},\"LU\":{\"label\":\"Numéro RCS\",\"example\":\"B123456\"},\"IE\":{\"label\":\"CRO number\",\"example\":\"123456\"},\"SE\":{\"label\":\"Organisationsnummer\",\"example\":\"556677-8899\"},\"DK\":{\"label\":\"CVR\",\"example\":\"12345678\"},\"PL\":{\"label\":\"NIP\",\"example\":\"1234567890\"},\"AT\":{\"label\":\"Firmenbuchnummer\",\"example\":\"FN 123456a\"}},\"landing\":{\"nav\":{\"signIn\":\"Sign in\",\"signUp\":\"Sign up\",\"startEarning\":\"Start earning\",\"forCompanies\":\"For companies\",\"imACreator\":\"I'm a creator\",\"howItWorks\":\"How it works\",\"pricing\":\"Pricing\",\"blog\":\"Blog\",\"yourRate\":\"Your rate\",\"earnings\":\"Earnings\",\"menu\":\"Menu\",\"resources\":\"Resources\",\"freeTools\":\"Free Tools\",\"reports\":\"Reports\",\"caseStudyBlogseo\":\"Case study: BlogSEO\"},\"brand\":{\"heroBadge\":\"Where B2B brands work with creators\",\"heroTitleLine1\":\"The B2B LinkedIn\",\"heroTitleLine2\":\"Creator Marketplace\",\"heroSubtitle\":\"Find the creators your buyers already trust, launch campaigns in days, and track the clicks, leads and pipeline generated by every post.\",\"heroCta\":\"Launch a campaign\",\"heroSecondary\":\"See how Naano works\",\"heroTrust\":\"Trusted by modern B2B teams\",\"caseStudy\":\"CASE STUDY\",\"quoteWords\":\"We|manage|€10M+|of|influence|budget|every|year.|For|B2B,|Naano|simply|makes|our|life|easier\",\"quoteAuthor\":\"David Zmirov\",\"quoteRole\":\"CEO, Zmirov Communication\",\"quoteAgency\":\"Influence agency\",\"howTitle\":\"How it works\",\"howSubtitle\":\"From sourcing creators to paying them, the whole campaign in one place.\",\"howCard1Title\":\"Source creators\",\"howCard1Text\":\"Find the creators your buyers already trust.\",\"howCard1Match\":\"Matched\",\"howCard1Followers\":\"Followers\",\"howCard1Impressions\":\"impressions\",\"howCard1Fit\":\"fit\",\"howCard2Title\":\"Launch your brief\",\"howCard2Text\":\"Create a campaign brief in minutes, with AI or done-for-you support.\",\"howCard2Goal\":\"Goal\",\"howCard2GoalVal\":\"Generate demo requests\",\"howCard2Audience\":\"Audience\",\"howCard2AudienceVal\":\"B2B SaaS founders \u0026 operators\",\"howCard2Cta\":\"CTA\",\"howCard2CtaVal\":\"Book a demo\",\"howCard2Lp\":\"Landing page\",\"howCard2ChatUser\":\"I'd like to make a brief to target B2B SaaS founders\",\"howCard2ChatAi\":\"I'll make your brief and choose the right creators.\",\"howCard3Title\":\"Measure exact results \u0026 leads\",\"howCard3Text\":\"Track every click, identify the companies behind the traffic, and attribute leads back to each post.\",\"howCard3Clicks\":\"Qualified clicks\",\"howCard3Leads\":\"Leads\",\"howCard3Pipeline\":\"Pipeline\",\"howCard3Delta\":\"↑ {pct}% vs last 30 days\",\"howCard3More\":\"+ 18 more\",\"howCard4Title\":\"Automatic payouts\",\"howCard4Text\":\"Creators get paid automatically once campaigns go live, without messy manual ops.\",\"howCard4PostLive\":\"Post live\",\"howCard4Validated\":\"Validated\",\"howCard4PayoutScheduled\":\"Payout scheduled\",\"howCard4Creator\":\"Creator\",\"howCard4Amount\":\"Amount\",\"howCard4Status\":\"Status\",\"howCard4Scheduled\":\"Scheduled\",\"howCard4Paid\":\"Paid\",\"howCard4PaidQuarter\":\"Paid out this quarter\",\"howCard4OnTime\":\"On-time payouts\",\"testimonialsTitle\":\"Real teams. Measurable pipeline.\",\"testimonialsSubtitle\":\"See how B2B teams turn creator trust into attributable demand with Naano.\",\"videoTestimonial\":\"VIDEO TESTIMONIAL\",\"playVideoAria\":\"Play the BlogSEO video testimonial\",\"vincentQuote\":\"“Naano became one of our fastest acquisition channels. We know exactly what every creator brings.”\",\"vincentRole\":\"CEO \u0026 Founder, BlogSEO\",\"caseStudyTitle\":\"How BlogSEO turned creator content into product signups\",\"caseStudyBody\":\"BlogSEO briefed SEO \u0026 SaaS creators on LinkedIn and X, then traced every trial back to the post that drove it, all in Naano.\",\"creatorsActivated\":\"creators activated\",\"qualifiedClicks\":\"qualified clicks\",\"trialsStarted\":\"trials started\",\"readCaseStudy\":\"Read case study\",\"trustedByTeams\":\"TRUSTED BY TEAMS AT\",\"resultsEyebrow\":\"THE RESULTS\",\"resultsStatImpressions\":\"Impressions generated\",\"resultsStatLeads\":\"Leads generated\",\"resultsStatCreators\":\"Creators on Naano\",\"resultsStatPosts\":\"Posts published\",\"resultsTitle\":\"Proven across\",\"resultsTitleEm\":\"thousands of campaigns.\",\"resultsFor\":\"For\",\"resultsViewPost\":\"View post\",\"resultsImpressions\":\"Impressions\",\"resultsClicks\":\"Clicks\",\"resultsLeads\":\"Leads\",\"resultsGetStarted\":\"Get started\",\"resultsStartFree\":\"Start free. Pay per post when you're ready.\",\"creatorMeta\":\"Creator · {niche} · {followers} followers\",\"pricingTitle\":\"Pricing\",\"pricingLead\":\"Start free. Upgrade when you want your time back.\",\"pricingSub\":\"Choose whether you want to run creator campaigns in-house or have Naano operate them.\",\"pricingSelfServe\":\"SELF-SERVE\",\"pricingSelfTitle\":\"Run it yourself.\",\"pricingSelfBody\":\"For teams that want the infrastructure to run creator campaigns in-house.\",\"pricingPerMonth\":\"/ month\",\"pricingSelfF1\":\"Creator marketplace access\",\"pricingSelfF2\":\"AI-powered brief creation\",\"pricingSelfF3\":\"Track clicks, companies and pipeline\",\"pricingSelfF4\":\"Automatic creator payouts\",\"pricingStartFree\":\"Start for free\",\"pricingManaged\":\"MANAGED CAMPAIGNS\",\"pricingManagedTitle\":\"Get your time back.\",\"pricingManagedBody\":\"For teams that want Naano to operate their creator channel end to end.\",\"pricingManagedF1\":\"Campaign strategy and positioning\",\"pricingManagedF2\":\"Creator sourcing and coordination\",\"pricingManagedF3\":\"Brief creation and campaign launch\",\"pricingManagedF4\":\"Reporting and optimisation\",\"pricingBookCall\":\"Book a campaign call\",\"pricingFootnote\":\"Campaign spend is separate. No lock-in. Cancel anytime.\",\"faqTitle\":\"Frequently asked questions\",\"faqSubtitle\":\"Everything you need to know before getting started.\",\"faqStill\":\"Still have questions?\",\"faqTalk\":\"Talk to our team\",\"faq\":{\"q0\":\"What is Naano?\",\"a0\":\"Naano is a B2B LinkedIn creator marketplace: companies discover and book vetted creators for sponsored LinkedIn campaigns, each at a fixed price per post set by the creator. The marketplace spans creators from niche voices with around 1,000 followers to established B2B creators with audiences of several hundred thousand.\",\"q1\":\"How does Naano find the right creators?\",\"a1\":\"Our matching engine scores every creator on audience fit, category relevance and engagement quality across LinkedIn, X and YouTube, so you rank creators by who actually reaches your buyers, not by follower count.\",\"q2\":\"Which networks do you support?\",\"a2\":\"LinkedIn, X and YouTube today, with more on the way. You can compare creators and track performance across every network in one place.\",\"q3\":\"How does per-post pricing work?\",\"a3\":\"Campaigns start from €20 per published post, you only pay for posts that go live, with no retainer. Prefer a hands-off setup? Done for you adds our team executing everything end to end.\",\"q4\":\"How does attribution work?\",\"a4\":\"Naano places a tracking pixel at every stage of the funnel, so each click, lead, pipeline and revenue is tied back to the exact creator and post that drove it.\",\"q5\":\"Do you handle creator payouts?\",\"a5\":\"Yes. Approve content and pay every creator in one click, securely via Stripe Connect, invoices and approvals are handled for you.\",\"q6\":\"What's the difference between Free and Done for you?\",\"a6\":\"Free gives your team the platform to source creators and run simple campaigns yourselves. Done for you adds hands-on execution by the Naano team, sourcing, briefs, reporting and optimisation.\",\"q7\":\"Can I upgrade or cancel anytime?\",\"a7\":\"Absolutely. Plans are month-to-month, you can upgrade, downgrade or cancel whenever you like.\"},\"bookEyebrow\":\"READY TO LAUNCH?\",\"bookTitle\":\"Your next creator campaign starts here.\",\"bookSubtitle\":\"Get a clear creator strategy, campaign format and estimated budget for your next launch.\",\"bookCardEyebrow\":\"CAMPAIGN STRATEGY CALL\",\"bookCardTitle\":\"30-minute working session\",\"bookCardBody\":\"Leave with a concrete plan for your next creator campaign.\",\"bookF1\":\"Creator strategy\",\"bookF2\":\"Campaign format\",\"bookF3\":\"Budget recommendation\",\"bookCta\":\"Book a campaign call\",\"bookPickTime\":\"Pick a time on the next page.\",\"bookPrefer\":\"Prefer to start yourself?\",\"bookStartFree\":\"Start for free →\",\"bookTrusted\":\"Trusted by B2B teams building creator-led acquisition.\",\"howCard1Matched\":\"Matched\",\"howCard1AvgImpressions\":\"Avg. impressions\",\"howCard1AudienceFit\":\"Audience fit\",\"howChipFounder\":\"Founder audience\",\"howChipRegion\":\"Region\",\"howChipMarketing\":\"Marketing\",\"howCard2BriefPreview\":\"Brief preview\",\"howCard2Ready\":\"Ready\",\"howCard3Companies\":\"Identified companies\",\"howCard3CompaniesCount\":\"23 companies\",\"howCard3Delta24\":\"↑ 24% vs last 30 days\",\"howCard3Delta28\":\"↑ 28% vs last 30 days\",\"howCard3Delta31\":\"↑ 31% vs last 30 days\",\"howCard4Date1\":\"May 20\",\"howCard4Date2\":\"May 21\",\"howCard4Date3\":\"May 22\",\"roles\":{\"r1\":\"SaaS Founder\",\"r2\":\"Growth Advisor\",\"r3\":\"B2B Marketer\",\"r4\":\"Product Leader\",\"r5\":\"SaaS Investor\",\"r6\":\"Sales Advisor\"},\"postMeta1\":\"Creator · B2B \u0026 AI · 34K followers\",\"postMeta2\":\"Creator · Sales \u0026 AI · 12K followers\",\"postMeta3\":\"Sales Leader · B2B · 40K followers\",\"postMeta4\":\"Content Creator · B2B · 34K followers\",\"postBody4\":\"How I build my 30-day LinkedIn content system, the exact playbook.\"},\"creator\":{\"heroTitle\":\"Get paid to post about brands your audience already loves.\",\"heroSubtitle\":\"Choose deals from B2B brands you know, post in your own voice, and get paid within 24h. No negotiating, no admin. Creators earn\",\"heroCta\":\"Start earning\",\"heroSecondary\":\"See how it works\",\"monetizeTitle\":\"Get sponsored by our network\",\"monetizeSubtitle\":\"Set your rate, pick deals that fit, and get paid when the post goes live.\",\"platformTitle\":\"Everything you need in one dashboard\",\"platformSubtitle\":\"For creators who don't want to chase invoices or miss opportunities.\",\"platformF1Title\":\"Centralized opportunities\",\"platformF1Body\":\"Discover brand deals that match your audience.\",\"platformF2Title\":\"Payments built-in\",\"platformF2Body\":\"Get paid on time with secure, transparent payouts.\",\"platformF3Title\":\"Track performance\",\"platformF3Body\":\"See views, clicks and engagement in real time.\",\"platformF4Title\":\"Easy delivery\",\"platformF4Body\":\"Manage deals and deliver content with ease.\",\"platformDash\":\"Naano creator dashboard\",\"quoteWords\":\"I|was|able|to|select|my|rate|and|get|paid|the|moment|the|post|went|live\",\"resultsEyebrow\":\"THE RESULTS\",\"resultsCreators\":\"Creators earning\",\"resultsAvg\":\"Avg. per deal\",\"resultsPosts\":\"Posts published\",\"resultsPayout\":\"Avg. payout time\",\"reviewsTitle\":\"What creators say\",\"reviewsEyebrow\":\"REVIEWS\",\"faqTitle\":\"Frequently asked questions\",\"faqSubtitle\":\"Everything creators ask before joining.\",\"ctaTitle\":\"Ready to get paid for your content?\",\"ctaBody\":\"Apply in 2 minutes. Free forever. Keep 100% of what you earn.\",\"ctaButton\":\"Get started\",\"ctaChip1\":\"2,000+ creators paid\",\"ctaChip2\":\"Paid within 24h\",\"ctaChip3\":\"Quit anytime, keep your earnings\",\"footerTagline\":\"Turn your LinkedIn audience into a paid channel.\",\"faq\":{\"q0\":\"What is Naano?\",\"a0\":\"Naano is the B2B LinkedIn creator marketplace: B2B brands book creators for sponsored LinkedIn posts at a fixed price per post that you set. Creators from about 1,000 to 500,000 followers use Naano to monetize their LinkedIn audience with deals from B2B brands they already know.\",\"q1\":\"Is Naano free for creators?\",\"a1\":\"Yes, always. Joining and using Naano is completely free, and you keep 100% of what you earn on every deal.\",\"q2\":\"How much can I earn?\",\"a2\":\"Creators earn on average €500 per deal, with top deals reaching €1,500. You choose which deals to take, so your earnings scale with how much you post.\",\"q3\":\"How and when do I get paid?\",\"a3\":\"You get paid within 24h of your post going live, securely via Stripe or bank transfer. No invoicing, no chasing, it happens automatically.\",\"q4\":\"Do I have to sign an exclusivity contract?\",\"a4\":\"No. There is no exclusivity, no minimum and no lock-in. You pick the deals you want and quit anytime while keeping everything you have earned.\",\"q5\":\"What kind of brands are on Naano?\",\"a5\":\"B2B brands you already know: SaaS, sales, marketing and prospecting tools like Lemlist, Folk, Ringover and Gojiberry, plus 20+ more, with new deals every week.\",\"q6\":\"Do I keep control of my content?\",\"a6\":\"Completely. You post in your own voice. Each brief gives you an angle, a hook and a CTA plus full product access, but the words are always yours.\",\"q7\":\"How do I join?\",\"a7\":\"Apply in about 2 minutes, no commitment. Once approved you can browse open deals and start earning right away.\"},\"heroBadge\":\"2,000+ creators paid · 4.8/5 rating\",\"heroTitleBefore\":\"Get paid to post on\",\"heroTitleOn\":\"\",\"heroSubtitleHighlight\":\"€500 on average per deal\",\"heroShield\":\"Free to join · No exclusivity · Paid within 24h\",\"brandsOnNaano\":\"THE BRANDS ALREADY ON NAANO\",\"faqSubtitleFull\":\"Everything you need to know before you start earning.\",\"ctaEyebrow\":\"READY TO EARN?\",\"ctaTitle1\":\"You've seen how it works.\",\"ctaTitle2\":\"Now get paid for it.\",\"ctaBodyFull\":\"Join 2,000+ creators already getting paid to post on LinkedIn. It's free, and you keep 100% of what you earn.\",\"ctaApply\":\"Apply now\",\"ctaTakes\":\"Takes 2 minutes. No commitment.\",\"reviewRoles\":{\"r1\":\"B2B creator · 18K followers\",\"r2\":\"Content creator · 9K followers\",\"r3\":\"Sales creator · 14K followers\",\"r4\":\"B2B \u0026 AI creator · 34K followers\",\"r5\":\"LinkedIn creator · 40K followers\",\"r6\":\"Marketing creator · 11K followers\"},\"reviews\":{\"t1\":\"Naano is the marketplace LinkedIn was missing. The founders truly listen and do everything they can to build something that brings real value to its users.\",\"t2\":\"At first I wasn't sure what to expect. But the whole experience was simple and smooth: clear opportunities, an easy platform, everything well guided. A real bridge between creators and brands.\",\"t3\":\"Excellent experience. The platform is simple and efficient, the team ultra-responsive, and results come fast. I recommend it whether you want to grow your name or create content.\",\"t4\":\"Great experience, I love the platform, it helps me every day. I already made money with it from day one.\",\"t5\":\"Naano lets me keep making useful content while monetizing my LinkedIn community. We never give up!\",\"t6\":\"A young team that's ambitious, efficient and driven. Super proactive and always listening. I'd tell every creator to join Naano!\"},\"statCreators\":\"Creators\",\"statTopDeal\":\"Top deal\",\"monetizeSectionTitle\":\"Get sponsored\",\"monetizeH2\":\"Monetize your content on Naano\",\"monetizeP\":\"Accept deals from brands you know, or bring your own onto the platform and get paid faster.\",\"platformEyebrow\":\"THE PLATFORM\",\"platformH2Line1\":\"For creators who don't want\",\"platformH2Line2\":\"the administrative burden.\",\"platformSub\":\"Find deals, get paid, and track your performance from one dashboard. No invoicing, no chasing, no spreadsheets.\",\"resultsRealPosts\":\"Real posts from real creators\",\"resultsCta\":\"Start earning\",\"resultsFoot\":\"Free to join. Paid within 24h. Quit anytime.\",\"reviewsEyebrowCommunity\":\"FROM THE COMMUNITY\",\"reviewsSub\":\"2,000+ creators already getting paid on Naano.\",\"quoteRole\":\