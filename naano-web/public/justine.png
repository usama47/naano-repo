\":\"Top creators this week\",\"topCreatorsDesc\":\"The most active creators of the last 7 days\",\"clickCount\":\"{count, plural, one {# click} other {# clicks}}\",\"urgentBannerPrefix\":\"Your collaboration with\",\"urgentBannerMiddle\":\"is ready! You can earn\",\"marketplaceFirstTimeBanner\":\"Choose a company and click Apply. If the brand does not respond within 5 days, the application is automatically declined.\",\"dismiss\":\"Dismiss\",\"recommended\":\"Recommended\",\"applicationSentTitle\":\"Application sent - Reply within 5 days\",\"applicationReply48h\":\"We'll notify you when the brand responds. If it does not respond within 5 days, the application is automatically declined.\",\"appliedOn\":\"Applied on {date}\",\"saasOverview\":{\"clickBalance\":\"Click balance\",\"clicksPerMonth\":\"{total} clicks/month\",\"recharge\":\"Recharge\",\"clicksThisMonth\":\"Clicks this month\",\"bulk\":\"bulk\",\"qualified\":\"qualified\",\"noClicksYet\":\"No clicks yet this month\",\"qualificationRate\":\"Qualification rate:\",\"active\":\"active\",\"activeCreators\":\"{n} active creators\",\"pending\":\"pending\",\"archived\":\"archived\",\"pendingApps\":\"Pending applications\",\"viewAll\":\"View all\",\"noPendingApps\":\"No pending applications yet.\",\"browseMarketplace\":\"Browse marketplace\",\"recommendedCreators\":\"Recommended creators\",\"noRecommendations\":\"No recommendations available.\",\"marketplaceBanner\":\"Browse the marketplace to bring more creators to your campaigns\",\"browse\":\"Browse\",\"activeCollabs\":\"Active collaborations\",\"manage\":\"Manage\",\"totalLabel\":\"total\",\"qualifiedLabel\":\"qualified\",\"tracking\":\"Tracking\",\"noActiveCollabs\":\"No active collaborations yet.\",\"recentLeads\":\"Recent leads\",\"fullAnalytics\":\"Full analytics\",\"noLeads\":\"No qualified leads yet.\",\"unknown\":\"Unknown\",\"followers\":\"followers\",\"youHave\":\"You have\",\"pendingAppsAlert\":\"pending applications waiting for review.\",\"pendingApps