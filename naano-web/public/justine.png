sc\":\"Filtered: bots, IP duplicates per hour\",\"conversionsLeads\":\"Conversions / Leads\",\"totalNaanoCost\":\"Total Naano Cost\",\"savingsVsLinkedIn\":\"Savings vs LinkedIn Ads\",\"savingsFormula\":\"(Qualified Clicks × €8) - Naano cost\",\"note\":\"Note:\",\"noteQualifiedClicks\":\"Qualified Clicks are automatically filtered to exclude bots and IP duplicates (one click per IP per hour). Geographic data is collected automatically for analysis (not used for filtering).\"},\"postsTab\":{\"submitLinkedInPost\":\"Submit a LinkedIn post\",\"budgetExhausted\":\"Budget exhausted\",\"budgetExhaustedDesc\":\"SaaS budget is exhausted. Posts cannot be submitted until the budget is renewed.\",\"limitReached\":\"Limit reached ({current}/{max} posts)\",\"limitReachedDesc\":\"You have reached the limit of {limit} posts total (all collaborations combined).\",\"postsTotal\":\"{current}/{max} posts total\",\"postsCount\":\"Posts ({count})\",\"noPostCreator\":\"No post submitted. Share your first LinkedIn post!\",\"noPostSaas\":\"The creator hasn't submitted a post yet.\"},\"brandSelector\":{\"label\":\"Link Destination\",\"desc\":\"Choose which page you want to promote with your tracking link.\",\"defaultWebsite\":\"Default website\",\"url\":\"URL\",\"errorUpdate\":\"Error updating destination\",\"networkError\":\"Network error\"},\"resourcePicker\":{\"title\":\"Choose your link\",\"description\":\"Pick the resource you want to promote. Your tracked link will point to it.\",\"yourLink\":\"Your tracked link\",\"copy\":\"Copy\",\"copied\":\"Copied!\",\"generating\":\"Generating your link...\",\"suggestLink\":\"Suggest a link\",\"suggestTitle\":\"Suggest a link\",\"suggestNamePlaceholder\":\"Label (e.g. Blog post, Case study)\",\"suggestNotePlaceholder\":\"Why this link? (optional)\",\"suggestSubmit\":\"Submit suggestion\",\"proposalSent\":\"Your suggestion has been sent for approval. You can continue using existing resources while waiting.\",\"qualifiedClicks\":\"Qualified clicks\",\"earned\":\"Earned\",\"typeLeadMagnet\":\"Lead magnet\",\"typeFreeTrial\":\"Free trial\",\"typeLanding\":\"Landing page\",\"typeProductPage\":\"Product page\",\"typeBlogArticle\":\"Blog article\",\"typeCaseStudy\":\"Case study\",\"typeWebinar\":\"Webinar\",\"typeDemo\":\"Demo\",\"typeNewsletter\":\"Newsletter\",\"typeOther\":\"Other\",\"typeWebsite\":\"Website\",\"typeTool\":\"Tool\",\"typeGuide\":\"Guide\"},\"leadFeedDetail\":{\"dataProbabilistic\":\"Data is probabilistic before signup, confirmed after.\",\"enrichedVisitors\":\"Enriched visitors with company intelligence and intent scoring.\",\"sortBy\":\"Sort by\",\"sortCompanyIntent\":\"Company intent (recommended)\",\"sortIntent\":\"Session intent\",\"sortConfidence\":\"Confidence\",\"sortDate\":\"Date\",\"showConfirmedOnly\":\"Show confirmed only\",\"highConfidenceOnly\":\"High confidence only (≥70%)\",\"possible\":\"Possible\",\"probable\":\"Probable\",\"mismatch\":\"Mismatch\",\"unknownCompany\":\"Unknown company\",\"identifiedAgo\":\"Identified {days} ago • Effective confidence: {confidence}\",\"industry\":\"Industry\",\"size\":\"Size\",\"location\":\"Location\",\"confidence\":\"Confidence\",\"confidenceReasons\":\"Confidence reasons\",\"decay\":\"decay\",\"sessionIntelligence\":\"Session intelligence\",\"country\":\"Country\",\"city\":\"City\",\"ip\":\"IP\",\"device\":\"Device\",\"browser\":\"Browser\",\"network\":\"Network\",\"timeOnSite\":\"Time on site\",\"source\":\"Source\",\"unknown\":\"Unknown\",\"intentSignals\":\"Intent signals (session)\",\"repeatVisit\":\"Repeat visit ({count}x)\",\"pricingPage\":\"Pricing page\",\"securityPage\":\"Security page\",\"integrationsPage\":\"Integrations page\",\"recencyWeight\":\"Recency weight\",\"companyIntentAggregated\":\"Company intent (aggregated)\",\"avgScore\":\"Avg score\",\"maxScore\":\"Max score\",\"trend\":\"Trend\",\"trendIncreasing\":\"↑ Increasing\",\"trendDecreasing\":\"↓ Decreasing\",\"trendStable\":\"→ Stable\",\"repeatVisits\":\"Repeat visits\",\"creator\":\"Creator\",\"companyIntent\":\"Company intent\",\"companyIntentTooltip\":\"Aggregated intent score at company level (more reliable than individual session)\",\"sessionIntent\":\"Session intent\",\"sessionIntentTooltip\":\"Intent score based on engagement, referrer quality, and behavioral signals. Higher = more likely to convert.\",\"sessions\":\"session\",\"sessionsPlural\":\"sessions\",\"onlyCompanyClicks\":\"Only clicks with company identification are shown here.\"},\"affiliates\":{\"title\":\"Affiliates (referrers)\",\"subtitle\":\"Referrer codes and commission report (6 months per entity, manual payment).\",\"codesTitle\":\"Referrer codes\",\"code\":\"Code\",\"name\":\"Name\",\"referrerName\":\"Referrer name\",\"referrerLink\":\"Referrer link\",\"copyLink\":\"Copy\",\"copied\":\"Copied!\",\"createdAt\":\"Created at\",\"noCodes\":\"No codes. Create one below.\",\"codeStoredUppercase\":\"Code (stored in uppercase)\",\"create\":\"Create\",\"reportTitle\":\"Commission report\",\"reportNote\":\"Payouts are calculated monthly; only transactions within the 6-month window after attribution are included.\",\"month\":\"Month\",\"filterByCode\":\"Filter by code\",\"optional\":\"Optional\",\"apply\":\"Apply\",\"exportCsv\":\"Export CSV\",\"creatorsCount\":\"# Creators\",\"companiesCount\":\"# Companies\",\"creatorEarnings\":\"Creator earnings (6mo)\",\"companyCredits\":\"Company clicks (6mo)\",\"commission\":\"Commission 10%\",\"noData\":\"No data for this month / filter.\"},\"inviteCreators\":{\"title\":\"Invite Creators\",\"subtitle\":\"Invite people who use your product to review your paid creator opportunities on Naano.\",\"headerKicker\":\"INVITE CREATORS\",\"headerTitle\":\"Turn your users into \u003caccent\u003epaid distribution\u003c/accent\u003e.\",\"headerSubtitle\":\"On Naano, creators get paid for clicks, not posts.\",\"headerStatInvitedLabel\":\"Creators invited\",\"headerStatSignedUpLabel\":\"Creators joined\",\"howItWorksTitle\":\"How it works\",\"howItWorksSubtitle\":\"From invitation to a published collaboration.\",\"howStep1Label\":\"Invite\",\"howStep1Body\":\"Invite relevant creators from your network.\",\"howStep2Label\":\"They share\",\"howStep2Body\":\"They talk about your product and share their tracked link.\",\"howStep3Label\":\"Qualified clicks\",\"howStep3Body\":\"Their audience clicks. We only count qualified clicks.\",\"howStep4Label\":\"Everyone wins\",\"howStep4Body\":\"Creators get paid. You get the clicks. We send you a bonus.\",\"winLoopKicker\":\"WIN · WIN · WIN\",\"winLoopTitle\":\"One post published, three winners.\",\"winLoopSubtitle\":\"Every time an invited creator publishes a post, the loop closes: they earn, you get qualified clicks + a bonus, their audience gets a real recommendation.\",\"winSaasLabel\":\"You\",\"winSaasValue\":\"+€29\",\"winSaasUnit\":\"in credits per creator who posts for you\",\"winSaasBody\":\"No sneaky signups: the bonus only triggers when the creator actually posts. Reinvest straight into your next campaigns.\",\"winSaasBadge\":\"YOUR BONUS\",\"winCreatorLabel\":\"Your creators\",\"winCreatorValue\":\"€1.10\",\"winCreatorUnit\":\"per qualified click\",\"winCreatorBody\":\"The creator sees the compensation terms before accepting the collaboration.\",\"winAudienceLabel\":\"Their audience\",\"winAudienceValue\":\"Disclosed\",\"winAudienceUnit\":\"paid partnership\",\"winAudienceBody\":\"Creators publish in their own voice with the required commercial disclosure.\",\"inviteStepsTitle\":\"Invite in 2 simple steps\",\"inviteStep1Label\":\"Add your creators\",\"inviteStep1Body\":\"Type emails or import a CSV to invite multiple people at once.\",\"inviteStep2Label\":\"Preview and send\",\"inviteStep2Body\":\"Check the email before sending. We handle deliverability and follow-ups.\",\"thatsItTitle\":\"That's it!\",\"thatsItBody\":\"We'll send the invites. Recipients can create a profile and review the campaign terms before they apply.\",\"statSent\":\"Total Sent\",\"statSignedUp\":\"Signed Up\",\"statBonusCredits\":\"Bonus Earned\",\"statBonusCreditsHint\":\"to reinvest in campaigns\",\"inviteByEmail\":\"Invite by Email\",\"emailPlaceholder\":\"Enter email addresses (comma or newline separated)\\ne.g. john@example.com, jane@example.com\",\"orUploadCSV\":\"or upload a CSV file\",\"dropCSV\":\"Drop a CSV file here or click to browse\",\"maxEmails\":\"Max 500 emails per upload\",\"csvFound\":\"{count} valid emails found\",\"previewEmail\":\"Preview Email\",\"sendInvites\":\"Send Invites ({count})\",\"sending\":\"Sending...\",\"resultSent\":\"{count} invites sent successfully.\",\"resultDuplicates\":\"{count} already invited.\",\"resultSkipped\":\"{count} already on Naano.\",\"resultRateLimited\":\"You've sent a lot of invites in a short time. Please try again later.\",\"shareTemplates\":\"Share Templates\",\"shareTemplatesIntro\":\"No email list? Share one of these messages. People who already use {companyName} can follow your invite link, create a Naano profile, and review the campaign terms before applying.\",\"yourInviteLink\":\"Your invite link\",\"copy\":\"Copy\",\"copied\":\"Copied!\",\"templateLinkedinCompany\":\"LinkedIn post - your company page\",\"templateLinkedinCompanyDescription\":\"Post this from your {companyName} LinkedIn page. Your followers and customers will see it in their feed.\",\"templateLinkedinCompanyText\":\"We're opening paid LinkedIn creator opportunities for people who use {companyName}.\\n\\nWe want useful content grounded in real product experience, not a script.\\n\\nWith Naano, eligible creators can review the brief, compensation, and tracking terms before they apply. If accepted, they write in their own voice and publish with the required disclosure and tracked link.\\n\\nIf you use {companyName} and want to see the current opportunity:\\n\\n{inviteLink}\",\"templateLinkedinPersonal\":\"LinkedIn post - your personal profile\",\"templateLinkedinPersonalDescription\":\"Post this from a founder, marketing, or customer-success profile.\",\"templateLinkedinPersonalText\":\"We're inviting people who genuinely use {companyName} to review our paid LinkedIn creator opportunities on Naano.\\n\\nEach opportunity shows the brief, compensation, and tracking terms before a creator applies. Accepted creators keep their own voice and publish with the required disclosure and tracked link.\\n\\nIf you use {companyName} and want to see whether the current campaign fits your experience:\\n\\n{inviteLink}\",\"templateEmail\":\"Email - to your existing users\",\"templateEmailDescription\":\"Send this to customers who already use {companyName}. They're the people most likely to write a great post about it.\",\"templateEmailText\":\"Subject: A paid LinkedIn creator opportunity from {companyName}\\n\\nHi,\\n\\nWe're inviting people who use {companyName} to review our current creator opportunities on Naano.\\n\\nBefore applying, you can see the brief, compensation, tracking requirements, and eligibility criteria. If a campaign fits your experience and your application is accepted, you create the post in your own voice and publish it with the required disclosure and tracked link.\\n\\nReview the current opportunity here:\\n{inviteLink}\\n\\n- The {companyName} team\",\"templateNewsletter\":\"Newsletter - paragraph to drop in\",\"templateNewsletterDescription\":\"Add this as a P.S. or short section to your next newsletter to existing users.\",\"templateNewsletterText\":\"P.S. We publish paid LinkedIn creator opportunities for people who use {companyName}. Review the current brief, compensation, and eligibility terms on Naano before applying → {inviteLink}\",\"templateSlack\":\"Slack / Discord - community message\",\"templateSlackDescription\":\"Drop this in your community Slack, Discord, or customer space.\",\"templateSlackText\":\"Hi everyone — we publish paid LinkedIn creator opportunities for people who use {companyName}.\\n\\nThe Naano page shows the brief, compensation, eligibility, and tracking terms before you apply. If the current campaign matches your experience, review it here: {inviteLink}\",\"yourInvitedCreators\":\"Your Invited Creators\",\"noInvitesYet\":\"No invites sent yet.\",\"colEmail\":\"Email\",\"colStatus\":\"Status\",\"colSignedUp\":\"Signed Up\",\"colCreator\":\"Creator\",\"statusSent\":\"Sent\",\"statusSignedUp\":\"Signed Up\",\"emailPreview\":\"Email Preview\"},\"briefView\":{\"backToCollab\":\"Back to collaborations\",\"activeCollab\":\"Active collab\",\"startedToday\":\"Started today\",\"startedYesterday\":\"Started yesterday\",\"startedDaysAgo\":\"Started {count, plural, one {# day} other {# days}} ago\",\"qualifiedClicksShort\":\"qualified clicks\",\"revenueEarnedShort\":\"earned\",\"openLinkedin\":\"Open LinkedIn\",\"withdraw\":\"Withdraw\",\"saasBudgetLeft\":\"left at {name}\",\"saasClicksShared\":\"Shared between all creators on this campaign\",\"whatsappCommunity\":\"Creator WhatsApp\",\"destinationPickerTitle\":\"Pick where to send traffic\",\"destinationCountBadge\":\"{count} links available\",\"destinationPickerSubtitle\":\"Each row below is a different link you can share. Pick one - your tracked link will redirect there.\",\"destinationPickerWhy\":\"Tip: pages with a lead magnet or a guide convert better than a generic website link on LinkedIn - people want to know what they're getting before they click.\",\"destinationStep1\":\"Pick a destination below\",\"destinationStep2\":\"Click \\\"Use \u0026 copy\\\" - we copy your link\",\"destinationStep3\":\"Paste it in your LinkedIn post\",\"destinationPickerIntro\":\"You have multiple tracked links - one per resource the brand wants to promote.\",\"destinationActive\":\"Active\",\"destinationUseThis\":\"Use this destination\",\"destinationUseAndCopy\":\"Use \u0026 copy\",\"destinationSwitching\":\"Switching…\",\"destinationSwitchedCopied\":\"Switched to {name} - link copied\",\"destinationPreview\":\"Preview\",\"destinationActiveBadge\":\"Sending traffic to\",\"destinationWebsiteName\":\"{name} website\",\"destinationFor\":\"For {name}\",\"destinationDefaultBadge\":\"Default\",\"destinationFooterTracking\":\"Links are tracked so you can see what drives the most visits and results.\",\"destinationFooterHelp\":\"Need help? Visit our Help Center\",\"postsAssociateLinkTitle\":\"Each post is written around a specific resource\",\"postsAssociateLinkPrompt\":\"If you copy a post about the cold-email guide, your tracked link should send people to the cold-email guide - not to the website. Pick the destination that matches the post you picked so the comment your audience sees lines up with what you wrote.\",\"postsAssociateLinkCta\":\"Choose a destination\",\"destinationSectionTitle\":\"Choose where your link sends people\",\"destinationSectionSubtitle\":\"Each option below is a real resource {name} wants you to send traffic to - a Notion doc, a PDF guide, a landing page. Read the one you pick first, write a post about your honest experience with it, then paste your tracked link in the first comment.\",\"destinationSingleTitle\":\"Your tracked link\",\"destinationWebsiteOnlySubtitle\":\"Your tracked link sends people to {name}'s website. Read up on what they do, then write a post about why you recommend them and paste your link in the first comment.\",\"destinationSingleResourceSubtitle\":\"Your tracked link sends people to one resource: {resource}. Read it first, write a post about your honest experience with it, then paste your tracked link in the first comment of your post.\",\"destinationSendsTo\":\"This link sends people to\",\"destinationPreviewResource\":\"Preview the resource\",\"resourcesTitle\":\"Resources\",\"destinationYourTrackedLink\":\"Your tracked link\",\"destinationSelectButton\":\"Select\",\"destinationCopyMyLink\":\"Copy my link\",\"destinationCopied\":\"Copied!\",\"destinationCopyToast\":\"Link copied - paste it in the first comment of your LinkedIn post\",\"destinationHowItWorksTitle\":\"How tracked links work -\",\"destinationHowItWorksBody\":\"Each link above is unique to you. Every time someone clicks it, we know it came from your post. You earn €1.10 per qualified click.\",\"activeLinkLabel\":\"Active link\",\"destinationEmptyTitle\":\"The brand hasn't added any specific resources to promote yet.\",\"destinationEmptyDesc\":\"The brand hasn't added specific resources yet - the website above is your default destination. More options will show up here as they add lead magnets or landing pages.\",\"postOnLinkedIn\":\"Post on LinkedIn\",\"statsPosts\":\"ready-to-copy posts\",\"statsAngles\":\"editorial angles\",\"statsGallery\":\"visuals to download\",\"howItWorksTitle\":\"How it works\",\"step1Title\":\"Read the brief\",\"step1Desc\":\"5 min to understand the product, the angles and the lead magnet.\",\"step2Title\":\"Write your post\",\"step2Desc\":\"Your voice, your style. Natural, like recommending a tool to a friend.\",\"step3Title\":\"Add your link\",\"step3Desc\":\"Copy your unique link below. Put it in the comments or in DMs.\",\"step4Title\":\"Publish and you're done\",\"step4Desc\":\"Every qualified click earns you money, tracked in real time.\",\"sectionContext\":\"Context\",\"sectionObjective\":\"Post objective\",\"sectionAngles\":\"Editorial angles\",\"anglesCount\":\"{count, plural, one {# angle} other {# angles}}\",\"sectionStructure\":\"Post structure\",\"fixed\":\"FIXED\",\"hookLabel\":\"Hook\",\"hookHint\":\"1–2 lines\",\"hookDesc\":\"Stop the scroll. A question, a surprising stat, a strong take or a personal anecdote.\",\"contextLabel\":\"Context / Problem\",\"contextHint\":\"2–3 lines\",\"contextDesc\":\"Pose the problem your audience knows. Show you've experienced it too.\",\"solutionLabel\":\"Solution / Discovery\",\"solutionHint\":\"3–5 lines\",\"solutionDesc\":\"Present the tool as your solution. What you do with it, results achieved, what convinced you.\",\"proofLabel\":\"Proof / Detail\",\"proofHint\":\"2–3 lines\",\"proofDesc\":\"A number, a before/after, a specific feature. Something concrete.\",\"ctaLabel\":\"CTA\",\"ctaHint\":\"1–2 lines\",\"ctaDesc\":\"\\\"Link in comments\\\" / \\\"Comment and I'll send you the link\\\" - or direct: \\\"You can try it here\\\".\",\"sectionPosts\":\"Posts that worked\",\"postsCount\":\"{count, plural, one {# post} other {# posts}}\",\"postsIntro\":\"These posts have already generated clicks for\",\"postsAction\":\"Copy, adapt to your voice, publish.\",\"postsHeroKicker\":\"Already crushing it\",\"postsHeroTitle\":\"These posts already performed great for {company}\",\"postsHeroBody\":\"Pick one, adapt it to your voice, publish. Takes 10 minutes.\",\"postsHeroMetric\":\"clicks generated\",\"postsHeroMetricFallback\":\"tested posts\",\"carouselPrev\":\"Previous\",\"carouselNext\":\"Next\",\"copyText\":\"Copy text\",\"copied\":\"Copied!\",\"copyPostToast\":\"Post copied - edit it in your voice on LinkedIn\",\"showMore\":\"Show more ↓\",\"showLess\":\"Show less ↑\",\"visual\":\"Visual\",\"partnership\":\"Partnership\",\"sectionLinks\":\"Your tracked links\",\"linksIntro\":\"Use these links in your posts. Every qualified click earns you directly.\",\"copyLink\":\"Copy link\",\"copiedLink\":\"Copied\",\"copy\":\"Copy\",\"sectionGallery\":\"Visuals to download\",\"visualsCount\":\"{count, plural, one {# visual} other {# visuals}}\",\"sectionExpected\":\"What you can expect\",\"expected1\":\"You post 1 to 2 times per week during the campaign.\",\"expected2\":\"A good post generates between 50 and 1,000 qualified clicks.\",\"expected3\":\"Every qualified click earns you money - tracked in real time on your dashboard.\",\"expected4\":\"Top Naano creators earn between €100 and €500+ per month with 1–2 posts/week.\",\"expected5\":\"If a post underperforms, no stress - we'll send you personalized feedback.\",\"sectionGuidelines\":\"Guidelines\",\"helpText\":\"Have a question? Reach us at\",\"published\":\"Published\",\"draft\":\"Draft\",\"untitled\":\"Untitled\",\"download\":\"Download\",\"comingSoonTitle\":\"Brief coming soon\",\"comingSoonDesc\":\"The brand is preparing your campaign brief. You'll be notified as soon as it's published.\",\"trackedLinkSubtitle\":\"Every qualified click = €1.10. Paste this link in the first comment after publishing.\",\"connectCta\":\"Connect LinkedIn\",\"connectToUnlock\":\"Connect your LinkedIn to unlock your tracked link and start earning.\",\"linkCopiedToast\":\"Link copied, paste it in the first comment\",\"linkCopied\":\"Link copied\",\"journeyAccepted\":\"Accepted\",\"journeyAcceptedSub\":\"Collab open\",\"journeyPublish\":\"Publish\",\"journeyPublishSub\":\"You are here\",\"journeyEarn\":\"€1.10 / click\",\"journeyEarnSub\":\"Credited automatically\",\"publishCtaTitle\":\"Publish the post\",\"publishCtaBody\":\"Copy a post, adapt it to your voice, publish on LinkedIn. Paste your tracked link in the first comment.\",\"publishCtaBodyCompany\":\"{company} will see your post in their feed.\",\"copyMyLink\":\"Copy my link\",\"questionPrompt\":\"Have a question?\",\"tipsKicker\":\"Writing tips\",\"tipsStructureTitle\":\"A post structure that converts\",\"tipsStructureIntro\":\"A 5-beat scaffold, use it as a guide, not a rule. Adapt it to your voice.\",\"copyAiTitle\":\"Create my post with AI\",\"copyAiBody\":\"Copy a clean prompt with the brief, angles and examples. Paste it into your AI; add 2 or 3 previous posts if it does not know your style yet.\",\"copyAiButton\":\"Copy for my AI\",\"copyAiDone\":\"Prompt copied!\",\"creatorBriefLabel\":\"Creator brief\",\"ctaTitle\":\"Call to action\",\"openFull\":\"Open the full brief\",\"externalTitle\":\"This brief lives on an external page\",\"externalBody\":\"{brand} shared their full brief as a link (Notion, Google Doc or a web page). It opens in a new tab.\",\"noBriefTitle\":\"No specific brief for this campaign\",\"noBriefBody\":\"{brand} has not added campaign instructions yet. Ask them in Messages what they expect from the post.\",\"copyMarkdown\":\"Copy as Markdown\",\"copyMarkdownDone\":\"Markdown copied!\",\"examplePostsTitle\":\"Example posts\",\"examplePostLabel\":\"Example\",\"showExamplePost\":\"View example\",\"hideExamplePost\":\"Hide example\"},\"onboardingGuard\":{\"redirecting\":\"Redirecting to complete your profile…\"},\"tour\":{\"section\":{\"Dashboard\":\"Dashboard\",\"Marketplace\":\"Marketplace\",\"Collaborations\":\"Collabs\",\"Communauté\":\"Community\",\"Finances\":\"Payouts\"},\"btn\":{\"next\":\"Next →\",\"finish\":\"Finish →\",\"previous\":\"← Back\",\"done\":\"Done\"},\"welcome\":{\"title\":\"Welcome to Naano{name}\",\"body\":\"You're a few minutes away from your first paid collaboration. Here's the essentials in 2 minutes.\",\"startCta\":\"Start the guided tour\",\"callCta\":\"Book a live onboarding with Alexis\",\"callSub\":\"15 min, slots this week\",\"skip\":\"Skip for now\"},\"final\":{\"titleActive\":\"You're ready to post\",\"bodyActive\":\"You already have an active collab. Open it to grab the brief and your tracked link.\",\"ctaActive\":\"Open my collab\",\"titleMatched\":\"You've already been matched with {firstName}\",\"bodyMatchedOne\":\"You've seen how it works. Read {firstName}'s brief, copy the link, post - you'll earn your first euros today.\",\"bodyMatchedMany\":\"You've seen how it works. You can post now and earn your first euros - you've been matched with {names}. Let's start with {firstName}'s brief.\",\"ctaMatched\":\"Open {firstName}'s brief\",\"titleNoMatch\":\"You're ready to publish your first post\",\"bodyNoMatch\":\"No collab yet. Apply to a brief - the brand has 5 days to respond before the application is automatically declined.\",\"ctaNoMatch\":\"Explore the marketplace\",\"callTitle\":\"Any questions? Book a call with Alexis\",\"callSub\":\"15 min, slots this week\"},\"relaunchBtn\":{\"label\":\"Replay the guided tour\",\"sub\":\"Refresh the basics: dashboard, marketplace, collabs, payouts.\"},\"step\":{\"dashboardStats\":{\"title\":\"Your key numbers\",\"description\":\"Earnings, qualified clicks, active collabs. Track your performance in real time - every qualified click is worth €1.10 to you.\"},\"dashboardLeaderboard\":{\"title\":\"The leaderboard\",\"description\":\"The most active creators show up here, ranked by their total qualified clicks. The more you post, the higher you climb.\"},\"marketplaceOverview\":{\"title\":\"All available brands\",\"description\":\"Every B2B SaaS brand looking for LinkedIn creators. Each card shows the industry, commission, and brief.\"},\"marketplaceApply\":{\"title\":\"Apply in 1 click\",\"description\":\"Click this button to send your application. The brand receives your profile and LinkedIn stats and has 5 days to respond before the application is automatically declined.\"},\"matchedBrief\":{\"title\":\"Your brief: {firstName}\",\"description\":\"What the brand expects from you: angle, tone, formats to avoid. You've been matched with {names} - read this brief, then post with your link.\"},\"collabTabs\":{\"title\":\"Your 4 tabs\",\"description\":\"Active = ongoing collabs. Sent = your application is pending. Received = a brand is offering you a deal. Archived = the history.\"},\"collabRow\":{\"title\":\"One collab = one row\",\"description\":\"Each row bundles your brief, your tracked link, and your performance. Click to open the full detail view.\"},\"collabTrackedLink\":{\"title\":\"Your tracked link = €1.10 per click\",\"description\":\"Every qualified click on this link earns you €1.10. Copy it now - every visit becomes a commission.\"},\"collabDetail\":{\"title\":\"Your collab page\",\"description\":\"The hub for each partnership: brief, link, real-time leads, and this blue banner that opens the full brief.\"},\"collabCopyLink\":{\"title\":\"Copy your link in 1 click\",\"description\":\"This button copies your tracked link to the clipboard. Paste it into your LinkedIn post - every click becomes a sale credited to you.\"},\"collabBrief\":{\"title\":\"The full brief\",\"description\":\"The angle, the tone, the expected format, and what to avoid. Read it end to end - it prevents negative feedback from the brand.\"},\"collabBriefTrackedLink\":{\"title\":\"The link to embed\",\"description\":\"This is THE link to paste into your LinkedIn post. Every qualified click on it = €1.10 for you, credited automatically.\"},\"community\":{\"title\":\"The Naano community\",\"description\":\"Chat with other creators: hooks that work, lessons learned, post amplification asks. The more you engage, the faster you grow.\"},\"finances\":{\"title\":\"Your payouts\",\"description\":\"Your earnings month by month, pending commissions, and the button to withdraw via Stripe or bank transfer - payout in 7 days.\"}}},\"autoMatch\":{\"popupTitle\":\"Good news: you've been auto-matched\",\"popupBody\":\"{count, plural, one {One brand accepted your profile automatically.} other {# brands accepted your profile automatically.}} You can post for them right now - no application needed.\",\"popupCta\":\"View my partnerships\",\"popupDismiss\":\"OK, got it\",\"autoMatchedBadge\":\"You're auto-accepted\",\"createMyPost\":\"Create my post\",\"explainerBody\":\"Some of these partnerships were matched to you automatically based on your profile. You don't need to apply - just post.\",\"explainerDismiss\":\"Dismiss\",\"welcomeBannerBody\":\"\u003cstrong\u003eYou've been auto-matched with {count, plural, one {# partner} other {# partners}}.\u003c/strong\u003e Find them in your active collaborations list - you can post for them without applying.\",\"welcomeBannerCta\":\"View my partnerships\",\"welcomeBannerDismiss\":\"Dismiss\"},\"flatFeePriceBanner\":{\"title\":\"You're approved for pay-per-post - one step left\",\"body\":\"Set your price so brands can book you. Until then you won't appear in the pay-per-post marketplace and can't send applications.\",\"verifiedTitle\":\"Your Naano Verified card is ready\",\"verifiedBody\":\"Choose your price per post. Your card stays private until commercial approval and your professional details are complete.\",\"cta\":\"Set my price\"},\"directFlatCard\":{\"applyTitle\":\"You qualify for Flat Fee\",\"applyBody\":\"Brands can book you for fixed-price LinkedIn posts on top of pay-per-click. Apply and our team reviews your profile within 48 hours.\",\"applyCta\":\"Apply for Flat Fee\",\"applyingCta\":\"Sending application...\",\"applyError\":\"Couldn't send your application. Please try again.\",\"pendingTitle\":\"Your Flat Fee application is under review\",\"pendingBody\":\"Our team is checking your profile. You'll be able to set your price as soon as you're approved, usually under 48 hours.\",\"lockedTitle\":\"Flat Fee unlocks soon\",\"lockedBody\":\"Post {count, plural, =1 {1 more Naano post} other {# more Naano posts}} to apply for Flat Fee.\",\"lockedProgress\":\"{posted} / {total} Naano posts toward your next application\",\"modalTitle\":\"Set your price + bundles\",\"modalBody\":\"Tell us what you'd charge for a Flat Fee post. We'll include this in your application for review.\",\"modalCancel\":\"Cancel\",\"priceLabel\":\"Your net price (what you receive)\",\"perPost\":\"/ post\",\"priceMinError\":\"Minimum price is €10 per post.\",\"suggestedRange\":\"Suggested range\",\"useSuggested\":\"Use €{price}\",\"officialRangeTitle\":\"Official Naano range · real 90-day data\",\"indicativeRangeTitle\":\"Indicative estimate · estimated reach\",\"officialRangeMeta\":\"{confidence} confidence · {measured}/{expected} posts measured · brands see about {brandRange}\",\"indicativeRangeMeta\":\"Based on estimated reach. Connect or refresh the Naano extension for an official recommendation from your real 90-day data.\",\"confidence_high\":\"High\",\"confidence_medium\":\"Medium\",\"confidence_low\":\"Low\",\"confidence_estimated\":\"Estimated\",\"priceWarningHigh\":\"This is more than 25% above the suggested range (€{low}–€{high}). You can still save it.\",\"priceWarningLow\":\"This is far below the suggested range (€{low}–€{high}) and may undervalue your work. You can still save it.\",\"bundlesLabel\":\"Bundles (optional)\",\"bundleLimitNet\":\"Up to 2 · net prices\",\"bundlePostsFor\":\"posts for\",\"addBundle\":\"+ Add a bundle\",\"removeBundleAria\":\"Remove bundle\",\"saving\":\"Saving...\",\"save\":\"Save\"},\"briefChooser\":{\"kicker\":\"New campaign\",\"title\":\"Create your brief\",\"subtitle\":\"Choose how you want to start. The goal is simple: give creators enough context to write posts that sound sharp, credible, and useful.\",\"card1Title\":\"Import a link\",\"card1Description\":\"Paste your Notion, Google Doc, or PDF link. We turn it into a creator-ready brief.\",\"card1Badge\":\"Fastest\",\"card1Cta\":\"Paste a link\",\"card1Eta\":\"~30 sec\",\"card2Title\":\"Naano editor\",\"card2Description\":\"Build a structured brief with blocks, examples, and use-case templates.\",\"card2Badge\":\"Recommended\",\"card2Cta\":\"Open editor\",\"card2Eta\":\"~10 min\",\"card2CalloutTitle\":\"Best balance of speed and brief quality\",\"card2CalloutBody\":\"Creators ship 2× faster with editor briefs.\",\"card3Title\":\"Delegate your brief to Naano experts\",\"card3Description\":\"Our team scopes, drafts \u0026 ships a high-converting brief for you.\",\"card3Cta\":\"Book a 15-min call\",\"card3Badge\":\"Recommended · Done for you\",\"card3Eta\":\"~2 days\",\"card3HeroTitle\":\"Let Naano's experts build your brief\",\"card3HeroSubtitle\":\"Skip the blank page. Our strategists scope your angles, write a high-converting brief, and hand it to your creators - ready in ~2 days.\",\"card3Benefit1\":\"Senior B2B strategists, not templates\",\"card3Benefit2\":\"Angles \u0026 hooks proven to convert\",\"card3Benefit3\":\"Fully managed, ready in ~2 days\",\"card3Benefit4\":\"Built from 500+ briefs for B2B SaaS \u0026 tech teams\",\"card3IncludedTitle\":\"What's included\",\"card3Included1\":\"LinkedIn content strategy\",\"card3Included2\":\"LinkedIn posts written for you, with resources\",\"card3Included3\":\"Influence \u0026 distribution strategy\",\"card3Included4\":\"Hand-picked creator selection\",\"card3Included5\":\"Ready-to-activate brief in ~2 days\",\"card3TrustedBy\":\"Trusted by teams like\",\"card3PerfBadge\":\"3× more performance on campaigns, on average\",\"card3ExpertsLabel\":\"Your brief experts\",\"card3PriceUnit\":\"≈ €79 / post on a 10-post campaign\",\"card3ProofCtr\":\"2.3% avg CTR\",\"card3ProofCtrSub\":\"across 500+ briefs shipped\",\"card3PriceLabel\":\"Starting at\",\"card3HeroReassurance\":\"Flat fee agreed on the call - no surprises.\",\"diyLabel\":\"Prefer to do it yourself?\",\"card3ProofStat\":\"500+ briefs shipped\",\"card3ProofText\":\"for top B2B SaaS \u0026 tech teams\",\"card3CompareTitle\":\"Why hand it to our experts?\",\"card3CompareDiyLabel\":\"DIY brief\",\"card3CompareExpertLabel\":\"With experts\",\"card3CompareBarLabel\":\"Conversion potential of your posts\",\"card3CompareDiyValue\":\"Average\",\"card3CompareExpertValue\":\"Maximized\",\"card3CompareDiyDesc\":\"You start from a blank page with generic context - quality and results vary.\",\"card3CompareExpertDesc\":\"Proven angles, hooks and structure written to convert - refined over 500+ briefs.\",\"reassurance\":\"\u003cstrong\u003eYou're in control.\u003c/strong\u003e You'll review and approve the brief before it goes to creators.\",\"modalTitle\":\"Import an existing brief\",\"modalBody\":\"Paste your brief URL (Notion, Google Doc, or PDF). Creators will see this document with Naano branding around it.\",\"modalLabel\":\"Brief link\",\"modalHint\":\"Tip: make sure the link is accessible without logging in (public or \\\"anyone with the link\\\" sharing).\",\"modalCta\":\"Save link\",\"modalCtaLoading\":\"Saving…\",\"modalErrorRequired\":\"Paste a link to continue.\",\"modalErrorInvalid\":\"That link doesn't look valid. It should start with https://\",\"modalErrorGeneric\":\"Couldn't save the link. Please try again.\",\"card3Price\":\"€780\",\"card3CalloutTitle\