view\",\"unavailableCreator\":\"Creator currently unavailable\",\"proposedPrice\":\"Offer: {price} · not sent\",\"savedPrice\":\"{price}\",\"reviewOffer\":\"Review offer\",\"reviewInvite\":\"Resume\",\"negotiate\":\"Negotiate\",\"remove\":\"Remove\",\"removeCreator\":\"Remove {name} from this selection\",\"creator\":\"creator\",\"plannedTotal\":\"Planned budget: {price}\",\"priceHelp\":\"Subject to creator acceptance.\",\"viewBrief\":\"View brief\",\"priceChanged\":\"The creator price changed. Review the amount before continuing.\",\"dateChanged\":\"The saved deadline has passed or is too close. Review the new publication date.\",\"resumeFailed\":\"This creator or offer is no longer available. Review your selection in the marketplace.\",\"fundLater\":\"Fund later\",\"checkTerms\":\"Check your price and publication deadline before saving.\",\"saving\":\"Saving your campaign selection…\",\"saved\":\"Campaign saved. Resume here when you’re ready.\",\"laterHelp\":\"Save without sending or paying.\",\"partialSave\":\"The full selection could not be saved. Already saved choices are kept. Try again to finish.\",\"activateBrief\":\"Activate this brief with my creators\",\"activationHelp\":\"Review each invitation or negotiate a price. Funding is checked before anything is sent.\",\"reviewCreators\":\"Review my creators\",\"plannedBudgetLabel\":\"Planned budget\",\"shortlistedLabel\":\"Shortlisted\",\"prepareInvitations\":\"Invitations to prepare\",\"notSentYet\":\"These creators have not been invited yet.\",\"reviewInvitation\":\"Review invitation\",\"trackingStartsAfterSend\":\"After you send your invitations, track these collaborations here.\",\"shortlist\":\"Shortlist\",\"inviteCreators\":\"Invite your creators\",\"emptyShortlist\":\"Save creators from the marketplace to build your shortlist.\",\"findCreators\":\"Find creators\",\"savedCreatorsAvailable\":\"Your saved creators are still available in Creators → Shortlist.\",\"openSavedCreators\":\"Open saved creators\"},\