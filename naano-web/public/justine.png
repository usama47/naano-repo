type\\\":\\\"PostalAddress\\\",\\\"addressLocality\\\":\\\"Paris\\\",\\\"addressCountry\\\":\\\"FR\\\"}},\\\"email\\\":\\\"info@naano.com\\\",\\\"sameAs\\\":[\\\"https://www.linkedin.com/company/naanooo/\\\",\\\"https://fr.trustpilot.com/review/www.naano.xyz\\\"],\\\"founder\\\":[{\\\"@id\\\":\\\"https://naano.com/about#alexis-jarre\\\"},{\\\"@id\\\":\\\"https://naano.com/about#justine-namour\\\"},{\\\"@id\\\":\\\"https://naano.com/about#thomas-marcelle\\\"}]}\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebSite\\\",\\\"@id\\\":\\\"https://naano.com/#website\\\",\\\"name\\\":\\\"Naano\\\",\\\"url\\\":\\\"https://naano.com\\\",\\\"publisher\\\":{\\\"@id\\\":\\\"https://naano.com/#organization\\\"}}\"}}],[\"$\",\"div\",null,{\"className\":\"bg-noise\"}],\"$Le\",[\"$\",\"script\",null,{\"async\":true,\"src\":\"https://trybarkan.com/widget.js\",\"data-barkan-site\":\"site_-CORbb55XzDD1lVwnR9eedUqV9y0VSnW\"}]]}]]}]\na:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nf:I[175696,[\"/_next/static/immutable/chunks/1-hbv894utlrb.js\",\"/_next/static/immutable/chunks/1q4-fupqk0_j8.js\"],\"default\"]\ne:[\"$\",\"$Lf\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"common\":{\"getStarted\":\"Get started\",\"signIn\":\"Sign in\",\"features\":\"Features\",\"pricing\":\"Pricing\",\"faqs\":\"FAQs\",\"about\":\"About us\",\"blog\":\"Blog\",\"product\":\"Product\",\"resources\":\"Resources\",\"company\":\"Company\",\"documentation\":\"Documentation\",\"helpCenter\":\"Help Center\",\"privacy\":\"Privacy\",\"terms\":\"Terms\",\"noSpam\":\"No spam, ever!\",\"enterEmail\":\"Enter your email\",\"allRightsReserved\":\"© 2026 naano. All rights reserved.\",\"save\":\"Save\",\"saving\":\"Saving…\",\"soon\":\"Soon\",\"cancel\":\"Cancel\",\"confirm\":\"Confirm\",\"confirmQ\":\"Confirm?\",\"brandFallback\":\"Brand\",\"creatorFallback\":\"Creator\",\"back\":\"Back\",\"close\":\"Close\",\"you\":\"you\",\"remove\":\"Remove\",\"retry\":\"Retry\",\"switchLanguage\":\"Switch language\",\"openMenu\":\"Open menu\",\"closeMenu\":\"Close menu\"},\"nav\":{\"features\":\"How it works\",\"pricing\":\"Pricing\",\"faqs\":\"FAQs\",\"blog\":\"Blog\",\"resources\":\"Resources\",\"freeTools\":\"Free Tools\",\"reports\":\"Reports\",\"caseStudy\":\"Case study: BlogSEO\",\"about\":\"About us\",\"callWithTeam\":\"Book a call with the team\",\"bookCallCta\":\"Book a 15-min call\"},\"sidebar\":{\"icpBannerLabel\":\"Action required\",\"icpBannerBody\":\"Your ICP is empty. Creators won't see your company in the marketplace.\",\"icpBannerCta\":\"Set up matching\",\"menu\":\"Menu\",\"account\":\"Account\",\"campaign\":\"Campaign\",\"payPerClick\":\"Pay per click\",\"payPerPost\":\"Pay per post\",\"brief\":\"Brief\",\"studio\":\"Studio\",\"posts\":\"Posts\",\"leads\":\"Leads\",\"overview\":\"Overview\",\"myCollabs\":\"My collabs\",\"mySpace\":\"My space\",\"affiliates\":\"Affiliates\",\"briefs\":\"Briefs\",\"marketplace\":\"Marketplace\",\"companies\":\"Companies\",\"creators\":\"Creators\",\"myApplications\":\"My Applications\",\"applications\":\"Applications\",\"collaborations\":\"Collaborations\",\"messages\":\"Messages\",\"finances\":\"Finances\",\"billing\":\"Billing\",\"gains\":\"Gains\",\"analyticsLeads\":\"Leads and Posts\",\"academy\":\"Academy\",\"community\":\"Community\",\"helpCenter\":\"Help Center\",\"profile\":\"Profile\",\"settings\":\"Settings\",\"signOut\":\"Sign out\",\"completeProfile\":\"Complete your profile\",\"completeProfileToUnlock\":\"Complete your profile to unlock\",\"bookCallWithTeam\":\"Want to talk to the team?\",\"bookCallCta\":\"Book a call\",\"inviteCreators\":\"Invite Creators\",\"contestBannerTitle\":\"Creator contest\",\"contestBannerText\":\"Top creator of the week wins €100. The #1 in the ranking on Sunday takes it.\",\"contestBannerCta\":\"Post now\",\"linkedinBannerTitle\":\"Sync LinkedIn\",\"linkedinBannerText\":\"A 1-second sync. Naano reads only your public posts to auto-fill your profile and stats.\",\"linkedinBannerCta\":\"Sync in 1 second\",\"contestBannerMeta\":\"Live · ends Sunday\",\"contestBannerAmount\":\"€100 up for grabs\",\"contestBannerPausedMeta\":\"Paused\",\"contestBannerPausedText\":\"No contest this week\",\"contestBannerPausedSub\":\"Check back next week for a new prize!\",\"resources\":\"Resources\",\"linkedinBannerMicrocopy\":\"No password, no DMs, nothing private. Disconnect anytime.\",\"campaigns\":\"Campaigns\",\"home\":\"Home\",\"workspace\":\"Workspace\",\"newCampaign\":\"Create a campaign\",\"allCampaigns\":\"All campaigns\",\"contentPosts\":\"Content \u0026 posts\",\"collapseNavigation\":\"Collapse navigation\",\"openNavigation\":\"Open navigation\",\"resizeNavigation\":\"Drag to resize\",\"companiesAdmin\":\"Companies\",\"attribution\":\"Attribution\",\"payouts\":\"Payouts\"},\"header\":{\"overview\":\"Overview\",\"completeProfile\":\"Complete your profile\",\"marketplace\":\"Marketplace\",\"companies\":\"Companies\",\"myApplications\":\"My Applications\",\"applicationsReceived\":\"Applications Received\",\"collaborations\":\"Collaborations\",\"messages\":\"Messages\",\"settings\":\"Settings\",\"finances\":\"Finances\",\"billing\":\"Billing\",\"gains\":\"Gains\",\"academy\":\"Academy\",\"analyticsLeads\":\"Leads and Posts\",\"helpCenter\":\"Help Center\",\"dashboard\":\"Dashboard\",\"inviteCreators\":\"Invite creators\",\"onboarding\":\"Onboarding\",\"campaigns\":\"Campaigns\",\"newCampaign\":\"Create a campaign\",\"campaign\":\"Campaign\",\"plan\":\"Plan\"},\"faq\":{\"badge\":\"FAQs\",\"title\":\"Frequently Asked Questions\",\"cta\":\"Still have questions? We're happy to help.\",\"forBrands\":\"For Brands\",\"forCreators\":\"For Creators\",\"brands\":{\"q1\":\"What is Naano?\",\"a1\":\"Naano is the B2B LinkedIn creator marketplace: it connects B2B companies with vetted creators (from about 1,000 to 500,000 followers) who publish LinkedIn content that drives measurable traffic and leads.\",\"q2\":\"How does pricing work?\",\"a2\":\"Each creator sets a fixed price per post, shown with the deliverables before you book. You only pay for posts that go live - no cost per click, impression or lead. Self-Serve is €0/month; Managed Campaigns is €700/month.\",\"q3\":\"What counts as a \\\"qualified click\\\"?\",\"a3\":\"To protect quality, Naano filters out bots and crawlers, and deduplicates visits (one counted visit per IP per hour). We also review abnormal click-to-impression ratios.\",\"q4\":\"What happens if a post overperforms?\",\"a4\":\"The price you booked is the price you pay. A post that overdelivers on clicks or leads costs nothing extra - the fixed per-post fee already covers it.\",\"q5\":\"How do we choose creators?\",\"a5\":\"You can select creators based on profile, geography, and topics-or ask Naano to recommend and match the best creators for your campaign. We can also do creator selection together during onboarding.\",\"q6\":\"How do you track performance and ROI?\",\"a6\":\"You get a unified dashboard to monitor posts and results in real time (clicks, visits, leads, and revenue when applicable). You can also run retargeting and warm outbound on post interactions (likes, comments, shares) to improve conversion.\"},\"creators\":{\"q1\":\"How do I earn money on Naano?\",\"a1\":\"You're paid a flat fee per post. You set your price to match your audience, and you see the amount before accepting any collaboration - you're paid for the post regardless of how many clicks it generates.\",\"q2\":\"What are the withdrawal limits?\",\"a2\":\"Without a business structure, you can withdraw between €100 minimum and €500 maximum, with a limit of 25 paid posts per year. With a registered business structure (sole trader, company), there are no limits on withdrawal amounts or number of paid posts, unlocking unlimited earning potential.\",\"q3\":\"How does payment work?\",\"a3\":\"Your flat fee is locked in when the booking is confirmed. Once your post is published and approved by the company, you're paid automatically via Stripe Connect.\",\"q4\":\"Does my profile need to be validated by Naano before I start?\",\"a4\":\"No, your profile is not validated by Naano. You can begin applying to companies immediately after registration, giving you instant access to collaboration opportunities.\",\"q5\":\"What are the two main content formats to maximize clicks?\",\"a5\":\"The Lead Magnet format (DM strategy) is the most effective: you publish a high-value post, offer a free company resource, invite your audience to comment a specific word, then send the tracked link via DM to each person who comments. The direct link format is simpler: you naturally integrate the link in your post or first comment with authentic analysis.\",\"q6\":\"Am I free to choose what I post on Naano?\",\"a6\":\"Yes, you are completely free on the platform. We provide a brief for informational purposes to help you understand the company's expectations, but there is no contractual commitment. You're free to post when you want, for the companies you want, and choose the content format that suits you best. You maintain full control over your collaborations and can select only companies aligned with your values and audience.\"}},\"about\":{\"title\":\"About Us\",\"subtitle\":\"The B2B LinkedIn creator marketplace connecting companies with vetted creators.\",\"section1Title\":\"About Us\",\"section1P1\":\"Naano connects companies that want to grow with LinkedIn creators who want to monetize their audience.\",\"section1P2\":\"We believe growth works better when it's driven by people, not ads.\",\"section1P3\":\"That's why we help businesses scale through Creator-Led Growth: real professionals talking to real audiences.\",\"section2Title\":\"Our Mission\",\"section2P1\":\"Make creator marketing your most effective revenue channel.\",\"section2P2\":\"We connect B2B companies with LinkedIn micro-creators who deliver:\",\"section2Bullet1\":\"Strong credibility in their industry\",\"section2Bullet2\":\"Trust that converts into growth\",\"section2P3\":\"Real professionals talking to real audiences-at scale.\",\"section3Title\":\"Built on Proven Results\",\"section3P1\":\"Naano wasn't built on theory. It was built on results.\",\"section3P2\":\"Before launching the platform, we tested this model with a video AI startup:\",\"section3Bullet1\":\"LinkedIn micro-creators registered \u0026 vetted\",\"section3Bullet2\":\"+50% revenue in 30 days\",\"section3P3\":\"Naano was created to make this success easy to repeat, at scale.\",\"section4Title\":\"Why Naano?\",\"section4ForBrands\":\"For Brands\",\"section4Brand1\":\"Unlock new growth: Turn LinkedIn creators into your best sales channel\",\"section4Brand2\":\"Build brand authority: Get recommended by trusted voices in your industry\",\"section4Brand3\":\"Performance-pay only: Pay per click, not per post\",\"section4ForCreators\":\"For Creators\",\"section4Creator1\":\"Your expertise is the asset: Your credibility matters more than your follower count\",\"section4Creator2\":\"Monetize what you already do: Get paid for recommending tools you actually use\",\"section4Creator3\":\"Earn from your network: Turn your LinkedIn posts into revenue\",\"section5Title\":\"The Future of Growth\",\"section5P1\":\"Traditional advertising is losing impact.\",\"section5P2\":\"Collaboration is the future.\"},\"help\":{\"title\":\"Help Center\",\"subtitle\":\"Have a question or feedback? We're here to help.\",\"contactHeading\":\"Contact us\",\"contactBeforeEmail\":\"Send an email to \",\"contactAfterEmail\":\", or reach out to one of us on \",\"linkedin\":\"LinkedIn\",\"backToHome\":\"Back to home\",\"backToDashboard\":\"Back to dashboard\",\"faqTitle\":\"Frequently asked questions\",\"emailUs\":\"Email us\",\"legalTitle\":\"Legal\",\"privacy\":\"Privacy\",\"cgv\":\"Terms of Sale\",\"cgu\":\"Terms of Use\",\"responseTime\":\"We typically respond within 24 hours on weekdays.\"},\"legal\":{\"privacyPolicy\":\"Privacy Policy\",\"termsOfService\":\"Terms of Service\",\"downloadPdf\":\"Download PDF\",\"viewInNewTab\":\"View in new tab\",\"viewDocument\":\"View document\",\"troubleViewing\":\"Having trouble viewing? Open in a new tab or download.\"},\"footer\":{\"readyToScale\":\"Ready to scale with\",\"naano\":\"naano\",\"tagline\":\"Turn LinkedIn creators into your best acquisition channel.\"},\"navbar\":{\"imACreator\":\"I'm a creator\",\"signIn\":\"Sign in\",\"getStarted\":\"Get started\"},\"creatorFaq\":{\"badge\":\"FAQ\",\"headline\":\"Common questions.\",\"q0\":\"How much can I earn?\",\"a0\":\"Each marketplace offer shows its fixed amount before you accept it. Eligible creators can also set their own marketplace rate.\",\"q1\":\"Is there a follower minimum?\",\"a1\":\"No. We care about your niche and engagement, not your follower count.\",\"q2\":\"Do I have to write exactly what the company wants?\",\"a2\":\"No. You get a brief with an angle and a hook. You write the post your way. No scripts.\",\"q3\":\"How do I get paid?\",\"a3\":\"After the agreed content is approved, your payout is processed through the payment method connected to your account. Its status remains visible in Naano.\",\"q4\":\"How often can I post?\",\"a4\":\"You decide which opportunities to accept. Any timing or deliverable requirements are shown in the campaign brief.\",\"q5\":\"Can I choose which companies I post about?\",\"a5\":\"Yes. You see available campaigns and apply to the ones that fit your niche.\",\"q6\":\"Does a fixed-price post depend on clicks?\",\"a6\":\"No. The agreed marketplace price is not recalculated from clicks or impressions. Tracking is used for campaign reporting.\",\"footerNote\":\"Still unsure? Complete your profile and review the terms before accepting an opportunity.\",\"applyNow\":\"Apply now\"},\"dashboard\":{\"countryRequiredTitle\":\"Set your country to continue\",\"countryRequiredBody\":\"We need your country so SaaS companies targeting your region can discover you in the marketplace.\",\"saveCountry\":\"Save and continue\",\"showingBestMatches\":\"Showing best matches\",\"showAllCreators\":\"Showing all creators\",\"bestMatchesToggle\":\"Best matches\",\"allCreatorsToggle\":\"All creators\",\"matchModeLabel\":\"Filter creators\",\"setIcpToSeeMatches\":\"Set your target countries to see relevant creators here.\",\"openSettings\":\"Open settings\",\"strongMatch\":\"Strong match\",\"notYourMatch\":\"Not your match\",\"notYourMatchTooltip\":\"This SaaS is targeting other regions. You can't apply.\",\"setCountryToSeeTargetedSaas\":\"Set your country in your profile to see SaaS targeting your region.\",\"emptyIcpModalTitle\":\"Set your target customer profile\",\"emptyIcpModalBody\":\"Your marketplace will only surface relevant creators after you tell us who you sell to. Pick at least one industry and one country in matching settings.\",\"emptyIcpModalCta\":\"Open ICP settings\",\"close\":\"Close\",\"welcomeBack\":\"Welcome back, {name}\",\"creatorSubtitle\":\"Discover SaaS opportunities and grow your partnerships.\",\"saasSubtitle\":\"Manage applications and collaborations with creators.\",\"pendingApplications\":\"Pending Applications\",\"applicationsReceived\":\"Applications Received\",\"activeCollaborations\":\"Active Collaborations\",\"quickActions\":\"Quick Actions\",\"exploreMarketplace\":\"Explore Marketplace\",\"discoverSaaS\":\"Discover SaaS companies\",\"myApplications\":\"My Applications\",\"trackApplications\":\"Track your applications\",\"myFinances\":\"My Finances\",\"commissionsPayments\":\"Commissions and payments\",\"viewApplications\":\"View Applications\",\"pendingCount\":\"{count} pending\",\"collaborations\":\"Collaborations\",\"managePartnerships\":\"Manage partnerships\",\"financesPlans\":\"Finances \u0026 Plans\",\"manageSubscription\":\"Manage subscription\",\"addCreditsFirst\":\"Add clicks\",\"completeProfile\":\"Complete your profile\",\"completeProfileToUnlock\":\"Complete your profile to unlock\",\"creatorProfile\":\"Creator Profile\",\"companyProfile\":\"Company Profile\",\"creatorOnboardingDesc\":\"Introduce yourself to SaaS companies and showcase your LinkedIn expertise.\",\"saasOnboardingDesc\":\"Describe your company and offers to attract the best creators.\",\"invitedYouToNaano\":\"invited you to join Naano\",\"completeProfileToStart\":\"Complete your profile to start your first campaign.\",\"invitedYouCampaign\":\"invited you. Your first campaign is ready.\",\"applyBelowToStart\":\"Apply below to start earning.\",\"saasMarketplace\":\"Browse companies\",\"payPerPostMarketplace\":\"Pay per post\",\"payPerPostSubtitle\":\"Companies offering flat-fee collaborations - one payment per post.\",\"payPerPostWaitlistTitle\":\"Coming soon\",\"payPerPostWaitlistBody\":\"The pay-per-post marketplace is on its way. As an early-access member, you'll be the first to book flat-fee collaborations here.\",\"ppLiveBadge\":\"Live\",\"ppCreatorSubtitle\":\"Apply to unlock flat-fee, set your price, and get booked by brands at a fixed price per post.\",\"ppHeroTitle\":\"Get booked for flat-fee posts\",\"ppMarketplaceSubtitle\":\"Companies with an open flat-fee budget. Get validated to start booking flat-fee collaborations.\",\"ppLockedTitle\":\"Apply for flat-fee\",\"ppLockedBody\":\"Apply and our team reviews your profile within 48h. If you're not accepted, you can re-apply once you've published 4 pay-per-click posts.\",\"ppNeed5kTitle\":\"1,000 followers required\",\"ppNeed5kBody\":\"Flat Fee is open to creators with 1,000+ LinkedIn followers. Keep growing your audience and it'll unlock automatically.\",\"ppArrivingBanner\":\"New feature: get booked for a flat fee per post. More companies are arriving this week.\",\"ppBudgetBadge\":\"Pay-per-post budget\",\"ppBudgetAvailableLabel\":\"available to book posts\",\"ppBudgetTitle\":\"Budget {name}\",\"ppBudgetSharedHint\":\"Shared among creators - apply early, get booked faster.\",\"ppBudgetExhausted\":\"Budget exhausted\",\"budgetHealthSafe\":\"safe\",\"budgetHealthRisky\":\"tight\",\"budgetHealthLow\":\"low\",\"budgetHealthEmpty\":\"empty\",\"ppApplyCta\":\"Apply to this brand\",\"ppApplyNeedPriceHint\":\"Set your pay-per-post price first →\",\"ppApplicationSentTitle\":\"Application sent\",\"ppApplicationReply7Days\":\"We'll let you know when {company} reviews it (usually within a week)\",\"ppApplyModalTitle\":\"Apply to {name}\",\"ppApplyModalBody\":\"Send a short pitch. If they accept, we auto-create a booking using your pay-per-post price. You confirm and you get paid.\",\"ppApplyModalPitchLabel\":\"Your pitch (optional)\",\"ppApplyModalPitchPlaceholder\":\"What kind of post are you thinking? Why are you a good fit for this brand?\",\"ppApplyModalCancel\":\"Cancel\",\"ppApplyModalSubmit\":\"Send application\",\"ppApplyModalSubmitting\":\"Sending…\",\"ppEmpty\":\"No companies with an open flat-fee budget right now. Check back soon.\",\"ppHowTitle\":\"How flat-fee works for you\",\"ppStep1Title\":\"Apply for flat-fee\",\"ppStep1Body\":\"1,000+ LinkedIn followers unlocks the application - get approved to become bookable.\",\"ppStep2Title\":\"Set your price \u0026 bundles\",\"ppStep2Body\":\"You decide your per-post rate and your multi-post packs.\",\"ppStep3Title\":\"Publish your profile\",\"ppStep3Body\":\"Brands discover and book you directly from your public page.\",\"ppCta\":\"Set up pricing \u0026 publish\",\"creatorMarketplace\":\"Browse creators\",\"discoverSaaSApply\":\"Discover companies and apply for collaborations.\",\"discoverCreatorsInvite\":\"Discover creators and invite them to collaborate with you.\",\"payPerPostTitle\":\"Pay per post\",\"payPerPostBookSubtitle\":\"Book an eligible creator at a fixed price per post, no per-click billing.\",\"searchCompany\":\"Search for a company...\",\"searchCreator\":\"Search for a creator...\",\"filters\":\"Filters\",\"clearFilters\":\"Clear filters\",\"savedFilter\":\"Saved\",\"allCountries\":\"All countries\",\"allIndustries\":\"All industries\",\"industry\":\"Industry\",\"followersMin\":\"Min followers\",\"followersMax\":\"Max followers\",\"sortBy\":\"Sort by\",\"sortDefault\":\"Relevance (default)\",\"sortFollowersDesc\":\"Followers (descending)\",\"sortFollowersAsc\":\"Followers (ascending)\",\"sortNameAsc\":\"Name (A→Z)\",\"noCompanies\":\"No companies available\",\"noCompaniesDesc\":\"There are no companies registered yet. Check back soon!\",\"noCreators\":\"No creators available\",\"noCreatorsDesc\":\"There are no creators registered yet. Check back soon!\",\"apply\":\"Apply\",\"applied\":\"Applied\",\"invite\":\"Invite\",\"invited\":\"Invited\",\"viewProfile\":\"View Profile\",\"seeMedia\":\"See media\",\"seeBrief\":\"See brief\",\"seeMoreDetails\":\"See full details\",\"atCapacity\":\"At capacity\",\"creatorsCount\":\"{current}/{max} creators\",\"applicationSent\":\"Application pending\",\"applications\":{\"pending\":\"Pending\",\"accepted\":\"Accepted\"},\"notTakingCreators\":\"Not taking more creators\",\"completeProfileToApply\":\"Complete your creator profile to apply\",\"alreadyApplied\":\"You have already applied to this company\",\"notInTargetGeography\":\"This company isn't available in your region\",\"activeCreators\":\"Active creators\",\"terms\":\"Terms\",\"companyDescription\":\"Description\",\"noDescription\":\"No description available.\",\"notSpecified\":\"Not specified\",\"followers\":\"Followers\",\"profile\":\"Profile\",\"resources\":\"resources\",\"inviteCreator\":\"Invite {name}\",\"seeDetails\":\"See details\",\"inviteMessageDesc\":\"Send a personalized message to invite this creator to collaborate with you.\",\"invitationMessage\":\"Invitation message\",\"invitationPlaceholder\":\"Hello, we would like to collaborate with you because...\",\"cancel\":\"Cancel\",\"sending\":\"Sending...\",\"sendInvitation\":\