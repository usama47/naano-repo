ce\",\"matchLabel\":\"Match\",\"agentCollapse\":\"Collapse Nao\",\"agentExpand\":\"Open Nao\",\"agentWelcomeBody\":\"I analysed {count} creators for {signal}. Here are the three I would start with.\",\"agentSemanticWelcomeBody\":\"Your instant semantic selection includes {count} creators for {signal}. AI is refining the ranking in the background.\",\"agentStepUnderstanding\":\"Understanding your request\",\"agentStepEvidence\":\"Checking creator evidence\",\"agentStepUpdating\":\"Updating the selection\",\"agentUpdatingCards\":\"Recomposing your creator selection\",\"agentUpdatingCardsBody\":\"The strongest matches will appear first.\",\"agentFrenchMicro\":\"French micro-creators\",\"agentCpmBelow\":\"CPM below €80\",\"agentCreativeAi\":\"Creative AI profiles\",\"agentNotNow\":\"Not now\",\"agentPlaceholder\":\"Ask Nao a question, or find creators…\",\"agentApply\":\"Apply request\",\"agentUndo\":\"Undo\",\"agentRetry\":\"Retry this search\",\"agentCreatorCount\":\"{n} creators\",\"agentResultsUpdated\":\"{n} results updated\",\"agentSelectionCount\":\"{n} selected\",\"agentWelcomeTitle\":\"I found {n} creators for {company}.\",\"agentReadyTitle\":\"I can refine this marketplace for {company}.\",\"agentUnsupported\":\"Ask for a shortlist, comparison, campaign angle or creator constraint.\",\"agentAnswerTitle\":\"Naano updated your selection\",\"agentFiltersUpdated\":\"Selection refined\",\"agentFiltersUpdatedBody\":\"I updated the creators around your request. The strongest matches now appear first.\",\"topRankedCreators\":\"Top ranked creators\",\"topRankedCreatorsBody\":\"The 40 strongest profiles according to your sector and performance signals.\",\"moreRankedCreators\":\"More ranked creators\",\"moreRankedCreatorsBody\":\"Continue through the complete catalogue, from most to least recommended.\",\"agentThinkingTitle\":\"Building a selection for {company}\",\"agentThinkingBody\":\"I’m translating your request into campaign fit, creator evidence and commercial con