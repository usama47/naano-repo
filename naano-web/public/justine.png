in\"},\"collaborationDetailResourceProposal\":{\"_663dx\":\"Submitting…\",\"-8cRvI\":\"Submit for validation\",\"HqGG_y\":\"Enter the URL you want to promote. We'll create a tracked link and validate it—usually within a few hours.\"},\"creatorGamificationInline\":{\"cIy6TJ\":\"{count, plural, one {# click} other {# clicks}}\",\"dx6o-T\":\"{count, plural, one {consecutive week} other {consecutive weeks}}\",\"I7-hN0\":\"this week\",\"rWGVvg\":\"{count} before {tier}\",\"Vzjf62\":\"€{amount} earned on Naano\",\"51XA9L\":\"vs. 30 days\",\"26tyS2\":\"7d\",\"nZ1VHG\":\"30d\",\"f4JKQ4\":\"90d\",\"zQvVDJ\":\"All\",\"EL3d5Q\":\"Analysis period\"},\"creatorDashboardInline\":{\"tCqZF8\":\"This collaboration is paused because your LinkedIn account is not connected to Naano. Reconnect it to resume click billing.\"},\"saasDashboardInline\":{\"l1B_jG\":\"Profile not found. Please complete your onboarding.\"},\"creatorWalletReferral\":{\"vBuHFr\":\"Brand referral reward\",\"Up8vxE\":\"Creator referral reward\"},\"financesLegacyPayout\":{\"ecP5Jj\":\"Configure your payment method below to receive your earnings.\",\"_0TOL5\":\"Amount\",\"PXAur5\":\"Withdraw\",\"yrbKVN\":\"Minimum withdrawal: €{amount}. Funds arrive in 2–5 business days.\"},\"billingV2TopUp\":{\"KdpTFX\":\"Enter a whole amount between €500 and €50,000.\"},\"messagesIndexPage\":{\"hi-xK_\":\"Select a conversation to get started.\"},\"planPage\":{\"F9h_2P\":\"You manage it\",\"kJH8eJ\":\"Unlimited Flat Fee campaigns\",\"Gmyuw7\":\"Creator Marketplace\",\"Fv7eU6\":\"Tracked links + pixel\",\"d6lnw-\":\"Creator messaging\",\"qyaCWe\":\"Talk to our team\",\"O6flft\":\"€349/month\",\"n_L9wW\":\"Everything in Starter\",\"EG2iK-\":\"Priority ICP matching\",\"-rU6fq\":\"Leads \u0026 Posts (advanced analytics)\",\"3sSrKz\":\"Priority support\",\"G0ma3D\":\"€700/month + budget\",\"5NVTG9\":\"We manage it for you\",\"qcnqrH\":\"Everything in Growth\",\"H3GDnl\":\"Campaigns managed by our team\",\"h9rjUk\":\"Creator selection done for you\",\"llfA6p\":\"Dedicated reporting\",\"oDpS9I\":\"Book a call\",\"BrNEz1\":\"On request\",\"27ndLN\":\"Multi-brand or agency volume\",\"Kdv75D\":\"Dedicated success manager\",\"JBNQUI\":\"Tailored billing\",\"eZ5XCb\":\"Build a custom plan\",\"Mo9L8w\":\"← Back to billing\",\"PFGLfW\":\"Manage your plan\",\"TGXC8K\":\"Plan changes are handled with our team. A 15-minute call is enough.\",\"ZBALng\":\"Current plan\",\"ChuNUI\":\"Your plan\",\"IGjzWS\":\"Plans do not affect your campaign budget. Top up your Flat Fee budget from\",\"Tbo377\":\"Billing\"},\"workspaceMembers\":{\"cRn1pg\":\"Team invitations are temporarily unavailable.\",\"zozH4j\":\"Sign in again to manage your team.\",\"C6VMRp\":\"We couldn't find a workspace for this account.\",\"nzB-kJ\":\"Only the workspace owner can manage members.\",\"DPDtR5\":\"Enter a valid work email address.\",\"KS9xNw\":\"You can only invite people to workspaces you own.\",\"lPhd6r\":\"This person already belongs to every selected workspace.\",\"Dq3pBA\":\"You've sent several invitations today. Please try again later.\",\"feGBW6\":\"We couldn't load the team. Please refresh the page.\",\"7gmd0K\":\"No invitation was sent. Check the address and try again.\",\"EdIvJR\":\"This member couldn't be removed. Please try again.\",\"C12u6l\":\"{email} now has access to the workspace.\",\"s3dZc1\":\"Invitation sent to {email}.\",\"iYGE8Y\":\"{name} no longer has access to this workspace.\",\"2AobWx\":\"Invite a colleague\",\"KiR5cs\":\"They'll receive a secure link that expires after 14 days.\",\"TyDkZU\":\"Choose workspaces\",\"HHRIuR\":\"Work email\",\"XEX2jg\":\"colleague@company.com\",\"ff2VGL\":\"Sending…\",\"83nTSd\":\"Send invitation\",\"9PnJC1\":\"New users create their account from the private email link. Existing Naano users get access immediately.\",\"uQGyjD\":\"People with access\",\"V3qyew\":\"Active members and invitations awaiting acceptance\",\"mqVbYR\":\"{count} people\",\"Lxkny3\":\"Loading members…\",\"MWFE1B\":\"No members yet\",\"FHb_iH\":\"Invite your first colleague below.\",\"QIHvkI\":\"Invitation pending\",\"81_unf\":\"{email} · You\",\"zINlao\":\"Owner\",\"iHN12u\":\"Admin\",\"T0e6Lh\":\"Remove {name}\",\"fZgP9x\":\"Remove this member?\",\"iIdlod\":\"{name} will immediately lose access to campaigns, bookings, messages and the workspace wallet.\",\"47FYwb\":\"Cancel\",\"mYYz2Q\":\"Remove access\",\"couBcS\":\"Members receive administrator access. Only you, the owner, can invite or remove people.\",\"gCeqi_\":\"You have administrator access. Only the workspace owner can manage the team.\"},\"agenciesLanding\":{\"mEO40O\":\"Create one workspace per client\",\"egepxA\":\"Add and allocate client budgets\",\"D-mjnC\":\"Track campaigns and next actions\",\"0_xnxf\":\"Import any creator roster CSV\",\"li7cNq\":\"Manage rates and creator profiles\",\"U04w62\":\"Track collaborations and earnings\",\"YhkOke\":\"Naano for agencies\",\"alE7pc\":\"Choose the workspace that matches your agency.\",\"rnqGM7\":\"Naano separates brand operations from creator management. Choose your setup and create the right workspace for your agency.\",\"kPPnsq\":\"Two distinct products\",\"s2Oj9V\":\"What does your agency manage?\",\"zCo__v\":\"Brand agency\",\"UDl8je\":\"I manage campaigns for companies\",\"mkIDrl\":\"Operate separate client workspaces, budgets, campaigns and reporting from one portfolio.\",\"SnwKaq\":\"Create a brand agency workspace\",\"h2rajw\":\"You will create the agency manager account first.\",\"2rnINg\":\"Creator agency\",\"g84Jo3\":\"I represent and manage creators\",\"ShtRlb\":\"Import your roster, manage every profile and run collaborations without creator logins.\",\"68fjud\":\"Create a creator agency workspace\",\"XNCan4\":\"Your creators do not need individual Naano accounts.\",\"wkiFDw\":\"Talk to Naano\",\"bSBZ36\":\"Not sure which workspace fits your agency?\",\"OW2Mbw\":\"Book a 30-minute agency call. We will look at how you manage clients or creators and point you to the right setup.\",\"oDpS9I\":\"Book a call\",\"F0uNuP\":\"30 minutes with the Naano team. No commitment.\"},\"landingAgencyNavigation\":{\"J77BjO\":\"Choose your agency\",\"jnRCFw\":\"For companies\",\"hIHjP8\":\"For creators\",\"Ci1cS4\":\"For agencies\"},\"bestB2bInfluencerPlatforms2026\":{\"KlNnKv\":\"— the structural difference is that Naano is a transactional marketplace, not a database: every creator publishes a flat offer price per post, booking and payment happen in the platform, and every published post carries UTM-tracked links back to the campaign. The median post transacted at €117 for a creator under 10,000 followers and €312 at 10,000–25,000 followers (\",\"7-plDa\":\"the full price index, n=239\",\"v60U9o\":\"— transparent, flat per-post pricing versus opaque licenses and retainers.\",\"M-Ks7c\":\"— can you trace clicks and leads back to each individual post?\",\"S0TUt1\":\"Why AI search cites people rather than brand pages, and what that changes for B2B distribution\",\"j7qxOM\":\"How long a B2B creator campaign takes, stage by stage\",\"5QgKhj\":\"Creator campaign budget planner: turn a budget into published posts\",\"hYCcG_\":\"B2B creator campaigns in Europe: direct answers on pricing, ROI and country coverage\",\"h7NxeI\":\"Book a vetted B2B LinkedIn creator at a flat price per post.\",\"fOh5Sb\":\"2,000+ vetted LinkedIn micro-creators, a flat price per post set by each creator, no monthly platform fee, and UTM-tracked links on every post.\"},\"publicBriefPage\":{\"GxA-U8\":\"pays vetted B2B LinkedIn creators a flat fee to publish sponsored LinkedIn posts in their own voice.\",\"7M3Xc7\":\"Naano matches B2B brands with vetted LinkedIn creators for flat-fee sponsored posts. Creators keep full creative control; brands get authentic reach.\",\"B_6caF\":\"Naano is the B2B LinkedIn creator marketplace, connecting companies with vetted LinkedIn creators from about 1,000 to 500,000 followers. Brands publish campaign briefs like this one; creators apply and get paid a flat fee per sponsored post, written in their own voice. Explore\",\"v1i5Zm\":\"open campaigns\",\"Ntjkqd\":\"or\",\"822nB9\":\"learn more about creating on Naano\"},\"briefsIndexPage\":{\"Uh7XcN\":\"B2B brands publish campaign briefs on Naano to find vetted LinkedIn creators for flat-fee sponsored posts. Each brief describes the brand's context, tone, content angles and targeting — pick a campaign that fits your audience and apply, or\"},\"extensionPrivacyAutomation\":{\"X6hwbe\":\"Naano Confirm lets a Naano creator import analytics from their own LinkedIn profile into their Naano creator card after they explicitly start and authorize the import.\",\"G3iURZ\":\"After a successful import, Chrome can request due J+1, J+3 and J+7 campaign-post measurements under the same authorization while Chrome is running and the LinkedIn session remains valid. The extension never publishes, changes or deletes LinkedIn content.\",\"9jbKAJ\":\"The initial import starts only after a voluntary action in Naano and explicit authorization. Automatic campaign measurements are limited to posts submitted for collaborations and to the J+1, J+3 and J+7 windows.\",\"QJXtqG\":\"You can interrupt an import, remove your authorization and request deletion of imported data. A Basic profile remains available without the extension.\",\"w5mQVI\":\"Authorized data is sent to naano.com over HTTPS. The legacy naano.xyz and www.naano.xyz origins remain temporarily allowed only for redirect compatibility. Initial uploads use a short-lived capability limited to one import job; automatic campaign checks use a revocable capability stored only in the authorized browser.\",\"p8LlZN\":\"chrome.storage.local keeps an active job and its recovery snapshot until completion, post-metric retry data for at most 24 hours, and a complete aggregate audience cache for at most 24 hours.\",\"Ik9k0k\":\"The browser can retain the revocable automatic-measurement capability for at most 120 days. The server stores only its SHA-256 hash, and the capability is removed locally when it expires, is rejected or the LinkedIn identity changes.\",\"VWymEu\":\"After Naano receives the data, it follows the retention periods in the general privacy policy. You can request deletion at info@naano.com.\",\"wQ3OU-\":\"linkedin.com (https://www.linkedin.com/*): reads the authorized creator profile, creator analytics, aggregate audience and due campaign-post analytics\",\"gjnSOB\":\"naano.com: detects the Naano flow, receives limited capabilities and securely sends normalized results; naano.xyz and www.naano.xyz remain temporary compatibility origins\",\"Pwffbw\":\"storage: stores active-job recovery data, 24-hour metric and aggregate-audience caches, and the revocable automatic-measurement capability\",\"Nn_pgo\":\"scripting: runs only code packaged with the extension on the authorized Naano and LinkedIn domains\",\"JQZCQ6\":\"alarms: schedules import retries and due campaign-post checks every 15 minutes\"},\"extensionInstallPage\":{\"TBoYtD\":\"← Naano\",\"zYQ_WT\":\"Naano Confirm\",\"8-psDV\":\"Connect your LinkedIn analytics to Naano so your creator profile can show verified reach, engagement and audience data.\",\"ssEp72\":\"Install from Chrome Web Store\",\"a9D7X9\":\"Download Naano Confirm v{version}\",\"vowdbA\":\"Install in Chrome\",\"JVFz7b\":\"Install the downloaded package\",\"c_ayzH\":\"Open the Chrome Web Store from the button above.\",\"ukPeQb\":\"Choose Add to Chrome and approve the extension.\",\"YS5y-V\":\"Return to Naano and click Verify extension.\",\"YMXPr8\":\"Download and unzip the Naano Confirm package.\",\"diZdmu\":\"Open {url} and enable Developer mode.\",\"2PW-5W\":\"Click Load unpacked and select the unzipped folder.\",\"7YeCP5\":\"Keep LinkedIn signed in, then return to Naano and click Verify extension.\",\"LfuX-h\":\"Your LinkedIn session cookie stays inside LinkedIn. Naano Confirm sends only the profile and analytics data needed for your Naano creator profile.\"},\"creatorCampaignBudgetPlanner\":{\"B7hDsY\":\"Spread\",\"z3tQXo\":\"Mid-tier\",\"F4nT_i\":\"Concentrated\",\"JSBBie\":\"Creators under 5,000 followers\",\"wzdMxB\":\"Creators with 10,000–25,000 followers\",\"zTRPVm\":\"Creators with 50,000+ followers\",\"oHhBJ-\":\"{tier} · median {price}/post (n={n})\",\"plwQCH\":\"Your price\",\"1pM9yG\":\"{price} per post · {band} band\",\"EfLze4\":\"Your campaign budget (€)\",\"w8qotS\":\"e.g. 5000\",\"9RECch\":\"Your own price per post (€)\",\"PshxV-\":\"— optional\",\"TYpf8i\":\"e.g. 250\",\"AgmYlg\":\"Enter a budget to see how many sponsored posts it books at real transacted medians — and how many of those historically ended in a published post.\",\"3zzBY1\":\"{budget} budget · expected published posts apply the historical settled delivery rate for each price band\",\"eExHJe\":\"Allocation\",\"kn46qJ\":\"Posts booked\",\"p4pp2T\":\"Delivery rate\",\"bk1nJb\":\"Expected published\",\"Nwioqb\":\"Cost per published post\",\"j4xKs_\":\"On these historical rates, the {allocation} allocation produced the lowest cost per published post: {costPerPublished} against {price} per post booked.\",\"GlQdVx\":\"Plan the calendar on {p90} days, not {median}. Delivered bookings took a median of {median} days from booking to published post, with a 90th percentile of {p90} days (n=89).\",\"SLD3fV\":\"Delivery rates are volatile: the €600+ band moved from 80.6% to 64.6% between the 3 August and 11 August snapshots on 11 extra bookings. Read every rate here with its sample size.\",\"ynp5jb\":\"One of the rows above sits in the €400–€599 band, which rests on 36 bookings from only 9 distinct buying brands. Treat it as directional.\",\"0RPxjB\":\"Follower count explains under a third of what creators charge (log-log R² = 0.289, n=769). These tier medians are a budgeting aid, not a recommended price for any specific creator.\",\"XFWKXk\":\"How to use this result:\",\"ORZkir\":\"the delivery rates are historical associations across a young dataset, not causal promises — a brand paying more usually also briefs better and follows up. Use the third column to stop planning on posts booked, then judge creators on audience fit rather than on the tier medians used here.\",\"yWetNH\":\"Sponsored Post Delivery Odds Estimator\",\"OgXxhz\":\"See how often offers at your price actually get published.\",\"xTgmga\":\"LinkedIn Creator Worth Calculator\",\"nWmaQV\":\"Find out what a sponsored post from any creator should cost.\",\"8bM1h3\":\"All free tools\",\"X_Iipm\":\"Every free Naano tool for B2B creator marketing, in one place.\",\"eQ8Dfj\":\"Under 5,000 followers\",\"z_4E9O\":\"Under €200\",\"sxbuW9\":\"Most posts per euro, lowest delivery rate. 66 bookings set this median.\",\"_fp7VB\":\"10,000 – 25,000 followers\",\"pU4R8z\":\"€200 – €399\",\"8KMNdN\":\"40.9% of these offers went unanswered — the second-worst response rate.\",\"uCXV4K\":\"50,000+ followers\",\"DyprzK\":\"€600 and above\",\"_Lm1RY\":\"Fewest posts, strongest observed delivery. Thin tier: 16 bookings set this median.\",\"OVZS64\":\"Free Tools\",\"UbqZ38\":\"Creator Campaign Budget Planner\",\"uDOkkP\":\"Enter a budget and see how many sponsored LinkedIn posts it books at real transacted medians — and, more usefully, how many of those historically ended in a published post. Built on 300 real bookings. Free, no account, nothing leaves your browser.\",\"u03nDc\":\"The three allocations, and where they come from\",\"I_AlOk\":\"Each allocation uses the transacted median price for a real follower tier, then applies the historical settled delivery rate for the price band that median falls into. The band is derived from the price, so a preset always agrees with what the custom-price input returns for the same number. Bookings still awaiting a decision are excluded from the delivery-rate denominator.\",\"m_2A8l\":\"Median price\",\"7kGdAJ\":\"Band\",\"w7tf2z\":\"Published\",\"EBHT0u\":\"[Naano Index, n=300 bookings, 14 June – 11 August 2026]. The timing side of the same dataset is in \u003ctiming\u003ehow long a B2B creator campaign takes\u003c/timing\u003e, and the full price distribution is in the \u003cpricing\u003eLinkedIn sponsored post price index 2026\u003c/pricing\u003e.\",\"yQQhDM\":\"Method, and what this planner does not claim\",\"Lo98uB\":\"Source.\",\"XOsCoW\":\"Naano's own marketplace database, queried read-only on 11 August 2026 at 19:05 UTC. Every sponsored-post booking created between 14 June and 11 August 2026, normalised to price per post (n=300), plus the 89 of those that reached a published post for the timing figures. Bookings placed by Naano itself as a buyer are excluded. No cell below ten observations is published, and no individual creator, brand or amount appears anywhere.\",\"F1w9uJ\":\"This is a correlation, not a causal claim.\",\"v73qFz\":\"Paying €600 does not make a post appear. A brand paying €600 usually also has a real budget, a written brief, and someone internally who chases the campaign — any of which could be doing the work. The planner applies observed historical rates to a budget; it does not model what would happen if you changed a price.\",\"-Oz9vY\":\"Expected published posts are an average, not a guarantee.\",\"gXwGee\":\"A 30.4% delivery rate applied to ten bookings gives an expectation of about three published posts, but the actual outcome for any single campaign varies widely — especially at small booking counts. Treat the third column as a planning correction, not a forecast for one campaign.\",\"IQFmk6\":\"Sample caveats, and how much these rates move.\",\"RUl9Yt\":\"The €400–€599 band rests on 36 bookings from only 9 distinct buying brands and should be read as directional. More importantly, these rates are not stable yet: between the 3 August and 11 August snapshots the €600+ delivery rate fell from 80.6% to 64.6% on 11 additional bookings, and the unanswered-offer rate in that band rose from 8.1% to 19.2%. The direction of the effect has held in every cut so far; its size has not. Re-read this page against the snapshot date rather than assuming the numbers are settled.\",\"0yrJHp\":\"What is deliberately absent.\",\"HXt38b\":\"No impressions, reach, cost-per-lead or cost-per-click figure appears on this page. LinkedIn does not expose post impressions for third-party posts, and our tracked-link coverage is currently too partial to publish a clicks-per-post benchmark honestly. Naano charges a flat fee per sponsored post set by each creator, and does not sell per click.\",\"7Rm1x6\":\"Frequently asked questions\",\"yqafFY\":\"More free tools\",\"JfG49w\":\"Open\",\"3RxJE-\":\"See the real prices before you commit a budget\",\"r1mtgd\":\"Every creator on Naano publishes their own flat fee per post, so you can build the plan against actual numbers instead of estimates. Contracts, escrow and invoicing handled — no monthly platform fee.\",\"O1U5TK\":\"Book a creator on Naano\",\"avTrmC\":\"Want the shortlist before the spreadsheet?\",\"pNx8vc\":\"Describe your campaign and a real person at Naano builds you a hand-picked shortlist of relevant B2B creators, with their rates and audience fit, within 48 hours. Free, no account.\",\"qxQjVu\":\"Get a free shortlist\"},\"creatorWorthCalculatorPage\":{\"slSUhC\":\"LinkedIn Engagement Rate Calculator\",\"I7mwPU\":\"Calculate your engagement rate and compare it to 2026 benchmarks.\",\"yWetNH\":\"Sponsored Post Delivery Odds Estimator\",\"OgXxhz\":\"See how often offers at your price actually get published.\",\"8bM1h3\":\"All free tools\",\"X_Iipm\":\"Every free Naano tool for B2B creator marketing, in one place.\",\"OVZS64\":\"Free Tools\",\"yqafFY\":\"More free tools\",\"JfG49w\":\"Open\"},\"engagementRateCalculatorPage\":{\"xTgmga\":\"LinkedIn Creator Worth Calculator\",\"nWmaQV\":\"Find out what a sponsored post from any creator should cost.\",\"yWetNH\":\"Sponsored Post Delivery Odds Estimator\",\"OgXxhz\":\"See how often offers at your price actually get published.\",\"8bM1h3\":\"All free tools\",\"X_Iipm\":\"Every free Naano tool for B2B creator marketing, in one place.\",\"OVZS64\":\"Free Tools\",\"yqafFY\":\"More free tools\",\"JfG49w\":\"Open\",\"npdW5E\":\"Browse vetted LinkedIn creators with the engagement rates to prove it. Every creator lists a flat fee per post upfront — no negotiation, no surprises.\"},\"freeToolsPage\":{\"QEMGZE\":\"Free tools by Naano\",\"C-6MM7\":\"Open the tool\"},\"deliveryOddsEstimatorPage\":{\"xTgmga\":\"LinkedIn Creator Worth Calculator\",\"nWmaQV\":\"Find out what a sponsored post from any creator should cost.\",\"slSUhC\":\"LinkedIn Engagement Rate Calculator\",\"I7mwPU\":\"Calculate your engagement rate and compare it to 2026 benchmarks.\",\"8bM1h3\":\"All free tools\",\"X_Iipm\":\"Every free Naano tool for B2B creator marketing, in one place.\",\"OVZS64\":\"Free Tools\",\"rPwNP0\":\"Enter what you plan to offer a LinkedIn creator per post. We compare it to 300 real sponsored-post bookings and tell you how often offers at that price actually ended in a published post. Free, no account, nothing leaves your browser.\",\"gB_QN0\":\"[Naano Index, n=300 bookings, 14 June – 11 August 2026]\",\"CNBzzJ\":\"[Naano Index, n=300 bookings, 14 June – 11 August 2026]. The full report, including listed-price dispersion and niche premiums, is in the \u003creport\u003eLinkedIn sponsored post price index 2026\u003c/report\u003e.\",\"Lo98uB\":\"Source.\",\"0iqPlu\":\"Naano's own marketplace database, queried read-only on 11 August 2026 at 19:05 UTC. Every sponsored-post booking created between 14 June and 11 August 2026, normalised to price per post (n=300), plus the live listed rate of every creator open for bookings at that time (n=769). Bookings placed by Naano itself as a buyer are excluded. No cell below ten observations is published, and no individual creator, brand or amount appears anywhere.\",\"WvDup2\":\"Sample caveats.\",\"LEwfJj\":\"The €400–€599 band rests on 36 bookings from only 9 distinct buying brands and should be read as directional. The figures move week to week: the €600+ delivery rate fell from 80.6% to 64.6% between the 3 August and 11 August snapshots on 11 extra bookings.\",\"yqafFY\":\"More free tools\",\"JfG49w\":\"Open\"},\"linkedinCreatorMarketplacePage\":{\"hZHy3N\":\"LinkedIn Creator Marketplace for B2B Brands — Naano\",\"oKr0DM\":\"Naano is the B2B LinkedIn creator marketplace: book vetted LinkedIn creators at a fixed price per post, with payment and tracking handled — available in Europe today, unlike LinkedIn's US-only alpha.\",\"H32Q7R\":\"Book vetted LinkedIn creators for sponsored posts at a fixed price per post, with payment and tracking handled by the platform. Live in Europe today.\",\"40JqyA\":\"Book vetted LinkedIn creators at a fixed price per post — payment and tracking handled, available in Europe today.\",\"SxyQ1U\":\"Available in Europe today\",\"SkqXWL\":\"No — alpha, US and Canada only, English-language content only\",\"xsKVt_\":\"Yes — live in Europe, local-language creators\",\"McvzXB\":\"Self-serve booking\",\"_NhGu-\":\"No — discovery and email contact; you negotiate offline\",\"oKnke6\":\"Yes — book a creator directly on the platform\",\"DYl917\":\"Payment handling\",\"DtkzgQ\":\"Not handled — monetization tools announced with no launch date\",\"R_67hF\":\"Handled — creators are paid per post through the platform\",\"Oh-uiM\":\"Pricing transparency\",\"JizBqW\":\"Creator fees negotiated by email; amplification billed as Thought Leader Ads media\",\"vmoCtD\":\"Each creator sets a fixed price per post, shown before booking\",\"v-gt5T\":\"Performance tracking\",\"P15BYE\":\"None built in — you instrument UTMs yourself\",\"Aog5Oy\":\"Per-creator, per-post tracked links included\",\"15zYvO\":\"Creator range\",\"kczSLh\":\"Opt-in directory with native follower and engagement data\",\"fQuJXu\":\"2,000+ vetted creators, from about 1,000 to 500,000 followers\",\"Qr9R5O\":\"Match\",\"Gc88zC\":\"Define your vertical and ICP; Naano surfaces vetted creators whose audience contains your buyers, in the language your buyers read.\",\"qcDygS\":\"Brief\",\"01OjLU\":\"You share the campaign brief; creators write in their own voice and you review before anything goes live.\",\"syEQFE\":\"Publish\",\"mMhM46\":\"Posts go live from creators' personal accounts, where LinkedIn concentrates organic reach.\",\"lD3-8a\":\"Pay\",\"MJe28q\":\"Each creator sets a fixed price per post, shown before booking. Naano handles the payment, so creators never have to invoice your company.\",\"J0vUhO\":\"Track\",\"qhejja\":\"Every post carries tracked links, so you see clicks per creator and per post instead of guessing from screenshots.\",\"8H7FmN\":\"Is there a LinkedIn creator marketplace available in Europe?\",\"zCgLwl\":\"Yes. LinkedIn's own Creator Marketplace (announced June 10, 2026) is an alpha limited to advertisers in the US and Canada, with English-language content only and no announced European date. Naano is a B2B LinkedIn creator marketplace that is live in Europe today, with 2,000+ vetted creators publishing in local languages.\",\"BK-h7w\":\"What is the difference between Naano and LinkedIn's Creator Marketplace?\",\"OJrjxd\":\"LinkedIn's Creator Marketplace is a creator discovery tool inside Campaign Manager: brands search opted-in creators, see native follower and engagement data, and contact them by email — payment, contracting, and tracking remain the brand's problem. Naano is an end-to-end marketplace: brands book vetted LinkedIn creators at a fixed price per post, and the platform handles briefing, publishing, payment, and per-post tracking. LinkedIn's product is also US/Canada-only alpha, while Naano operates in Europe today.\",\"xJwWyV\":\"How much does a sponsored LinkedIn post cost?\",\"8Uuzwd\":\"Based on 239 real sponsored-post bookings on the Naano marketplace between June 14 and August 1, 2026, the median transacted price was €84 per post for creators under 5,000 followers, €180 at 5,000–10,000 followers, and €312 at 10,000–25,000 followers. On Naano, each creator sets a fixed price per post, shown before booking — there is no cost per click or per impression.\",\"FS-SJN\":\"Is Naano an influencer marketing platform?\",\"aF7sHP\":\"Yes — Naano is a LinkedIn influencer marketing platform, structured as a marketplace rather than a database: instead of exporting a list of profiles and running outreach yourself, you book a vetted LinkedIn creator at a fixed price per post and the platform handles matching, briefing, payment, and tracking. It is built exclusively for B2B brands on LinkedIn.\",\"2RfNjM\":\"How do creators get paid?\",\"E5ch6p\":\"Naano handles the payment. The fixed per-post fee is known before the post goes live, and the platform pays the creator after publication — creators never issue brand-by-brand invoices, which matters because most active B2B creators are salaried professionals. LinkedIn's own Creator Marketplace does not handle payment; its monetization tools were announced with no launch date.\",\"ExuqsY\":\"How much does Naano cost?\",\"0hz1us\":\"There are two plans: Self-Serve at €0/month, where you pay only the fixed per-post fee each creator has set, and Managed at €700/month, where Naano handles creator selection, briefs, and campaign management. Every creator's price is a flat fee per post, shown before booking.\",\"jtgFYl\":\"Naano\",\"5C5I3p\":\"LinkedIn Creator Marketplace\",\"TBoYtD\":\"← Naano\",\"i4Araa\":\"The LinkedIn creator marketplace built for B2B\",\"PmIb6D\":\"A LinkedIn creator marketplace is a platform where companies find, book, and pay LinkedIn creators for sponsored posts. Naano is the B2B version: 2,000+ vetted creators from about 1,000 to 500,000 followers, each with a fixed price per post shown before booking — live in Europe today.\",\"zRM5Py\":\"Launch a campaign\",\"NNTPMu\":\"Get a free creator shortlist\",\"W275Lz\":\"What is a LinkedIn creator marketplace?\",\"aA34Cz\":\"A LinkedIn creator marketplace connects companies with LinkedIn creators for sponsored creator campaigns: the brand chooses a creator, the creator publishes a post about the brand from their personal account, and the marketplace handles the transaction between the two. Since June 10, 2026, the term covers two different things — the generic category, and \u003clinkedin\u003eLinkedIn's own Creator Marketplace\u003c/linkedin\u003e, the discovery tool LinkedIn announced inside Campaign Manager (currently in alpha, US and Canada only, English-language content only).\",\"9MZIiM\":\"The distinction that matters for a buying team is scope. A discovery tool tells you who the creators are. An end-to-end marketplace also handles what comes after: booking, briefing, payment, and per-post tracking. Naano is the second kind, built exclusively for B2B — companies discover and book vetted LinkedIn creators, from about 1,000 to 500,000 followers, at a fixed price per post set by each creator and shown before booking.\",\"2i4u2b\":\"How Naano works\",\"DZS3YY\":\"Five steps from brief to measured results. The price of every post is a flat fixed fee, set by the creator and visible before you book — never a cost per click, impression, or lead.\",\"O1tw1T\":\"Naano vs LinkedIn's native Creator Marketplace\",\"-3Ild9\":\"LinkedIn's Creator Marketplace, announced June 10, 2026, is a genuinely useful discovery tool: creators opt in, and the follower and engagement data is native to LinkedIn rather than scraped or self-reported. But it is an alpha limited to the US and Canada, for English-language content only, and it stops at discovery — you contact creators by email and handle contracting, payment, and measurement yourself. The two products solve different halves of the same problem.\",\"Otefae\":\"Dimension\",\"M_TBnc\":\"LinkedIn product characteristics reflect the June 10, 2026 launch coverage (Digiday, Social Media Today) as of the alpha; verify current availability with LinkedIn. For the full side-by-side, including where LinkedIn's product is genuinely strong, read \u003ccomparison\u003eLinkedIn Creator Marketplace vs Naano\u003c/comparison\u003e.\",\"WahVRP\":\"What sponsored LinkedIn posts cost\",\"gBALfs\":\"On Naano, each creator sets a fixed price per post, shown before booking. The Naano Index — 239 real sponsored-post bookings on the marketplace between June 14 and August 1, 2026 — puts numbers on what brands actually pay:\",\"-jEer-\":\"Median per post, creators under 5K followers\",\"oDi3xA\":\"Median per post, creators at 5–10K followers\",\"gt2XEJ\":\"Median per post, creators at 10–25K followers\",\"gEP719\":\"These are transacted medians, not rate-card estimates. The full dataset, methodology, and price-spread analysis are in the \u003cindex\u003eLinkedIn Sponsored Post Price Index 2026\u003c/index\u003e, and every first-party dataset we publish lives on the \u003creports\u003ereports hub\u003c/reports\u003e.\",\"mGRxAw\":\"Who Naano is for\",\"GNm5bt\":\"Naano is built for B2B teams whose buyers are on LinkedIn — B2B SaaS companies above all, along with agencies and marketing teams selling to professional audiences. If your pipeline depends on reaching founders, operators, or specialists in a vertical, the creators they already follow are the distribution channel, and a marketplace is the fastest way to book them. If your buyers are consumers on Instagram or TikTok, a consumer influencer platform is a better structural fit — our \u003ccomparison\u003e2026 platform comparison\u003c/comparison\u003e covers those honestly.\",\"X4VfTC\":\"Is Naano a LinkedIn influencer marketing platform?\",\"Uv9f5q\":\"Yes. \\\"Influencer marketing platform\\\" and \\\"creator marketplace\\\" describe the same job from two angles. Naano does that job for LinkedIn specifically: instead of a searchable database you export and chase by email, it is a transactional marketplace where you book a vetted creator at a fixed price per post and the platform handles briefing, payment, and per-post tracking. Plans are Self-Serve at €0/month and Managed at €700/month — see \u003cpricing\u003epricing\u003c/pricing\u003e for the details.\",\"7Rm1x6\":\"Frequently asked questions\",\"U_h6iN\":\"Book a vetted LinkedIn creator at a fixed price per post\",\"DRNuTW\":\"2,000+ registered and vetted creators, from about 1,000 to 500,000 followers. Every price is set by the creator and shown before you book — Self-Serve is €0/month.\",\"XgN4Cp\":\"See pricing\"},\"pricingPage\":{\"5Wwopw\":\"Pricing\",\"3ynHfK\":\"Naano pricing: Self-Serve is €0/month and each creator sets a fixed offer price. Managed Campaigns is €700/month, done for you.\",\"V0nRkt\":\"Naano pricing: €0/month Self-Serve or €700/month Managed\",\"0YHKTR\":\"Run LinkedIn creator campaigns with free Self-Serve access or a €700/month Managed Campaign run end to end by Naano.\",\"jf9Wfv\":\"What's the minimum budget to start on Naano?\",\"L3R2zt\":\"Self-Serve is €0 per month. Creator spend depends on the offers you book, and the exact fixed price is shown before you commit.\",\"YLR7ry\":\"How much does a single post cost?\",\"SxVqof\":\"Each creator sets a fixed price for their offer. You see the amount and included deliverables before booking; there is no cost per click or impression.\",\"0cPPjB\":\"Can I upgrade to Managed Campaigns or cancel anytime?\",\"pKbQLg\":\"Yes. Both plans are month-to-month with no lock-in. You can move from Self-Serve to Managed Campaigns, downgrade, or cancel whenever you like. Campaign spend is always separate from the plan fee.\",\"xH-ql-\":\"How do creator payouts work?\",\"M_14GD\":\"Creators are paid automatically through Stripe Connect once you approve their content. Invoices, approvals and payment records are handled inside the platform on both Self-Serve and Managed Campaigns.\",\"INW7Xn\":\"What exactly is included in the €700/month Managed plan?\",\"ReVXns\":\"Managed Campaigns adds a dedicated Naano team that handles campaign strategy, creator sourcing and coordination, brief creation, campaign launch, and reporting and optimisation, on top of everything in Self-Serve.\",\"8N6PcF\":\"Do you still charge per click?\",\"B3oZ-o\":\"No. Marketplace offers use a fixed price shown before booking, with no cost per click, impression, or lead.\",\"b1zuN9\":\"Price\",\"gnVV9H\":\"€0 / month\",\"oVZgX5\":\"€700 / month\",\"oESc06\":\"What's included\",\"0eiMtp\":\"Creator marketplace access, AI-powered brief creation, click/lead/pipeline tracking, automatic creator payouts\",\"HevS0X\":\"Campaign strategy \u0026 positioning, creator sourcing \u0026 coordination, brief creation \u0026 launch, reporting \u0026 optimisation\",\"DE2_r0\":\"Creator payment\",\"CRRiXt\":\"You book the creator's published fixed-price offer\",\"U8jV-6\":\"Naano manages creator payments on your behalf\",\"HqRNN8\":\"Support\",\"-lRC8B\":\"Self-serve platform, help center + email\",\"4t2UbK\":\"Dedicated Naano team, book a campaign call\",\"ejEGdx\":\"Home\",\"lyIy1C\":\"Naano pricing\",\"mWqWzp\":\"Naano offers two ways to run LinkedIn creator campaigns. Self-Serve costs €0 per month: you get full platform access and pay creators at the fixed price shown on their offer. Managed Campaigns costs €700 per month and adds a Naano team that sources creators, writes briefs and runs your campaigns end to end.\",\"b1mzsT\":\"Self-Serve\",\"erSVys\":\"Managed Campaigns\",\"p-zMvX\":\"Start for free\",\"Dgq0Kn\":\"Book a campaign call\",\"PqNv_J\":\"Campaign spend is separate from the plan fee. No lock-in, cancel anytime.\",\"HK3ph8\":\"How it works\",\"R_TfZ_\":\"How per-post pricing works\",\"W7LFZp\":\"Marketplace offers use a fixed price chosen by the creator. The amount and included deliverables are visible before you book; there is no cost per click, impression, or lead.\",\"59_5nt\":\"You review and approve the content a creator submits. Once approved, the post goes live and payment is released to the creator automatically through Stripe Connect, invoices and approvals are handled for you inside the platform.\",\"GeAkye\":\"On Self-Serve there is no platform retainer; you fund the offers you choose. On Managed Campaigns, creator spend remains separate and the €700 monthly fee covers the Naano team running the campaign for you.\",\"IWaR11\":\"Pricing FAQ\",\"ixKjX3\":\"Both plans include\",\"v9i__v\":\"Browse eligible LinkedIn creator profiles and fixed-price offers\",\"-P2veX\":\"Tracking from click to lead to pipeline for every post\",\"ND6oty\":\"Automatic creator payouts via Stripe Connect\",\"1OONXr\":\"Month-to-month billing, no lock-in\",\"kQi7CE\":\"Start free, upgrade when you're ready.\",\"PjCtX2\":\"Self-Serve is €0 per month. Managed Campaigns is €700 per month. Creator spend is separate and shown before every booking.\"},\"reportsPage\":{\"NQVedl\":\"Naano Reports: B2B LinkedIn Creator Marketing Data\",\"Gd2uNM\":\"First-party data on B2B LinkedIn creator marketing, published by Naano: real sponsored-post prices from marketplace bookings, campaign benchmarks (CPL, CTR, time-to-launch), and methodology you can cite.\",\"6fnFxA\":\"Real sponsored-post prices, campaign benchmarks and marketplace data from Naano, the B2B LinkedIn creator marketplace. Transparent methodology, citable numbers.\",\"4Iz1XP\":\"Real sponsored-post prices, campaign benchmarks and marketplace data from the B2B LinkedIn creator marketplace.\",\"se_khV\":\"LinkedIn Sponsored Post Price Index 2026\",\"qKlPID\":\"What sponsored LinkedIn posts actually cost, from real bookings\",\"_K3CQS\":\"Transacted prices from 239 sponsored-post bookings on the Naano marketplace between June and August 2026: median €84 per post for creators under 5K followers, €180 at 5–10K, €312 at 10–25K — against rate-card guides quoting $500–$2,500 for the same tiers. Includes price-spread analysis (a 25x spread inside a single follower tier), how much follower count actually explains price (~29%), and delivery odds by price level.\",\"Sj2Y_9\":\"n=239 bookings · June–August 2026 · First-party transaction data\",\"jWAolf\":\"Q2 2026 B2B Creator-Led Growth Benchmarks\",\"72nUhI\":\"CPL, CTR and conversion benchmarks from 312 B2B creator campaigns\",\"pknind\":\"First-party benchmark dataset covering cost per qualified click, CTR, time-to-launch and conversion rates for B2B creator campaigns: 312 campaigns and 1,847 sponsored posts measured in Q1 2026, with per-vertical medians, full methodology, sample sizes and limitations. Historical dataset — measured under Naano's earlier pricing model and labeled as such; performance benchmarks remain valid as reference points.\",\"OKEf4H\":\"n=312 campaigns · 1,847 posts · Q1 2026 data · Dataset schema\",\"s3-hwE\":\"Can I cite Naano's data in an article or report?\",\"H2mTwW\":\"Yes — that is what these reports are for. Cite the specific report with a link, e.g. \\\"Naano Index, n=239 sponsored-post bookings, June–August 2026 (naano.com/reports)\\\". Every number is published with its sample size and time period; please carry both in the citation. Claims we attribute to third parties (Edelman, LinkedIn benchmarks) should be attributed to the original source, not to Naano.\",\"Wa-mPB\":\"Where does the data come from?\",\"TS3mYT\":\"From anonymized, aggregated transactions and campaigns on the Naano marketplace — the B2B LinkedIn creator marketplace. No customer or creator is identifiable in any published number. Each report states its own sample, time window and known limitations; we publish the caveats alongside the findings.\",\"Aq1SVp\":\"How often are the reports updated?\",\"WtqO1p\":\"Each report shows its publication date, and a visible dateModified when it is genuinely refreshed with new data — we do not bump dates for freshness. New editions ship when the underlying marketplace data reaches a sample size worth publishing.\",\"lZv6ip\":\"Sponsored Post Delivery Odds Estimator (free tool)\",\"9Oc4J-\":\"LinkedIn Creator Worth Calculator (free tool)\",\"8GAJNB\":\"How much does B2B influencer marketing cost in 2026?\",\"1cjejw\":\"How much should you charge for a sponsored LinkedIn post?\",\"uUx11V\":\"Best B2B influencer marketing platforms 2026 (ranked)\",\"g6x8M5\":\"B2B LinkedIn creator marketing reports by Naano\",\"2_UQyf\":\"First-party data reports on B2B LinkedIn creator marketing: sponsored-post prices, campaign benchmarks and marketplace research, published by Naano.\",\"jtgFYl\":\"Naano\",\"Ppx673\":\"Reports\",\"TBoYtD\":\"← Naano\",\"95mYvo\":\"B2B LinkedIn creator marketing, measured\",\"0rTi1p\":\"First-party data from the Naano marketplace: what sponsored LinkedIn posts really cost, and what B2B creator campaigns really deliver. Every number ships with its sample size, time period and methodology — built to be cited.\",\"3Zt9Gl\":\"First-party data\",\"BIa2bW\":\"Read the report →\",\"hN-qAG\":\"LinkedIn Creator Marketing Benchmarks 2026\",\"a2O2RS\":\"The annual edition — prices, engagement and delivery data across every follower tier of the marketplace — ships once the underlying samples are large enough to publish. Until then, the two reports above carry the current data, and the \u003ctools\u003efree tools\u003c/tools\u003e are built on the same dataset.\",\"m0YRqw\":\"Using this data\",\"yUXXa-\":\"Built on the same data\"},\"selectionPage\":{\"DOrN0w\":\"Naano is a \u003cstrong\u003eB2B LinkedIn creator marketplace\u003c/strong\u003e. B2B companies book LinkedIn posts from vetted creators — practitioners with high-fit professional audiences, from about 1K to 500K followers — at a flat fee per post. We handle the parts that usually kill these programs: matching, briefing, payment, and click tracking.\"},\"selectionForm\":{\"HDUaaS\":\"Something went wrong. Please try again, or email us at info@naano.com.\"},\"creatorOnboardingRecovery\":{\"h3GMlj\":\"We couldn't load your registration.\",\"1Gdeee\":\"Try again to recover any saved LinkedIn import. This will not start a new import.\",\"1SaE_f\":\"Retry loading my registration\"},\"agencyDashboard\":{\"yCMtyY\":\"Complete company setup\",\"2bO1wA\":\"Create the first campaign\",\"ST_oMd\":\"Review creator content\",\"Ni-ynV\":\"Allocate campaign budget\",\"7ISmst\":\"Follow up on an overdue delivery\",\"wRQ6ew\":\"Review and launch the campaign\",\"9s1SS_\":\"Add creators to the campaign\",\"9ipUSF\":\"Monitor ongoing deliveries\",\"D31qJ4\":\"Review campaign results\",\"W6nwjo\":\"Draft\",\"3a5wL8\":\"Active\",\"C2iTEH\":\"Paused\",\"0HT-Ib\":\"Archived\",\"UHHlXK\":\"{count, plural, one {# creator draft to review} other {# creator drafts to review}}\",\"6dUnjt\":\"{count, plural, one {# creator application to review} other {# creator applications to review}}\",\"dUGesh\":\"{amount} available with no active campaign\",\"SYTXmF\":\"Draft reviews\",\"Ti0n0i\":\"Creator decisions\",\"rghgW2\":\"Unused budgets\",\"EMPTg1\":\"Review drafts\",\"vUNAtv\":\"Review creators\",\"4j75A_\":\"Create a campaign\",\"XS18v9\":\"Enter a valid agency name.\",\"5qEr0E\":\"Agency mode must be enabled by Naano for this account.\",\"O9YRV2\":\"The agency workspace could not be activated.\",\"HuXwB3\":\"Complete every agency field with valid information.\",\"G68HHP\":\"Enter a valid company name.\",\"HhmskF\":\"Enter a valid website address.\",\"t4h3Vo\":\"The partner company could not be created.\",\"Qu6ApZ\":\"Enter a valid amount.\",\"IN53Ho\":\"The central budget is too low for this allocation.\",\"3VO6Id\":\"The budget could not be allocated.\",\"QpB5Qz\":\"The company workspace could not be opened.\",\"qKYwly\":\"The task could not be updated. Try again.\",\"jHfgni\":\"Complete the company profile before sharing its dashboard.\",\"3PzIUe\":\"This company is not available in your agency portfolio.\",\"iErFu6\":\"The client dashboard link could not be created.\",\"3kJE8G\":\"Something went wrong. Try again.\",\"6m9Zrz\":\"Generate a new client link? The previous link will stop working immediately.\",\"YhkOke\":\"Naano for agencies\",\"4E74CZ\":\"Set up your agency workspace\",\"9MP5l2\":\"A few details are enough. We will create your central workspace without asking for company ICPs or product information.\",\"HHRIuR\":\"Work email\",\"COzxxE\":\"Agency name\",\"ViYGX7\":\"Example: Northstar Agency\",\"PP_CSg\":\"Agency website or profile link\",\"xZfcCE\":\"How many client companies do you manage?\",\"yk8okZ\":\"Select a range\",\"oT9YaC\":\"1 to 5 companies\",\"uMgPXN\":\"6 to 20 companies\",\"o3BHkP\":\"21 or more companies\",\"2MHTZm\":\"What monthly budget do you manage across clients?\",\"tzT8hZ\":\"Less than €10,000\",\"EO34fC\":\"€10,000 to €50,000\",\"OhQbnm\":\"More than €50,000\",\"9e7sUL\":\"What do you mainly want to manage in Naano?\",\"0UMF43\":\"Select a priority\",\"ZDlXH-\":\"Campaigns across clients\",\"AYbDVP\":\"Client budgets\",\"_UqrHr\":\"Campaigns and budgets\",\"WKOoL2\":\"Create my agency workspace\",\"S1LZg1\":\"Back to my company\",\"jtgFYl\":\"Naano\",\"Zy6Olu\":\"Agency portfolio\",\"3QEJd8\":\"Naano client portfolio\",\"dsEEFj\":\"Current company\",\"e1N47Q\":\"Transverse client view\",\"F3CFuq\":\"Enterprise agency mode\",\"FhuVbf\":\"Client operations\",\"I9MzZk\":\"Manage companies, budgets and priority work from one operational view.\",\"l1ZYfc\":\"Create company\",\"gaCqAf\":\"Agency dashboard sections\",\"9uOFF3\":\"Overview\",\"yhU1et\":\"Tasks\",\"Zha6Gj\":\"Portfolio health at a glance\",\"fADASH\":\"Work that needs your attention\",\"L7BxwC\":\"Central budget\",\"sx0aSl\":\"Add funds\",\"bSdfbg\":\"Allocated to companies\",\"pFrLar\":\"Client budget\",\"Qt9Twx\":\"Available and committed funds\",\"3IInif\":\"Companies\",\"JVzIxS\":\"Visible in this portfolio\",\"7zbe0e\":\"Active campaigns\",\"ahX_x2\":\"Across all companies\",\"J8cAGG\":\"Needs attention\",\"sG6wKN\":\"Open the work queue\",\"Jn0Do8\":\"Company portfolio\",\"fhdjzD\":\"Open a row to see its campaign overview.\",\"orv8wZ\":\"Search companies\",\"9YazHG\":\"Company\",\"4zbhwL\":\"Campaigns\",\"0KKXrH\":\"Budget\",\"