count, plural, =1 {active company} other {active companies}}\",\"marketplacePerClick\":\"per click\",\"marketplaceCreators\":\"{count, plural, =1 {creator} other {creators}}\",\"marketplaceBudgetLeft\":\"left\",\"marketplaceBudgetTip\":\"First come, first served. Budget shared across all approved creators.\",\"viewAll\":\"View all\",\"applyToCompanyTitle\":\"Apply to a company\",\"applyToCompanyDesc\":\"Choose a SaaS from the marketplace and apply to collaborate.\",\"shareTrackingTitle\":\"Share your tracking link\",\"shareTrackingDesc\":\"Follow the brief and post on LinkedIn with your unique tracking link.\",\"earnCommissionTitle\":\"Earn your first commission\",\"earnCommissionDesc\":\"Every qualified click on your link earns you {rate}, paid automatically to your account.\",\"browseApplyTitle\":\"Browse \u0026 apply\",\"browseApplyDesc\":\"Pick a SaaS from the marketplace. Once accepted, you'll get a brief and tracking link.\",\"postOnLinkedInTitle\":\"Post on LinkedIn\",\"postOnLinkedInDesc\":\"Write a post following the brief and include your unique tracking link.\",\"getPaidTitle\":\"Get paid per click\",\"getPaidDesc\":\"Earn {rate} for every qualified click. Commissions are tracked in real time and paid out automatically.\",\"tabToday\":\"Today\",\"tabPerformance\":\"Performance\",\"tabCommunity\":\"Community\",\"heroOnboardingTitle\":\"Finish your profile to unlock collabs\",\"heroOnboardingBody\":\"A few more steps to start earning per qualified click.\",\"heroOnboardingCta\":\"Continue setup\",\"heroLinkedinPausedTitle\":\"Your collabs are paused\",\"heroLinkedinPausedBody\":\"Reconnect your LinkedIn to resume billing on every campaign.\",\"heroLinkedinPausedCta\":\"Reconnect LinkedIn\",\"heroNewCollabTitle\":\"{company} is ready - €{rate}/click\",\"heroNewCollabBody\":\"Read the brief and publish your first post.\",\"heroNewCollabCta\":\"See the brief\",\"heroUnreadBriefsTitle\":\"You have {count} {count, plural, =1 {unread brief} other {unread briefs}}\",\"heroUnreadBriefsBody\":\"Pick one and start earning today.\",\"heroUnreadBriefsCta\":\"See my briefs\",\"heroFallbackTitle\":\"Find your next collab\",\"heroFallbackBody\":\"Browse SaaS companies that match your audience.\",\"heroFallbackCta\":\"See SaaS companies\",\"statusWeekRank\":\"#{rank}\",\"statusStreakWeeks\":\"{count} {count, plural, =1 {consecutive week} other {consecutive weeks}}\",\"statusStreakStarter\":\"Start your streak\",\"statusNextTier\":\"{remaining} clicks until {next}\",\"statusMaxTier\":\"Max tier reached\",\"kpiNextMilestone\":\"Next milestone: €{amount}\",\"kpiAmountRemaining\":\"€{remaining} remaining\",\"kpiHallOfFame\":\"Hall of Fame\",\"kpiVs30Days\":\"vs last 30 days\",\"kpiBriefsUnread\":\"{count} {count, plural, =1 {brief} other {briefs}} unread\",\"viewAllBriefsLink\":\"See all my briefs\",\"perfSectionTitle\":\"Naano performance\",\"perfSubtitleScoped\":\"Performance on your {count} Naano {count, plural, =1 {post} other {posts}}\",\"perfTooltip\":\"Posts published via a Naano brief in the selected period.\",\"perfPeriodLast7d\":\"last 7 days\",\"perfPeriodLast30d\":\"last 30 days\",\"perfPeriodLast90d\":\"last 90 days\",\"perfPeriodAll\":\"all time\",\"linkedinActiveLabel\":\"LinkedIn analytics active\",\"linkedinDisconnectAction\":\"Disconnect\",\"communityLevelTitle\":\"My level\",\"communityStreakTitle\":\"My streak\",\"communityContestTitle\":\"Creator Contest\",\"communityContestActive\":\"€{prize} for the top creator of the week. The #1 in the ranking on Sunday wins.\",\"communityContestPaused\":\"No contest this week. Check back next week for a new prize.\",\"communityRankingTitle\":\"All-time ranking\",\"communityRankingSubtitle\":\"{total} qualified clicks driven by creators.\",\"communityFullRanking\":\"Full ranking\",\"communityDistanceToTop10\":\"+{diff} clicks to enter the top 10\",\"communityNotRankedYet\":\"Not yet on the ranking - publish your first Naano post to enter.\",\"communityPodiumFirst\":\"1st\",\"comm