lore opportunities\",\"stepSlack\":\"Join the creator Slack\",\"stepGrowTogether\":\"Grow with other creators\",\"stepSlackSub\":\"Get feedback, campaign tips and support from other creators.\",\"stepJoin\":\"Join the community\",\"stepLinkedin\":\"Show your card on LinkedIn\",\"stepShowProof\":\"Make your proof visible\",\"stepLinkedinSub\":\"Add Naano as an experience and attach your creator card.\",\"stepAddCard\":\"Add my creator card\",\"campaignLinksTitle\":\"Your campaign links\",\"campaignLinksSub\":\"Copy the right tracking link before publishing on LinkedIn.\",\"readyToPaste\":\"Ready to paste\",\"trackingLinkAria\":\"Tracking link for {brand}\",\"copyCampaignLink\":\"Copy link\",\"collaborationActions\":\"Collaboration actions\",\"headlineFallback\":\"B2B creator on LinkedIn\",\"offerLabel\":\"Collaboration offer\",\"offerTitle\":\"Sponsored LinkedIn content for B2B brands\"},\"community\":{\"title\":\"Community\",\"sub\":\"Learn with other B2B creators, share what works and make your Naano identity visible.\",\"live\":\"Creator network\",\"slackEyebrow\":\"Naano creators on Slack\",\"slackTitle\":\"The room where B2B creators get better together.\",\"slackBody\":\"Ask for feedback on a sponsored post, compare campaign lessons, meet creators in your language and help shape what Naano builds next.\",\"joinSlack\":\"Join the Slack community\",\"slackNote\":\"Free for Naano creators\",\"slackUnavailable\":\"The Slack invite is temporarily unavailable. Contact Naano support and we’ll invite you.\",\"slackBenefitFeedback\":\"Get feedback before you publish\",\"slackBenefitTips\":\"Share campaign tips that work\",\"slackBenefitTeam\":\"Talk directly with the Naano team\",\"linkedinEyebrow\":\"LinkedIn visibility\",\"linkedinTitle\":\"Make Naano part of your LinkedIn story\",\"linkedinBody\":\"Add Naano as an experience, then attach your creator card so brands and other creators can discover your work.\",\"linkedinAffiliateTitle\":\"Turn your LinkedIn profile into an always-on Deal Link\",\"linkedinAffiliateBody\":\"Add your creator card to LinkedIn so brands can discover your work and join Naano through your attributed link.\",\"affiliationPeriod\":\"of Naano's commission for 3 months\",\"affiliationBenefit\":\"Leave your card on your LinkedIn profile. If a brand joins Naano through it, your reward is tracked automatically.\",\"linkedinStep1\":\"Add a new position titled “Naano Creator” at Naano.\",\"linkedinStep2\":\"Describe the B2B topics and audiences you create for.\",\"linkedinStep3\":\"Add your public creator card as media or as a link.\",\"copyDetails\":\"Copy experience + card\",\"openLinkedin\":\"Add it on LinkedIn\",\"openCard\":\"Open my card\",\"leaderboardTitle\":\"Naano campaign leaderboard\",\"leaderboardSub\":\"Verified LinkedIn impressions over the last 28 days. Switch to Posts to celebrate creators publishing through Naano.\",\"leaderboardImpressionsSub\":\"Naano-verified LinkedIn impressions over the last 28 days.\",\"leaderboardEstimatedSub\":\"Estimated impressions generated by sponsored posts published for Naano brand collaborations.\",\"leaderboardPostsSub\":\"Published sponsored posts completed through Naano, all time. Every delivered collaboration counts.\",\"metricAria\":\"Leaderboard metric\",\"impressions\":\"Impressions\",\"estimatedImpressions\":\"Estimated impressions\",\"posts\":\"Posts\",\"postCount\":\"Naano posts published\",\"impressionCount\":\"impressions in 28 days\",\"estimatedImpressionCount\":\"estimated Naano impressions\",\"you\":\"You\",\"verifiedCreator\":\"Verified creator\",\"naanoCreator\":\"Naano creator\",\"publicCreator\":\"Public creator card\",\"loadError\":\"The leaderboard could not be loaded right now. Try again in a moment.\",\"empty\":\"No verified creator has entered this ranking yet. Sync LinkedIn to become one of the first.\",\"emptyImpressions\":\"No public creator card has verified impressions yet. Sync LinkedIn to become one of the first.\",\"emptyEstimated\":\"Estimated impressions will appear after a sponsored Naano post is published and measured.\",\"emptyPosts\":\"Published Naano collaborations will appear here as soon as the first posts go live.\",\"yourPosition\":\"Your position\",\"experienceCopy\":\"Naano Creator\\nCompany: Naano\\nI create practical B2B content on LinkedIn and collaborate with SaaS brands through Naano.\",\"cardLink\":\"Creator card: {url}\",\"previewAria\":\"LinkedIn experience preview\",\"experienceRole\":\"Naano Creator\",\"experienceCompany\":\"Naano · Independent\",\"experienceDates\":\"Present\",\"addCardLinkedin\":\"Add my creator card to LinkedIn\",\"cardLinkReadyToast\":\"Your card link is copied — add it to the Naano experience on LinkedIn.\",\"experienceRemote\":\"Remote\",\"featuredLink\":\"Featured link\",\"cardAttachment\":\"My Naano creator card\",\"cardProof\":\"Your card turns the experience into proof: audience, expertise, verified performance and collaboration offers in one click.\",\"cardReady\":\"Ready to attach\",\"cardPrivate\":\"Publish first\",\"copyCardLink\":\"Copy card link\",\"publishCard\":\"Publish my card\"},\"opps\":{\"title\":\"Opportunities\",\"sub\":\"Open brand campaigns - apply, the brand accepts, and the booking is created on your terms.\",\"lockedTitle\":\"Paid campaigns open at {floor} followers\",\"lockedBody\":\"You have {followers} followers. Keep posting and come back - re-check your count once a week from Settings.\",\"reviewTitle\":\"Your account is under review\",\"reviewBody\":\"We couldn't read your LinkedIn automatically, so a human is checking your account. Paid campaigns unlock as soon as that's done - usually within a day.\",\"setupTitle\":\"Finish setting up to apply\",\"setupBody\":\"You're eligible. Add your business details and your price to unlock applying and accepting bookings.\",\"setupCta\":\"Complete setup\",\"filterEmpty\":\"No campaign matches these filters. Remove a filter.\",\"invitesTitle\":\"Invitations received\",\"invites