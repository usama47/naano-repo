\",\"icpSizes\":\"Target company sizes\",\"autoScrapePending\":\"Naano is scanning your website to fill this profile…\",\"autoScrapeDone\":\"Profile filled from your website — review and correct if needed.\",\"invalidResponse\":\"Invalid response\",\"autoScrapeDoneToast\":\"Naano filled your company profile from the website\",\"icpHintIncomplete\":\"Incomplete ICP: click “Enrich from website” — Naano fills 3 buyer profiles (titles, seniority and company sizes) plus features.\",\"icpReady\":\"3 buyer ICPs are ready — review them, then save.\",\"mcpHeaderTitle\":\"Connect Naano to your AI assistant\",\"mcpHeaderAction\":\"Connect\",\"mcpTitle\":\"Use Naano from your AI assistant\",\"mcpHint\":\"Search creators, build campaigns and manage collaborations from Claude, ChatGPT or any compatible MCP client.\",\"mcpJobTitle\":\"Keep campaigns moving without another dashboard workflow\",\"mcpSub\":\"Connect once, then ask your AI assistant to find creators, review campaign activity or prepare the next action in plain language.\",\"mcpClaudeHint\":\"Use Naano from Claude and Cowork.\",\"mcpChatGptHint\":\"Use Naano from a custom ChatGPT app.\",\"mcpOtherTitle\":\"Any MCP client\",\"mcpOtherHint\":\"Connect another OAuth-compatible client.\",\"mcpOnline\":\"Online\",\"mcpEndpoint\":\"Remote MCP endpoint\",\"mcpConnectionDetails\":\"Connection details\",\"mcpNoApiKey\":\"No API key\",\"mcpChooseClient\":\"Choose your client\",\"mcpChooseClientHint\":\"One endpoint, any compatible MCP client.\",\"mcpAvailable\":\"Available\",\"mcpUnavailableShort\":\"Unavailable\",\"mcpUnavailable\":\"MCP connections are temporarily unavailable.\",\"mcpConnectClaude\":\"Connect Claude\",\"mcpConnectChatGpt\":\"Connect ChatGPT\",\"mcpSetupCta\":\"View setup\",\"mcpReadTitle\":\"What it can review\",\"mcpReadOnly\":\"Read access\",\"mcpReadWorkspace\":\"Your active workspace, wallet and campaigns\",\"mcpReadCreators\":\"Available creators, posts and campaign fit\",\"mcpReadPipeline\":\"Applications, bookings and content status\",\"mcpActionsTitle\":\"Actions it can prepare\",\"mcpConfirmedActions\":\"Confirmation required\",\"mcpActionCampaigns\":\"Draft and launch campaigns\",\"mcpActionCreators\":\"Invite creators and manage applications\",\"mcpActionContent\":\"Review submitted content and campaign status\",\"mcpSafety\":\"The assistant only sees the active Naano workspace your account can access. Naano rechecks identity, workspace permissions, rate limits and every write confirmation on the server.\",\"mcpSetupTitle\":\"Connect Naano\",\"mcpSetupClaude\":\"Set up Naano in Claude\",\"mcpSetupChatGpt\":\"Set up Naano in ChatGPT\",\"mcpSetupOther\":\"Set up another AI tool\",\"mcpClaudeSetupHint\":\"Claude supports a custom remote connector with automatic OAuth registration.\",\"mcpChatGptSetupHint\":\"ChatGPT requires a supported workspace and developer mode for a custom MCP app.\",\"mcpOtherSetupHint\":\"Use a trusted client that supports remote Streamable HTTP and OAuth 2.1.\",\"mcpStepCopy\":\"Copy the secure Naano connection URL. No API key is required.\",\"mcpStepProvider\":\"Add a custom connector in your AI application.\",\"mcpStepApprove\":\"Sign in to Naano, review the requested access and approve it.\",\"mcpClaudeStep\":\"In Claude, open Settings → Connectors → Add custom connector. Leave Client ID and Client Secret empty.\",\"mcpChatGptStep\":\"In ChatGPT, enable developer mode, then open Settings → Apps → Create and add this URL with OAuth.\",\"mcpOtherStep\":\"Add this URL as a remote Streamable HTTP server, keep authentication on OAuth and review every requested action.\",\"mcpCopyUrl\":\"Copy MCP URL\",\"mcpOpenProvider\":\"Open provider settings\",\"mcpOpenClaude\":\"Open Claude settings\",\"mcpOpenChatGpt\":\"Open ChatGPT\",\"mcpOpenOther\":\"Browse MCP clients\"},\"overview\":{\"closeCustomization\":\"Close customization\",\"customize\":\"Customize\",\"showOrHide\":\"Show or hide\",\"greeting\":\"Good morning, {name}\",\"greetingSub\":\"H